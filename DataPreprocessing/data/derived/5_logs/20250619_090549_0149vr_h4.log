.         recode plh0308_v2 (1/5 = 0) (6/7 = 1)
(1,263 changes made to plh0308_v2)

.         label values plh0308_v2 agree

.         recode plh0308_v1 (2/4 = 0)
(235 changes made to plh0308_v1)

.         label values plh0308_v1 agree

.         recode plh0395i05 (1/5 = 0) (6/7 = 1)
(1,261 changes made to plh0395i05)

.         label values plh0395i05 agree

. 
.         egen sge = rowtotal(plh0308_v1 plh0308_v2 plh0395i05), missing
(27,644 missing values generated)

. 
.         
.         * Control Variables
.         *******************
.         
.         * Marital status
.         label define label_famst 1 "married" 2 "single" 3 "seperated/divorced
> " 4 "widowed"

.         recode pgfamstd (1 6 7 = 1) (3 = 2) (2 4 8 = 3) (5 = 4) 
(11,011 changes made to pgfamstd)

.         label values pgfamstd label_famst

.         
.         * Education
.         label define label_ed 1 "less than secondary" 2 "secondary" 3 "higher
> "  

.         recode pgisced97 (0/2 = 1) (3/4 = 2) (5/6 = 3)
(25,782 changes made to pgisced97)

.         label values pgisced97 label_ed

.         
.         * Labor force status
.         label define label_lfs 1 "employed" 2 "not employed" 3 "unemployed"

.         recode pglfs (min/0 = .)  (1/5 8/10 13 = 2) (6 = 3) (11 12 = 1)
(22,509 changes made to pglfs)

.         label values pglfs label_lfs

.         
.         * Age and age squared 
.         gen age = syear - gebjahr

.         gen age_sq = age^2

.         
.         * Household size
.         bys hid syear: egen hhsize = count(pid) 

. 
.         
. * HYPOTHESIS TEST FOR H4 
. 
.         * We estimate an OLS regresssion with our constructed indicator of su
> pport for gender equality (sge) as the dependent variable on the interaction 
> effect between the number 
.         * of daughters and sex of the respondent as well as further control v
> ariables and their interactions with sex (number of children, marital status,
>  age, age squared,
.         * household income, household size, education, labor force status and
>  the survey year).
.         * We calculate the marginal effects of the number of daughters on the
>  probability of reporting strong support for gender equality for men and wome
> n separately 
.         * and determine their difference.
.         * A positive difference of the marginal effect between fathers and mo
> thers (with a p-value of less than 0.1) supports H4.
. 
.         reg sge c.ndaughters##i.sex i.nchildren##i.sex i.pgfamstd##i.sex c.ag
> e##i.sex c.age_sq##i.sex ///
>                 c.hghinc##i.sex c.hhsize##i.sex i.pgisced97##i.sex i.pglfs##i
> .sex i.syear##i.sex        
