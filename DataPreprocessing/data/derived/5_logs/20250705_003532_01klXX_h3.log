    Projects\ManyDaughters\ManyDaughters_DataPreprocessing/data/derived_confi
    > dential/5%-sample/h3_dataset.dta saved

. 
. 
. * ============================
. * Analysis
. * ============================
. 
. * FILTERS *
.  
.         * only keep participants with kids
.         keep if sumkids > 0 & !missing(sumkids)
(10,594 observations deleted)

.         * only keep participants with kids in survey year
.         keep if kidgeb01 < syear & kidgeb01 > 0
(1,347 observations deleted)

.         * only keep participants with information on sex of first child
.         keep if kidsex01 > 0
(38 observations deleted)

. 
. 
. * GENERATE VARIABLES *
. 
.         * generate variable for number of kids in survey year
.         gen n_kids = 1

.         replace n_kids = 2 if kidgeb02 < syear & kidgeb02 > 0
(16,539 real changes made)

.         replace n_kids = 3 if kidgeb03 < syear & kidgeb03 > 0
(6,001 real changes made)

.         replace n_kids = 4 if kidgeb04 < syear & kidgeb04 > 0
(2,260 real changes made)

.         replace n_kids = 5 if kidgeb05 < syear & kidgeb05 > 0
(809 real changes made)

.         replace n_kids = 6 if kidgeb06 < syear & kidgeb06 > 0
(367 real changes made)

.         replace n_kids = 7 if kidgeb07 < syear & kidgeb07 > 0
(205 real changes made)

.         replace n_kids = 8 if kidgeb08 < syear & kidgeb08 > 0
(133 real changes made)

.         replace n_kids = 9 if kidgeb09 < syear & kidgeb09 > 0
(38 real changes made)

.         replace n_kids = 10 if kidgeb10 < syear & kidgeb10 > 0
(14 real changes made)

.         replace n_kids = 11 if kidgeb11 < syear & kidgeb11 > 0
(10 real changes made)

.         replace n_kids = 12 if kidgeb12 < syear & kidgeb12 > 0
(10 real changes made)

.         replace n_kids = 13 if kidgeb13 < syear & kidgeb13 > 0
(0 real changes made)

.         replace n_kids = 14 if kidgeb14 < syear & kidgeb14 > 0
(0 real changes made)

.         replace n_kids = 15 if kidgeb15 < syear & kidgeb15 > 0
(0 real changes made)

.         replace n_kids = 16 if kidgeb16 < syear & kidgeb16 > 0
(0 real changes made)

.         replace n_kids = 17 if kidgeb17 < syear & kidgeb17 > 0
(0 real changes made)

.         replace n_kids = 18 if kidgeb18 < syear & kidgeb18 > 0
(0 real changes made)

.         replace n_kids = 19 if kidgeb19 < syear & kidgeb19 > 0
(0 real changes made)

.         label variable n_kids "Number of kids in survey year"

. 
.         * generate dummy variable for whether participant has at least one da
> ughter (1) or not (0)
.         gen d_daughter = 0

.         replace d_daughter = 1 if (kidsex01 == 2 & n_kids >= 1) | (kidsex02 =
> = 2 & n_kids >= 2) | (kidsex03 == 2 & n_kids >= 3) | (kidsex04 == 2 & n_kids 
> >= 4) | (kidsex05 == 2 & n_kids >= 5) | (kidsex06 == 2 & n_kids >= 6) | (kids
> ex07 == 2 & n_kids >= 7) | (kidsex08 == 2 & n_kids >= 8) | (kidsex09 == 2 & n
> _kids >= 9) | (kidsex10 == 2 & n_kids >= 10) | (kidsex11 == 2 & n_kids >= 11)
>  | (kidsex12 == 2 & n_kids >= 12) | (kidsex13 == 2 & n_kids >= 13) | (kidsex1
> 4 == 2 & n_kids >= 14) | (kidsex15 == 2 & n_kids >= 15) | (kidsex16 == 2 & n_
> kids >= 16) | (kidsex17 == 2 & n_kids >= 17) | (kidsex18 == 2 & n_kids >= 18)
>  | (kidsex19 == 2 & n_kids >= 19)
(16,627 real changes made)

.         label variable d_daughter "Dummy variable for whether participant has
>  at least one daughter (1) or not (0)"

. 
.         * generate dummy variable for female (0) or male (1) gender
.         gen d_sex = 0 if sex == 2
(10,465 missing values generated)

.         replace d_sex = 1 if sex == 1
(10,465 real changes made)

.         label variable d_sex "Dummy variable for female (0) or male (1) gende
> r"

. 
.         * generate variable for age in survey year
.         gen age = syear - gebjahr

.         label variable age "Age in survey year"

. 
.         * generate variable for gender equality in the household (as measured
>  by behaviors or outcomes)
.         egen work_time_male = mean(pgtatzeit) if pgtatzeit >= 0 & !missing(pg
> tatzeit) & d_sex == 0, by(hid syear)
(17,805 missing values generated)

.         egen work_time_female = mean(pgtatzeit) if pgtatzeit >= 0 & !missing(
> pgtatzeit) & d_sex == 1, by(hid syear)
(17,898 missing values generated)

.         egen mean_work_time_male = mean(work_time_male), by(hid syear)
(13,982 missing values generated)

.         egen mean_work_time_female = mean(work_time_female), by(hid syear)
(13,207 missing values generated)

.         gen gender_equality_household = (80 - abs(mean_work_time_male - mean_
> work_time_female)) / 80 if !missing(mean_work_time_male) & !missing(mean_work
> _time_female)
(17,318 missing values generated)

.         label variable gender_equality_household "Gender equality in the hous
> ehold"

.         drop work_time_male work_time_female mean_work_time_male mean_work_ti
> me_female

. 
. 
. * HYPOTHESIS TEST FOR H3 *
. 
.         * linear OLS regression
. 
.         * as measure of gender equality in the household (hypothesis 3), we u
> se the difference in actual work time per week (pgtatzeit) between men and wo
> men in the household; if the absolute value of this difference is smaller, we
>  assume the household is more gender equal
.         * we run a linear OLS regression analysis with the within-household p
> gtatzeit difference, recoded to range between 0 (gender unequal) and 1 (gende
> r equal), as dependent variable, and the dummy variable d_daughter as indepen
> dent variable, controlling for number of kids (n_kids), gender (d_sex), age (
> age), and survey year (syear) fixed effects, with robust standard errors clus
> tered at the household (hid) level
. 
.         reg gender_equality_household d_daughter n_kids d_sex age i.syear, cl
> uster(hid)

