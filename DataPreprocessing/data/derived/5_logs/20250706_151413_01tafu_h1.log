.                 keep if kidgeb01 != -2  //these persons never have children. 
(10,594 observations deleted)

.                 drop if kidgeb01 < 0 //Also drop [-1] No Answer [-2] Does not
>  apply [-3] Answer improbable
(99 observations deleted)

.                 
. 
.                 *Drop years before child1 was born
.                 drop if syear < kidgeb01 
(960 observations deleted)

. 
. 
.                 *(1b) Keep only if sex of child is known 
.                 drop if kidsex01 < 0 // missings 
(38 observations deleted)

. 
.         
.                 *(2) have one child only (dropped once second child arrives).
>  Except if twins, then counted as 'having daughter' if both of them are girls
>  
. 
.                 gen twins = 1 if kidgeb01==kidgeb02 & kidmon01==kidmon02 & ki
> dgeb02 != -2 //month and year of birth same, and second child present. 
(23,279 missing values generated)

.                 drop if twins==1 & kidsex02 < 0 // if 2nd twins gender unknow
> n 
(0 observations deleted)

.                 
.                 drop if syear > kidgeb02 & twins !=1  //drop observations (su
> rveyyears) once 2nd child is born (except first child is twin)
(22,394 observations deleted)

.                 drop if syear > kidgeb03 & twins ==1 //drop observations (sur
> veyyears) once 3rd child is born (if first child is twin)
(252 observations deleted)

.                 
. 
.                 *(3) items only asked in the 2012 survey
.                 keep if syear ==2012 
(831 observations deleted)

.                 
.                 
. * GENERATE VARIABLES * 
. 
.         *generate dummy variable for participants sex
.         fre sex

