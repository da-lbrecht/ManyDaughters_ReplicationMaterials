. * ============================
. * Analysis
. * ============================
. 
. * FILTERS * 
.  
. * We focus on respondents with kids in 2019 
. 
.         keep if sumkids > 0 & syear == 2019 & inrange(kidgeb01, 1900, 2019)
(33,780 observations deleted)

.                 
. * GENERATE VARIABLES * 
. 
.         * Generate the dependent variable (plh0395avg). 
.         * This is the average to the six questions in Attitudes towards gende
> r. 
.         egen plh0395avg = rowmean(plh0395i01 plh0395i02 plh0395i03 plh0395i04
>  plh0395i05 plh0395i06) if min(plh0395i01, plh0395i02, plh0395i03, plh0395i04
> , plh0395i05, plh0395i06) >= 0 
(568 missing values generated)

.         
.         * Generate a dummy variable for whether participant has at least one 
> daughter (1) or not (0)
.         
.         gen d_daughter = 0

. 
.         forval i = 1/19 {
  2.                 local sexvar = "kidsex" + string(`i', "%02.0f")
  3.                 local yearvar = "kidgeb" + string(`i', "%02.0f")
  4.                 replace d_daughter = 1 if `sexvar' == 2 & `yearvar' <= 201
> 9
  5.         }
