  5.                         local yearvar = "kidgeb" + string(`i', "%02.0f")
  6.                         replace hasdaughters`y' = 1 if `sexvar' == 2 & `ye
> arvar' <= `y' & `yearvar' != .
  7.                 }
  8.         }
