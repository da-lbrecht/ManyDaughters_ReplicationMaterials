       /cut1 |   .3345192   1.826775                     -3.245893    3.914932
       /cut2 |   .5275727   1.822268                     -3.044008    4.099153
       /cut3 |   .6094207   1.821868                     -2.961375    4.180216
       /cut4 |   1.349467   1.824121                     -2.225744    4.924678
       /cut5 |   1.840753   1.834241                     -1.754293    5.435799
       /cut6 |   2.194626   1.823031                     -1.378449    5.767701
------------------------------------------------------------------------------

.         
. 
. * EXTRACT AND EXPORT RESULTS * 
. 
.         * Extract the required statistics
. 
.                 * (i) coefficient estimate
.                 local coefficient = _b[daughter]

. 
.                 * (ii) standard error
.                 local se = _se[daughter]

. 
.                 * (iii) family of the test statistic (e.g. z, t, F, Chi²)
.                 local test_stat_family = "z"

. 
.                 * (iv) residual and model degrees of freedom (DFs) if applica
> ble (n/a for ologit)
.                 local df_residual = e(df_r)

.                 local df_model = e(df_m)

. 
.                 * (v) p-value
.                 local z = _b[daughter] / _se[daughter]

.                 local p_value = 2 * normal(-abs(`z'))

. 
.                 * (vi) number of observations
.                 local num_obs = e(N)

. 
.                 * (vii) number of participants
.                 quietly levelsof pid if e(sample), local(participants)

.                 local num_participants : word count `participants'

. 
.                 * (viii) interpretation of directionality
.                 scalar coef_daughter = _b[daughter]

.                 local interpretation "negative coefficient is in line with hy
> pothesis"

. 
.         // Display the saved statistics
.         di "Coefficient: `coefficient'"
Coefficient: .3666376987044119

.         di "Standard Error: `se'"
Standard Error: .3320593481430238

.         di "Test Statistic Family: `test_stat_family'"
Test Statistic Family: z

.         di "Residual Degrees of Freedom: `df_residual'"
Residual Degrees of Freedom: .

.         di "Model Degrees of Freedom: `df_model'"
Model Degrees of Freedom: 15

.         di "p-value: " `p_value'
p-value: .26953543

.         di "Number of observations: " `num_obs'
Number of observations: 263

.         di      "Number of participants: " `num_participants'
Number of participants: 263

.         di "Interpretation of directionality: " "`interpretation'"
Interpretation of directionality: negative coefficient is in line with hypothes
> is

. 
.         * Export results to csv 
.         file open myfile using "$OUT/h1_results.csv", write replace
(file C:\Users\dalbrecht\Research
    Projects\ManyDaughters\ManyDaughters_DataPreprocessing/data/derived/5_res
    > ults/h1_results.csv not found)

.         file write myfile "coefficient,se,family,residual_df,model_df,p_value
> ,num_obs,num_participants,interpretation" _n

.         file write myfile "`coefficient', `se', `test_stat_family', `df_resid
> ual', `df_model',`p_value',`num_obs',`num_participants',`interpretation'" _n

.         file close myfile

. 
. 
