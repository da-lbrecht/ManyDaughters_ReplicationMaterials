. do "20250709_045114_01ne7t_h1.do"

. *****************************************************************************
> ***
. ****************** Do-File H1: #ManyDaughters Project ******************
. *****************************************************************************
> ***
. 
. * Authors: RT 01ne7t
. 
. * ============================
. * Setup 
. * ============================
. 
. * clear all
. version 17 

. set maxvar 10000 


. 
. * INSTALL PACKAGES * 
. // no packages used
. 
. * CONFIGURE FILE PATHS * (Please do not change)
. /*
> * the following code automatically sets paths based on where you saved the di
> stributed file-package on your system *
> if strpos("`c(pwd)'", "code") {
>     global ROOT "`c(pwd)'/.."
> }
> else {
>     global ROOT "`c(pwd)'"
> }
> global IN "$ROOT/data/raw" // folder, in which the original datasets are stor
> ed
> global DATA "$ROOT/data/derived" // folder for datasets
> global OUT "$ROOT/out" // folder for output (results, tables)
> 
> */
. 
. * ============================
. * Data Preparation * 
. * ============================
. 
. * LOAD AND MERGE DATA *
.         quietly use "$IN/ppathl.dta", clear

.         quietly merge m:1 pid using "$IN/biobirth.dta", nogen keep(master mat
> ches)

.         quietly merge 1:1 pid syear using "$IN/pgen.dta", nogen keep(master m
> atches)

.         quietly merge 1:1 pid syear using "$IN/pl.dta", nogen keep(master mat
> ches)

.         quietly merge m:1 hid syear using "$IN/hgen.dta", nogen keep(master m
> atches) keepusing(hid syear hghinc)

.         quietly label language EN 

.         quietly save "$DATA/h1_dataset.dta", replace 

. 
. 
. * ============================
. * Analysis
. * ============================
. 
. * Filters * 
. 
.         * this bit of code will set negative values to missing
.         quietly ds, has(type numeric)

.         foreach var in `r(varlist)' {
  2.                 quietly replace `var' = . if `var' < 0
  3.         }

.         
.         * drop people that have never had a kid
.         quietly gen had_kid = 0

.         local maxkids = 19

.         forvalues i = 1/`maxkids' {
  2.                 local idx = string(`i', "%02.0f")
  3.                 quietly replace had_kid = 1 if !missing(kidsex`idx')
  4.         }

.         quietly egen ever_had_kid = max(had_kid), by(pid)

.         quietly gen never_had_kid = (ever_had_kid == 0 | missing(ever_had_kid
> ))

.         quietly drop if never_had_kid == 1

. 
. * GENERATE VARIABLES * 
. 
.         * a daughter dummy variable that is 0 in the years before their first
>  daughter and 1 afterwards
.         quietly gen first_daughter_year = .

.         quietly gen daughter = 0

.         local maxkids = 19  

.         forvalues i = 1/`maxkids' {
  2.                 local sex = string(`i', "%02.0f")
  3.                 quietly replace first_daughter_year = kidgeb`sex' ///
>                 if missing(first_daughter_year) & (kidsex`sex' == 2)
  4.                         quietly replace daughter = 1 if (kidsex`sex' == 2)
>  & daughter == 0
  5.         }

.         
.         * age and age-squared (for non-linear effect)
.         quietly gen age = syear - gebjahr

.         quietly gen age2 = age*age

. 
. * HYPOTHESIS TEST FOR H1 * 
. 
.         * For our identification strategy, we assume a child's gender is esse
> ntially random
.         * Actually having a child is much more endogenous, so we only include
>  people that have had at least one child
.         * The number of children is also endogenous, but for power considerat
> ions we control for rather than selecting, for example, parents with only one
>  child
.         * we then control for other factors that may plausibly influence the 
> dependent variable:
.         * -age and age-squared (for non-linear effect of age)
.         * -the respondent's gender
.         * -the year of the survey
.         * -whether the respondent was born in Germany or not
.         * -whether the respondent lives in East/West Germany or not
.         * For the dependent variable, we use 'plj0625: position of women: hus
> band should have the final say'.  we find all the plj062X: position of women:
>  variables suitable but selected this one as there appears to be slightly mor
> e valid responses for this question
.         * we would like to run a panel (xt) for this, but as the independent 
> variable was only elicited in one wave we do not have sufficient variation, s
> o we use a standard approach
.         * given the variable is 1 = strongly disagree and 7 = agree fully, su
> pport for gender equality would be a negative coefficient on the daughter var
> iable
.         * also given the dependent variable is Likert, we use an ordered logi
> t (see Liddell & Kruschke 2018 https://doi.org/10.1016/j.jesp.2018.08.009) 
.         
.         xtset pid syear

Panel variable: pid (unbalanced)
 Time variable: syear, 2000 to 2020, but with gaps
         Delta: 1 unit

.         
.         
.         ologit plj0625 daughter i.sumkids age age2 i.sex i.syear i.germborn i
> .sampreg, vce(cluster pid)

note: 2.germborn omitted because of collinearity.
Iteration 0:  Log pseudolikelihood = -374.65158  
Iteration 1:  Log pseudolikelihood = -366.80002  
Iteration 2:  Log pseudolikelihood = -366.62482  
Iteration 3:  Log pseudolikelihood = -366.62028  
Iteration 4:  Log pseudolikelihood = -366.62028  

