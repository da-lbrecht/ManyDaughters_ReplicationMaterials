. * GENERATE VARIABLES
. 
.         * Outcome: Political left-right scale (plh0004)
.         * Original scale: 0 = far left, 10 = far right
.         * Reverse code so higher values = more left-leaning
.         gen left_right_scale = 10 - plh0004 if !missing(plh0004)
(25,996 missing values generated)

.         label variable left_right_scale "Political orientation (1=far right, 
> 10=far left)"

. 
.         * Treatment: First child is daughter
.         gen first_child_daughter = (kidsex01 == 2) if !missing(kidsex01)
(8,983 missing values generated)

.         label variable first_child_daughter "First child is daughter"

.         label define first_child_lab 0 "First child son" 1 "First child daugh
> ter"

.         label values first_child_daughter first_child_lab

. 
.         * Age at survey year
.         gen age_at_survey = syear - gebjahr

.         label variable age_at_survey "Age at survey year"

. 
.         * Month-level dates for correct timing
.         gen interview_date = ym(syear, pgmonth) if !missing(pgmonth)
(3,550 missing values generated)

.         replace interview_date = ym(syear, 1) if missing(pgmonth)  // Assume 
> January if month missing
(3,550 real changes made)

.         gen interview_month_imputed = missing(pgmonth)

.         label variable interview_month_imputed "Interview month was imputed"

. 
.         * Month-level first child sex knowledge date 
.         * (birth date -5 because of ultrasound child sex checks anticipation)
.         gen first_know_sex = ym(kidgeb01, kidmon01) - 5 if !missing(kidmon01)
>  & !missing(kidgeb01)
(17,214 missing values generated)

.         replace first_know_sex = ym(kidgeb01, 6) - 5 if missing(kidmon01) & !
> missing(kidgeb01)  // Assume June birth
(8,181 real changes made)

.         gen know_sex_month_imputed = missing(kidmon01) & !missing(kidgeb01)

.         label variable first_know_sex "Date of first child sex knowledge (bir
> th - 5 months)"

.         label variable know_sex_month_imputed "Sex knowledge month was impute
> d"

. 
.         * Time since first child sex knowledge
.         gen months_since_know_sex = interview_date - first_know_sex if !missi
> ng(first_know_sex)
(9,033 missing values generated)

.         gen years_since_know_sex = months_since_know_sex / 12
(9,033 missing values generated)

.         label variable months_since_know_sex "Months since first child sex wa
> s known"

.         label variable years_since_know_sex "Years since first child sex was 
> known"

