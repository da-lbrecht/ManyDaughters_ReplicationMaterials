(3,551 missing values generated)

.         gen part_time = (pgemplst == 2) if !missing(pgemplst)
(3,551 missing values generated)

.         gen unemployed = (pgemplst == 4 | pgemplst == 5) if !missing(pgemplst
> )
(3,551 missing values generated)

