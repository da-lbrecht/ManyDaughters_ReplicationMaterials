. *****************************************************************************
> ***
. ****************** Do-File H3: #ManyDaughters Project ******************
. *****************************************************************************
> ***
. 
. * Authors: RT 01ne7t
. 
. * ============================
. * Setup 
. * ============================
. 
. * clear all
. version 17 

. set maxvar 10000 


. 
. * INSTALL PACKAGES * 
. // no packages used
. 
. * CONFIGURE FILE PATHS * (Please do not change)
. /*
> * the following code automatically sets paths based on where you saved the di
> stributed file-package on your system *
> if strpos("`c(pwd)'", "code") {
>     global ROOT "`c(pwd)'/.."
> }
> else {
>     global ROOT "`c(pwd)'"
> }
> global IN "$ROOT/data/raw" // folder, in which the original datasets are stor
> ed
> global DATA "$ROOT/data/derived" // folder for datasets
> global OUT "$ROOT/out" // folder for output (results, tables)
> 
> */
. 
. * ============================
. * Data Preparation * 
. * ============================
. 
. * LOAD AND MERGE DATA *
.         quietly use "$IN/ppathl.dta", clear

.         quietly merge m:1 pid using "$IN/biobirth.dta", nogen keep(master mat
> ches)

.         quietly merge 1:1 pid syear using "$IN/pgen.dta", nogen keep(master m
> atches)

.         quietly merge 1:1 pid syear using "$IN/pl.dta", nogen keep(master mat
> ches)

.         quietly merge m:1 hid syear using "$IN/hgen.dta", nogen keep(master m
> atches) keepusing(hid syear hghinc)

.         quietly label language EN 

.         quietly save "$DATA/h3_dataset.dta", replace 

. 
. 
. * ============================
. * Analysis
. * ============================
. 
. * Filters * 
. 
.         * this bit of code will set negative values to missing
.         quietly ds, has(type numeric)

.         foreach var in `r(varlist)' {
  2.                 quietly replace `var' = . if `var' < 0
  3.         }

.         
.         * drop people that have never had a kid
.         quietly gen had_kid = 0

.         local maxkids = 19

.         forvalues i = 1/`maxkids' {
  2.                 local idx = string(`i', "%02.0f")
  3.                 quietly replace had_kid = 1 if !missing(kidsex`idx')
  4.         }

.         quietly egen ever_had_kid = max(had_kid), by(pid)

.         quietly gen never_had_kid = (ever_had_kid == 0 | missing(ever_had_kid
> )) 

.         quietly drop if never_had_kid == 1

. 
. 
. * GENERATE VARIABLES * 
. 
.         * a daughter dummy variable that is 0 in the years before their first
>  daughter and 1 afterwards
.         quietly gen first_daughter_year = .

.         quietly gen daughter = 0

.         local maxkids = 19  

.         forvalues i = 1/`maxkids' {
  2.                 local sex = string(`i', "%02.0f")
  3.                 quietly replace first_daughter_year = kidgeb`sex' ///
>                 if missing(first_daughter_year) & (kidsex`sex' == 2)
  4.                         quietly replace daughter = 1 if (kidsex`sex' == 2)
>  & daughter == 0
  5.         }

.         
.         * age and age-squared (for non-linear effect)
.         quietly gen age = syear - gebjahr

.         quietly gen age2 = age*age

.         
.         * as we are specifically interested in households, we limit our sampl
> e further to those that live in the same household 
.         preserve

.                 keep pid hid syear

.                 rename pid parid

.                 rename hid par_hid

.                 duplicates drop parid syear, force

Duplicates in terms of parid syear

(0 observations are duplicates)

.                 tempfile partner_hhid

.                 save `partner_hhid'
file C:\Users\DALBRE~1\AppData\Local\Temp\ST_3f24_000003.tmp saved as .dta
    format

.         restore

.         * Step 2: Merge partner's household ID into main dataset
.         merge m:1 parid syear using `partner_hhid', keep(master match) nogen
(variable parid was long, now double to accommodate using data's values)
(label pid_EN already defined)
(label hid_EN already defined)
(label syear_EN already defined)

    Result                      Number of obs
    -----------------------------------------
    Not matched                         7,211
        from master                     7,211  
        from using                          0  

    Matched                            17,402  
    -----------------------------------------

.         * Step 3: Generate indicator for living with partner
.         gen lives_with_partner = (par_hid == hid) if !missing(parid)
(5,305 missing values generated)

.         replace lives_with_partner = 0 if missing(parid)
(5,305 real changes made)

.         drop if lives_with_partner == 0
(7,211 observations deleted)

.         
.         * also looking for opposite sex couples, as this is about gender equa
> lity
.         preserve

.                 keep pid syear sex

.                 rename pid parid

.                 rename sex partner_sex

.                 duplicates drop parid syear, force

Duplicates in terms of parid syear

(0 observations are duplicates)

.                 tempfile partner_sex

.                 save `partner_sex'
file C:\Users\DALBRE~1\AppData\Local\Temp\ST_3f24_000005.tmp saved as .dta
    format

.         restore

.         merge m:1 parid syear using `partner_sex', keep(master match) nogen
(label sex already defined)
(label sex_EN already defined)
(label pid_EN already defined)
(label syear_EN already defined)

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                            17,402  
    -----------------------------------------

.         gen same_sex_partner = (sex == partner_sex) if !missing(sex) & !missi
> ng(partner_sex)

.         drop if same_sex_partner == 1
(0 observations deleted)

.         
.         
.         * now we create a variable on the ratio of housework per day for the 
> couple
.         preserve

.                 keep pid pli0043_h syear

.                 rename pid parid

.                 rename pli0043_h par_pli0043_h

.                 duplicates drop parid syear, force

Duplicates in terms of parid syear

(0 observations are duplicates)

.                 tempfile hw_per_day

.                 save `hw_per_day'
file C:\Users\DALBRE~1\AppData\Local\Temp\ST_3f24_000007.tmp saved as .dta
    format

.         restore

.         merge m:1 parid syear using `hw_per_day', keep(master match) nogen
(label pid_EN already defined)
(label pli0043_h already defined)
(label syear_EN already defined)
(label pli0043_h_EN already defined)

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                            17,402  
    -----------------------------------------

.         
.         
.         * this variable has clearly erroneous values (e.g. sometimes people r
> eport 24 hours)
.         * so we drop if greater than 8 hours per day (99th percentile)
.         drop if pli0043_h > 8
(3,009 observations deleted)

.         
.         gen pli0043_prop = pli0043_h / (pli0043_h+par_pli0043_h) if !missing(
> pli0043_h, par_pli0043_h)
(956 missing values generated)

.         
.         * gender equality implies this proportion should become closer to 0.5
> , so take absolute value of difference to 0.5
.         gen pli0043_abs = abs(0.5-pli0043_prop)
(956 missing values generated)

. 
.         * now to have only one partner from the couple in the dataset, drop a
> ll men
.         drop if sex == 1
(7,074 observations deleted)

.         
.         
. * HYPOTHESIS TEST FOR H3 * 
. 
.         * For our identification strategy, we assume a child's gender is esse
> ntially random
.         * Actually having a child is much more endogenous, so we only include
>  people that have had at least one child
.         * The number of children is also endogenous, but for power considerat
> ions we control for rather than selecting, for example, parents with only one
>  child
.         * we then control for other factors that may plausibly influence the 
> dependent variable:
.         * -age and age-squared (for non-linear effect of age)
.         * -the year of the survey
.         * -whether the respondent was born in Germany or not
.         * -whether the respondent lives in East/West Germany or not
.         * We focus on the pli0043_h variable - the self-reported hours per da
> y spent on housework.  We take the ratio of that variable for mixed-gender co
> uples that live in the same household.  Gender equality means this variable s
> hould be close to 0.5, in that housework is shared equally.  Given how the va
> riable is set up (absolute value of difference from 0.5), this means that mor
> e gender equal behavior means the variable should be decreasing (in that it i
> s getting closer to 0.5)
.         
.         xtset pid syear

Panel variable: pid (unbalanced)
 Time variable: syear, 2000 to 2020, but with gaps
         Delta: 1 unit

.         
.         xtreg pli0043_abs daughter i.sumkids age age2 i.syear i.germborn i.sa
> mpreg, vce(cluster pid)

