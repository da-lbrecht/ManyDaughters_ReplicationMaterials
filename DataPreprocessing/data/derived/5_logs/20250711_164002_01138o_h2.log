. 
. * GENERATE VARIABLES * 
. 
.         gen male = (sex == 1)

.         gen age = syear - gebjahr

.         gen age2 = age*age

.         gen migbackdummy = (migback != 1)

.         
.         gen firstbornisdaughter = (kidsex01 == 2)

.         gen anydaughter = (kidsex01 == 2) | (kidsex02 == 2) | (kidsex03 == 2)
>  | (kidsex04 == 2) | (kidsex05 == 2) | (kidsex06 == 2) | (kidsex07 == 2) | //
> / 
>         (kidsex08 == 2) | (kidsex09 == 2) | (kidsex10 == 2) | (kidsex11 == 2)
>  | (kidsex12 == 2) | (kidsex13 == 2) | (kidsex14 == 2) | ///
>         (kidsex15 == 2) | (kidsex16 == 2) | (kidsex17 == 2) | (kidsex18 == 2)
>  | (kidsex19 == 2)

.         
.         keep pid hid syear male age age2 migbackdummy firstbornisdaughter any
> daughter plh0004

. 
.         
. * HYPOTHESIS TEST FOR H2 * 
. 
.         * We run an IV regression with plh0004 as the dependent variable and 
> anydaughter as the independent variable, with anydaughter being instrumtended
>  by firstbornisdaughter.
.         * Controls are male, age, age2, migbackdummy, and syear fixed effects
> .
. 
.         ivreg2 plh0004 male age age2 migbackdummy i.syear (anydaughter = firs
> tbornisdaughter), cluster(pid hid)

