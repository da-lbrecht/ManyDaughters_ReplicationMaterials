. * FILTERS * 
.         *Adults under the age of 65
. keep if bioage<65 & bioage>=18
(14,031 observations deleted)

. 
.         *Adults with at least 1 child
. drop if sumkids==0 
(4,059 observations deleted)

. 
.         * Keep participants with spouse or partner 
. keep if partner==1 | partner==2 
(3,253 observations deleted)

. drop if pgpartnr==.
(1,897 observations deleted)

. 
.         * Keep nuclear household where only 1 couple cohabit
. by cid (pid), sort: gen nbhh = sum(pid != pid[_n-1])

. by cid (pid): replace nbhh = nbhh[_N]
(5376 real changes made)

. g couple=(nbhh==2)

. 
. keep if couple==1
(4,083 observations deleted)

. 
.         * In survey years for which Time Use on childcare and chores are surv
> eyed
. keep if syear==2001 | syear==2003 | syear==2005 | syear==2007 | syear==2009 |
>  syear==2011 | ///
>                 syear==2012 | syear==2013 | syear==2015 | syear==2017 | syear
> ==2019 
(3,681 observations deleted)

.                 
. * GENERATE VARIABLES * (Please adapt according to your needs)
. 
.         * Time Use Chores (Weekly)
.                 *weekdays
.         gen chores_week=pli0043_h

.         replace chores_week=. if pli0043_h<0
(44 real changes made, 44 to missing)

. 
.         gen childcare_week=pli0044_h

.         replace childcare_week=. if pli0044_h<0
(95 real changes made, 95 to missing)

.                 *saturday
.         gen chores_sat=pli0012_h

.         replace chores_sat=. if pli0012_h<0
(556 real changes made, 556 to missing)

. 
