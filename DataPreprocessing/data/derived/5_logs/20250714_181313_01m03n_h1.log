. do "20250714_181313_01m03n_h1.do"

. *****************************************************************************
> ***
. ****************** Example Do-File H1: #ManyDaughters Project ***************
> ***
. *****************************************************************************
> ***
. 
. * Authors: Tina Wang, David Albrecht
. * Revised by Research Team RT01m03n: [REDACTED], [REDACTED]
. 
. * ============================
. * Setup * 
. * ============================
. 
. *clear all
. version 17.0 // indicate the version of stata used here

. set maxvar 10000 // extend the maximum number of variables to 10,000


. 
. * INSTALL PACKAGES * 
. ssc install outreg2
checking outreg2 consistency and verifying not already installed...
all files already exist and are up to date.

. ssc install ftools
checking ftools consistency and verifying not already installed...
all files already exist and are up to date.

. ssc install reghdfe, replace
checking reghdfe consistency and verifying not already installed...
all files already exist and are up to date.

. /*
> * CONFIGURE FILE PATHS * (Please do not change)
> * the following code automatically sets paths based on where you saved the di
> stributed file-package on your system *
> if strpos("`c(pwd)'", "code") {
>     global ROOT "`c(pwd)'/.."
> }
> else {
>     global ROOT "`c(pwd)'"
> }
> global IN "$ROOT/data/raw" // folder, in which the original datasets are stor
> ed
> global DATA "$ROOT/data/derived" // folder for datasets
> global OUT "$ROOT/out" // folder for output (results, tables)
> */
. 
. * ============================
. * Data Preparation * 
. * ============================
. 
. * LOAD AND MERGE DATA *
. 
.         use "$IN/ppathl.dta", clear // use ppathl as a starting dataset
(SOEP-Core, v37 (EU Edition), doi:10.5684/soep.core.v37eu)

. 
.         * Merge ppathl with all datasets, relevant for the analysis. 
. 
.         * biobirth contains information on fertility history
.         merge m:1 pid using "$IN/biobirth.dta", nogen keep(master matches)
(variable pid was long, now double to accommodate using data's values)
(variable cid was long, now double to accommodate using data's values)
(variable gebjahr was int, now double to accommodate using data's values)
(label sex already defined)
(label sex_EN already defined)

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                            35,228  
    -----------------------------------------

.         * pgen contains user-friendly data on the individual level that are c
> onsolidated from different sources
.         merge 1:1 pid syear using "$IN/pgen.dta", nogen keep(master matches)
(variable syear was long, now double to accommodate using data's values)

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                            35,228  
    -----------------------------------------

.         * pl contains all variables from the individual questionnaire
.         merge 1:1 pid syear using "$IN/pl.dta", nogen keep(master matches)
(variable inputdataset was str6, now str9 to accommodate using data's values)
(label cid already defined)
(label pid_EN already defined)
(label cid_EN already defined)

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                            35,228  
    -----------------------------------------

.         * hgen contains generated variables on household level from the house
> hold interview; use for household net income
.         merge m:1 hid syear using "$IN/hgen.dta", nogen keep(master matches) 
> keepusing(hid syear hghinc)
(label iyear already defined)
(label iyear_EN already defined)

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                            35,228  
    -----------------------------------------

.         
.         ** Merge also with biol data to gather the remaining original variabl
> es needed.
.         merge 1:1 pid syear using "$IN/biol.dta", nogen keep(master matches)
(variable instrument was long, now double to accommodate using data's values)
(label hid already defined)
(label cid already defined)
(label pnr already defined)
(label p_anker already defined)
(label instrument already defined)
(label iyear already defined)
(label intid already defined)
(label p_buh1 already defined)
(label p_buh2 already defined)
(label p_buh3 already defined)
(label p_buh4 already defined)
(label p_buh5 already defined)
(label p_buh6 already defined)
(label p_buh7 already defined)
(label p_buh8 already defined)
(label p_buh9 already defined)
(label p_buh10 already defined)
(label p_buh11 already defined)
(label pid_EN already defined)
(label hid_EN already defined)
(label cid_EN already defined)
(label pnr_EN already defined)
(label syear_EN already defined)
(label p_anker_EN already defined)
(label instrument_EN already defined)
(label iyear_EN already defined)
(label intid_EN already defined)
(label p_buh1_EN already defined)
(label p_buh2_EN already defined)
(label p_buh3_EN already defined)
(label p_buh4_EN already defined)
(label p_buh5_EN already defined)
(label p_buh6_EN already defined)
(label p_buh7_EN already defined)
(label p_buh8_EN already defined)
(label p_buh9_EN already defined)
(label p_buh10_EN already defined)
(label p_buh11_EN already defined)

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                            35,228  
    -----------------------------------------

. 
. 
.         label language EN // change language of the labels to English

. 
. * Reduce dataset to retain only relevant variables.
. keep pid hid syear ///
>      kidsex* kidgeb* ///
>          plh0308_v1 lb1120 plh0308_v2 ///
>          gebjahr sumkids pgpartz ///
>          pbleib

. 
.         save "$DATA/h1_dataset_RT01m03n.dta", replace // save merged dataset
(file C:\Users\dalbrecht\Research
    Projects\ManyDaughters\ManyDaughters_DataPreprocessing/data/derived_confi
    > dential/5%-sample/h1_dataset_RT01m03n.dta not found)
file C:\Users\dalbrecht\Research
    Projects\ManyDaughters\ManyDaughters_DataPreprocessing/data/derived_confi
    > dential/5%-sample/h1_dataset_RT01m03n.dta saved

. 
. 
. * ============================
. * Analysis
. * ============================
. 
. * FILTERS * 
.  
.         * 1. Generate flags per child if that child is a daughter born before
>  2000. 
. gen byte daughter_pre2000 = 0

. 
. forvalues i = 1/19 {
  2.     local k = string(`i', "%02.0f")  // formats 1 as "01", 2 as "02", ...,
>  19 as "19"
  3.     quietly replace daughter_pre2000 = 1 if kidsex`k' == 2 & kidgeb`k' < 2
> 000
  4. }

. 
.         * 2. Drop participants with daughters born before 2000
. drop if daughter_pre2000 == 1
(12,041 observations deleted)

. 
. 
. 
. * GENERATE VARIABLES * 
. 
.         * 1. Generate main predictor: binary variable to measure whether a gi
> ven respondent has (1) one or multiple daughters or (0) no children or one or
>  multiple sons born by the current year.
.         ** Using variables kidgeb* kidsex*. Binary assessed at all panel wave
> s (2000-2020)
.         *** Note: The answer "Does not apply (coded as -2)" in var kidgeb* is
>  assumed to measure absence of children, thus coded as 0
. 
. gen byte daughter_any = 0

. 
. forvalues i = 1/19 {
  2.     local k = string(`i', "%02.0f")
  3.     quietly replace daughter_any = 1 if kidsex`k' == 2 & kidgeb`k' <= syea
> r
  4.     quietly replace daughter_any = . if kidgeb`k' == -3 | kidgeb`k' == -1
  5. }

. 
. 
.         * 2. Generate main outcome: respondent's attitude toward gender equal
> ity. 
.         ** Using the following items: f12p116k (in pl seems defined as plh030
> 8_v1; assessed in 2012), lb1120 (assessed between 2010-2013), plh0308_v2 (ass
> essed in 2018).
.         *** Note: The data documentation suggested that lb1120 was assessed i
> n 2020. This was thus what we indicated in the pre-analysis plan (PAP). Howev
> er, the measure was instead available in the dataset in the years 2010 to 201
> 3. We used it as available.
.         
.         * 2.1 Recode missing values to Stata system missing (.)
. foreach var in plh0308_v1 plh0308_v2 lb1120 {
  2.     replace `var' = . if inlist(`var', -8, -5, -1)
  3. }
(16,436 real changes made, 16,436 to missing)
(15,838 real changes made, 15,838 to missing)
(3,324 real changes made, 3,324 to missing)

. 
.         * 2.2 Reverse code plh0308_v1 and lb1120 (they're 1 = most egalitaria
> n, 4 = least). 
.         *** Note: This reverse coding was not indicated in the PAP.
. gen plh0308_v1_r = 5 - plh0308_v1 if !missing(plh0308_v1)
(22,923 missing values generated)

. gen lb1120_r     = 5 - lb1120     if !missing(lb1120)
(22,823 missing values generated)

. 
.         * 2.3 Standardize all three variables (puts them on the same metric)
.         *** Note: The three individual measures were standardized to harmoniz
> e their scale. plh0308_v2 was on a range 1-7 different from the other two mea
> sures (1-4). The standardizing procedure was not indicated in the PAP but we 
> consider it is needed to correctly run the analysis.
. egen z_plh0308_v1_r = std(plh0308_v1_r)
(22,923 missing values generated)

. egen z_lb1120_r = std(lb1120_r)
(22,823 missing values generated)

. egen z_plh0308_v2 = std(plh0308_v2)
(22,325 missing values generated)

. 
.         * 2.4 Compute average across standardized items (higher = more egalit
> arian)
.         *** Note: because the item lb1120 is available between the years 2010
> -2013 but not in 2020, we generate an index by averaging the three measures s
> o that 1) if a value is only available for one variable in a given year, the 
> index will take the value of the non-missing variable, 2) if values are avail
> able for more than one variable, the index will take the mean of any of the v
> ariables that were available.
. egen gender_attitudes = rowmean(z_plh0308_v1 z_lb1120 z_plh0308_v2)
(21,706 missing values generated)

. 
. 
.         * 3. Generate covariates: age and partnership status.
.         
.         ** 3.1. Generate age:computed as survey year - year of birth.
. gen age = syear - gebjahr

. 
.         ** 3.2. Generate partnership status: using the pgpartz variable to as
> sess the respondent's partnership status, distinguishing between (0) no partn
> er and (1) spouse/registered partner, partner, probably spouse/registered par
> tner, probably partner.
. gen partner_status = .
(23,187 missing values generated)

.         replace partner_status = 0 if pgpartz == 0
(6,501 real changes made)

.         replace partner_status = 1 if inlist(pgpartz, 1, 2, 3, 4)
(10,494 real changes made)

.         label define partner_lbl 0 "No partner" 1 "Has partner"

.         label values partner_status partner_lbl

. 
. 
. 
. 
. * HYPOTHESIS TEST FOR H1 * (Please adapt according to your needs)
. 
.         * Fixed effects model.
. 
.         ** We assume that the three items combined above in gender_attitudes 
> are an appropriate measure to "capture" support for gender equality (hypothes
> is 1). At higher values, the respondent is more likely to support gender equa
> lity.
. 
.         ** We run a fixed effects model with gender_attitudes as the dependen
> t variable and the dummy variable daughter_any as the main independent variab
> le. 
.         
.         ** set data as panel so we can use Stata's panel data xt commands and
>  the time series operators. 
. xtset pid syear

Panel variable: pid (unbalanced)
 Time variable: syear, 2000 to 2020, but with gaps
         Delta: 1 unit

.                 
.         ** We predict respondents' attitudes toward gender equality as a func
> tion of whether they had one or multiple daughters in the preceding panel wav
> e. The model controls for age, sumkids (number of children), and partner_stat
> us (partnership status) also measured at the preceding panel waves. To includ
> e in the model all the predictors assessed in the preceding panel wave, we tr
> ansformed them before running the model using the time series operator L1.
. foreach var in daughter_any age sumkids partner_status {
  2.     gen `var'_L1 = L1.`var'
  3. }
(3,247 missing values generated)
(3,220 missing values generated)
(3,220 missing values generated)
(7,471 missing values generated)

.         
.         ** We estimate cluster-robust standard errors at the individual level
>  (using the pid variable) and employ weights to adjust the estimation to attr
> ition bias, using the inverse staying probability weight (pbleib). 
.         *** Note: No design weight, in contrast to what we indicated in the P
> AP, because a design weight was not available in the data. The variable sumki
> ds is omitted from the model due to collinearity with the fixed effects.
. 
. reghdfe gender_attitudes daughter_any_L1 ///
>         age_L1 sumkids_L1 partner_status_L1 /// 
>   [pweight = pbleib] /// applying the weight 
>   , absorb(pid) /// fixed effects option
>   vce(cluster pid)
(dropped 732 singleton observations)
(MWFE estimator converged in 1 iterations)
note: sumkids_L1 is probably collinear with the fixed effects (all partialled-o
> ut values are close to zero; tol = 1.0e-09)

HDFE Linear regression                            Number of obs   =        272
Absorbing 1 HDFE group                            F(   3,    135) =       2.44
Statistics robust to heteroskedasticity           Prob > F        =     0.0668
                                                  R-squared       =     0.7645
                                                  Adj R-squared   =     0.5202
                                                  Within R-sq.    =     0.0515
Number of clusters (pid)     =        136         Root MSE        =     0.7392

                                  (Std. err. adjusted for 136 clusters in pid)
------------------------------------------------------------------------------
             |               Robust
gender_att~s | Coefficient  std. err.      t    P>|t|     [95% conf. interval]
-------------+----------------------------------------------------------------
daughter_a~1 |  -.3852832   .3408763    -1.13   0.260    -1.059432    .2888652
      age_L1 |  -.0307474   .0155401    -1.98   0.050    -.0614809   -.0000138
  sumkids_L1 |          0  (omitted)
partner_st~1 |   .2644959   .3189992     0.83   0.408    -.3663864    .8953782
       _cons |   1.094826   .6602093     1.66   0.100    -.2108646    2.400517
------------------------------------------------------------------------------

Absorbed degrees of freedom:
-----------------------------------------------------+
 Absorbed FE | Categories  - Redundant  = Num. Coefs |
-------------+---------------------------------------|
         pid |       136         136           0    *|
-----------------------------------------------------+
* = FE nested within cluster; treated as redundant for DoF computation

.   
.  
.  
. * EXTRACT AND EXPORT RESULTS * 
. 
.         * Extract the required statistics
. 
.                 * (i) coefficient estimate
.                 local coefficient = _b[daughter_any_L1]

. 
.                 * (ii) standard error
.                 local se = _se[daughter_any_L1]

. 
.                 * (iii) family of the test statistic (e.g. z, t, F, Chi²)
.                 local test_stat_family = "t"

. 
.                 * (iv) residual and model degrees of freedom (DFs) if applica
> ble
.                 local df_residual = e(df_r)

.                 local df_model = e(df_m)

. 
.                 * (v) p-value
.                 local p_value = _b[daughter_any_L1] / _se[daughter_any_L1]

.                 local p_value = 2 * ttail(e(df_r), abs(`p_value'))

. 
.                 * (vi) number of observations
.                 local num_obs = e(N)

. 
.                 * (vii) number of participants
.                 quietly levelsof pid if e(sample), local(participants)

.                 local num_participants : word count `participants'

. 
.                 * (viii) interpretation of directionality
.                 scalar coef_daughter_any = _b[daughter_any_L1]

.                 
.                 local interpretation "positive coefficient is in line with hy
> pothesis"

.         
. 
.         // Display the saved statistics
.         di "Coefficient: `coefficient'"
Coefficient: -.3852831900425696

.         di "Standard Error: `se'"
Standard Error: .3408762640443297

.         di "Test Statistic Family: `test_stat_family'"
Test Statistic Family: t

.         di "Residual Degrees of Freedom: `df_residual'"
Residual Degrees of Freedom: 135

.         di "Model Degrees of Freedom: `df_model'"
Model Degrees of Freedom: 3

.         di "p-value: " `p_value'
p-value: .26036539

.         di "Number of observations: " `num_obs'
Number of observations: 272

.         di      "Number of participants: " `num_participants'
Number of participants: 136

.         di "Interpretation of directionality: " "`interpretation'"
Interpretation of directionality: positive coefficient is in line with hypothes
> is

. 
.         * Export results to csv 
.         file open myfile using "$OUT/h1_results.csv", write replace // Rename
> d to original naming convention by David Albrecht on 15.07.2025
(file C:\Users\dalbrecht\Research
    Projects\ManyDaughters\ManyDaughters_DataPreprocessing/data/derived/5_res
    > ults/h1_results.csv not found)

.         file write myfile "coefficient,se,family,residual_df,model_df,p_value
> ,num_obs,num_participants,interpretation" _n

.         file write myfile "`coefficient', `se', `test_stat_family', `df_resid
> ual', `df_model',`p_value',`num_obs',`num_participants',`interpretation'" _n

.         file close myfile

. 
. 
