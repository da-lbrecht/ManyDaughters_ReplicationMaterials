. * ============================
. * Analysis
. * ============================
. 
. /* REMINDER: H3 Having daughters leads to more gender equality in the househo
> ld (as measured by behaviors or outcomes)*/
. 
. * FILTERS * (Please adapt according to your needs)
.         
.         * drop observations where main outcome is missing for one of the part
> ners
.         drop if missing(hours_m) | missing(hours_f)
(924 observations deleted)

.         
.         * drop observations with no child / no information on birth biography
.         drop if missing(kidgeb01) 
(962 observations deleted)

.         
.         * drop people with first birth before SOEP observation period
.         drop if kidgeb01 < 1985
(2,844 observations deleted)

. 
. * GENERATE VARIABLES * (Please adapt according to your needs)
. 
. 
. /* variables on individual characteristics */
. 
.         * gen age variable
.         gen gebjahr_clean = gebjahr 

.         ereplace gebjahr_clean = mode(gebjahr_clean), by(pid) // ensure consi
> stent birth year
(0 real changes made)

.         gen age = syear - gebjahr_clean

.         label var age "Age"

.         
.         * gen dummy indicating whether individual is of male sex
.         tab sex, m

                                 Gender |      Freq.     Percent        Cum.
----------------------------------------+-----------------------------------
                               [1] Male |      4,030      100.00      100.00
----------------------------------------+-----------------------------------
                                  Total |      4,030      100.00

.         gen male = (sex == 1) if !missing(sex)

.         label var male "Sex: Male"

.         
.         * gen dummy for being married
.         tab pgfamstd, m

          Marital Status In Survey Year |      Freq.     Percent        Cum.
----------------------------------------+-----------------------------------
                            [1] Married |      3,468       86.05       86.05
             [2] Married, But Separated |         25        0.62       86.67
                             [3] Single |        394        9.78       96.45
                           [4] Divorced |        135        3.35       99.80
[7] Registered Same-Sex Partnership, Li |          2        0.05       99.85
                                      . |          6        0.15      100.00
----------------------------------------+-----------------------------------
                                  Total |      4,030      100.00

.         gen married = (pgfamstd == 1 | pgfamstd == 7) if !missing(pgfamstd)
(6 missing values generated)

.         label var married "Married (Verheiratet zus. / eingetragende gg Partn
> erschaft zus.)"

. 
. /* variables on parenthood/childbirth */
. 
.         describe kidgeb01

Variable      Storage   Display    Value
    name         type    format    label      Variable label
-------------------------------------------------------------------------------
kidgeb01        double  %54.0g     kidgeb01_EN
                                              Year Of Birth 1st. Child

.         sum kidgeb01 if !missing(kidgeb01)

