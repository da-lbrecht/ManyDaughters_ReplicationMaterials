. recode kidmon02 (-100/-1=.)
(23,109 changes made to kidmon02)

. gen birthdate_2=mdy(kidmon02, 15, kidgeb02) //day not recorded, set to the 15
> th of the month
(23,109 missing values generated)

. lab var birthdate_2 "Birthdate of second child"

. 
. * Date of interview
. recode pgpiyear (-100/-1=.)
(20,116 changes made to pgpiyear)

. replace pgpiyear=syear if pgpiyear>=. /*not mentioned in PAP, we did not know
