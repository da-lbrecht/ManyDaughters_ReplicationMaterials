> *******
.         *Merge males and females into one household
.         * Males dataset
.         preserve 

.                 keep if female == 0
(15,902 observations deleted)

. 
.                 unab allvars: _all

.                         loc vars_to_exclude parid syear // Variablen ausschli
> eßen

.                         loc pruned_list : list allvars - vars_to_exclude

.                         foreach x of loc pruned_list {
  2.                                         rename `x' `x'_male
  3.                                 }

.                 keep if !missing(parid)         
(4,985 observations deleted)

.                 save "$DATA/h3_dataset_p_male.dta", replace 
(file C:\Users\dalbrecht\Research
    Projects\ManyDaughters\ManyDaughters_DataPreprocessing/data/derived_confi
    > dential/5%-sample/h3_dataset_p_male.dta not found)
file C:\Users\dalbrecht\Research
    Projects\ManyDaughters\ManyDaughters_DataPreprocessing/data/derived_confi
    > dential/5%-sample/h3_dataset_p_male.dta saved

.         restore 

.         
.         * Females dataset
.         preserve 

.                 keep if female == 1
(14,628 observations deleted)

.                 
.                 unab allvars: _all

.                         loc vars_to_exclude parid syear // Variablen ausschli
> eßen

.                         loc pruned_list : list allvars - vars_to_exclude

.                         foreach x of loc pruned_list {
  2.                                         rename `x' `x'_female
  3.                                 }

.                 drop parid

.                 rename pid_female parid 

.                 save "$DATA/h3_dataset_p_female.dta", replace 
