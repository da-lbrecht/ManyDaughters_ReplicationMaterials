.         
.         keep if kidgeb01==2017 | kidgeb01==2018 // first child 2016 or 2017
(10,170 observations deleted)

.         keep if syear == 2019 // year of outcome observation
(73 observations deleted)

.         keep if pli0044_h>0 & pli0044_h!=. & pli0043_h>0 & pli0043_h!=.  // I
> nfo on outcome (woman)
(4 observations deleted)

