. *----------------------------------------------------------------------------
. * PREPARE VARIABLES * 
. *----------------------------------------------------------------------------
. use "$DATA/h1_dataset.dta", clear

. 
. *-----------------------------
. * Construct Outcome Variables
. *-----------------------------
. global gnorm_raw plh0302_v1 plh0302_v2 plh0308_v1 plh0308_v2 plh0298_v1 plh02
> 98_v2

. mvdecode ${gnorm_raw} piyear, mv(-10/-1)
  plh0302_v1: 26741 missing values generated
  plh0302_v2: 25834 missing values generated
  plh0308_v1: 26743 missing values generated
  plh0308_v2: 25835 missing values generated
  plh0298_v1: 26741 missing values generated
  plh0298_v2: 25832 missing values generated
      piyear: 444 missing values generated

. 
. replace plh0308_v1 = 5 - plh0308_v1
(363 real changes made)

. gen id_gnorm_eq = plh0308_v1 > 2 & plh0308_v1 != .

. replace id_gnorm_eq = 1 if id_gnorm_eq == 0 & plh0308_v2 > 4 & plh0308_v2 != 
> .
(878 real changes made)

. label variable id_gnorm_eq "Agree with: Best if man and woman work the same a
> mount"

. 
. *-----------------------------
. * Construct Regressors
. *-----------------------------
. bysort pid: egen byte Daughter = max(kidsex01==2)

. bysort pid: egen byte Son = max(kidsex01==1)

. bysort pid (syear): assert Daughter==Daughter[1]

. gen int yearFirstChild = kidgeb01

. gen byte Post = (syear >= kidgeb01) if (Daughter==1 | Son==1) & inrange(yearF
> irstChild, 2013, 2017)
(34,269 missing values generated)

. gen byte Man = (sex==1)

. 
. *-----------------------------
. * Controls (PaP Table 4)
. *-----------------------------
. mdesc sumkids pgfamstd plh0258_h sampreg birthregion_ew bioage migback pgbilz
> eit hghinc pgemplst pgexpft

    Variable    |     Missing          Total     Percent Missing
----------------+-----------------------------------------------
        sumkids |           0         35,228           0.00
       pgfamstd |       7,823         35,228          22.21
      plh0258_h |       8,122         35,228          23.06
        sampreg |           0         35,228           0.00
   birthregio~w |           0         35,228           0.00
         bioage |           0         35,228           0.00
        migback |           0         35,228           0.00
      pgbilzeit |       7,823         35,228          22.21
         hghinc |       4,207         35,228          11.94
       pgemplst |       7,823         35,228          22.21
        pgexpft |       7,823         35,228          22.21
----------------+-----------------------------------------------

. 
. gen nchild = sumkids

. replace nchild = 5 if nchild > 5
(412 real changes made)

. 
. gen mastat = pgfamstd == 1 | pgfamstd == 6 | pgfamstd == 7 | pgfamstd == 8

. replace mastat = . if pgfamstd == .
(7,823 real changes made, 7,823 to missing)

. label define mastat 0 "Unmarried" 1 "Married"

. label values mastat mastat

. 
. replace sampreg = sampreg - 1
(35,228 real changes made)

. replace birthregion_ew = birthregion_ew - 1
(35,228 real changes made)

. label define ew 0 "West" 1 "East"

. label values sampreg ew

. label values birthregion_ew ew

. 
. sort pid piyear

. gen age = syear - gebjahr

. gen age_sq = age^2

. 
. gen exp = pgexpft
(7,823 missing values generated)

. gen exp_sq = exp^2
(7,823 missing values generated)

. 
. gen byte emplyd = inlist(pgemplst,1,2)

. label define emp 0 "Not employed" 1 "Employed"

. label values emplyd emp

. 
. label variable hghinc "Household net income"

. global controls "i.nchild i.mastat i.sampreg age age_sq exp exp_sq i.migback 
> pgbilzeit hghinc i.emplyd"

. 
. *-----------------------------
. * Sample Restrictions
. *-----------------------------
. keep if inlist(pop,1,2)
(4,698 observations deleted)

. keep if sampreg >= 0 & inrange(age,18,50)
(14,445 observations deleted)

. keep if yearFirstChild > 0
(4,839 observations deleted)

. keep if inlist(syear, 2012, 2018)
(9,993 observations deleted)

. keep if inrange(yearFirstChild, 2013, 2017)
(1,137 observations deleted)

. 
. bysort pid: egen byte has_eq_pre = max(!missing(id_gnorm_eq) & !Post & syear=
> =2012)

. bysort pid: egen byte has_eq_post = max(!missing(id_gnorm_eq) & Post & syear=
> =2018)

. 
. 
. *============================================================================
> ===
. *H1 Analysis
. *============================================================================
> ===
. 
. *-----------------------------
. * DiD regressions  
. *Regression : y_i,t = β_0 + β_1*Daughter_i + β_2*Post_i,t + β_3*Daughter_i × 
> Post_i,t + \gamma*X_i,t + \varepsilon_i,t
. * The study employs a difference-in-differences (DiD) design to test whether 
> having daughters leads to more left-leaning political preferences. The approa
> ch leverages the quasi-random assignment of child sex to compare individuals 
> whose first child is a girl (treatment group) versus those whose first child 
> is a boy (control group), examining changes in support for gender equality.
. *-----------------------------
. 
. keep if has_eq_pre & has_eq_post
(78 observations deleted)

. xtset pid syear

Panel variable: pid (strongly balanced)
 Time variable: syear, 2012 to 2018, but with gaps
         Delta: 1 unit

. xtreg id_gnorm_eq i.Daughter##i.Post i.Man $controls, re vce(cluster cid)

