.     
. * Extract coefficients and SEs
. local b1 = _b[1.Daughter]

. local s1 = _se[1.Daughter]

. local b2 = _b[1.Post]

. local s2 = _se[1.Post]

. local b3 = _b[1.Daughter#1.Post]

. local s3 = _se[1.Daughter#1.Post]

. 
. * Compute test for β3 > 0
. local df_m = e(df_m)

. local df_r = e(N_clust) - 1

. local t3 = `b3'/`s3'

. local pval3 = ttail(`df_r', `t3')

. local Nobs = e(N)

. quietly levelsof pid if e(sample), local(ids)

. local Nind: word count `ids'

. local R2 = e(r2_o)

. local interp = "positive coefficient is in line with hypothesis"

. local test_stat_family = "t"

. 
. * Export results to csv 
.         file open myfile using "$OUT/h2_results.csv", write replace
(file C:\Users\dalbrecht\Research
    Projects\ManyDaughters\ManyDaughters_DataPreprocessing/data/derived/5_res
    > ults/h2_results.csv not found)

.         file write myfile "coefficient,se,family,residual_df,model_df,p_value
> ,num_obs,num_participants,interpretation" _n

.         file write myfile "`b3',`s3',`test_stat_family',`df_r',`df_m',`pval3'
> ,`Nobs',`Nind',`interp'" _n

.         file close myfile

. 
