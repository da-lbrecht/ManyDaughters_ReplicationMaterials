.         local coefficient = b[1,1]

. 
.         * (ii) standard error
.         matrix V = r(V)

.         local se = sqrt(V[1,1])

. 
.         * (iii) family of the test statistic (z for nlcom)
.         local test_stat_family = "z"

. 
.         * (iv) residual and model degrees of freedom (not available for nlcom
