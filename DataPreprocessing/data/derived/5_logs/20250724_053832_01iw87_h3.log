.         egen b=group(hid parid pid)

.         egen c=rowmin(a b)

. 
.         * Generate dyad-id
.         egen dyad=group(hid c)

.         lab var dyad "Dyad ID"

.         sort hid syear

. 
.         * Create dyad indicator
.         gen dyad_ind=.
(17,742 missing values generated)

.         replace dyad_ind=1 if !missing(dyad)
