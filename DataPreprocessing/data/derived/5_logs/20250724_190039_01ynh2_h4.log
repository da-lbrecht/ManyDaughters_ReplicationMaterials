file C:\Users\dalbrecht\Research
    Projects\ManyDaughters\ManyDaughters_DataPreprocessing/data/derived_confi
    > dential/5%-sample/h4_dataset.dta saved

. 
. * ============================
. * INCLUSION CRITERIA
. * ============================
. 
. **Survey Year 2016 and having children 
.         keep if syear == 2016 & lb0285 > 0      
(33,375 observations deleted)

.         
. * ============================
. * DATA MANAGEMENT
. * ============================
. 
. *------------------------------------------------------
. *** DEPENDENT VARIABLE: attitudes toward gender equality
. *------------------------------------------------------
. 
.         **recode missing values 
.         recode plj0620 plj0621 plj0622 plj0623 plj0624 plj0625 (-1 = .) (-2 =
>  .) (-3 = .) (-4 = .) (-5 = .) (-6 = .) (-7 = .) (-8 = .) (-9 = .)
(1,246 changes made to plj0620)
(1,243 changes made to plj0621)
(1,244 changes made to plj0622)
(1,246 changes made to plj0623)
(1,246 changes made to plj0624)
(1,242 changes made to plj0625)

.         
.         **recode: plj0623 plj0624 plj0625
.         recode plj0623 plj0624 plj0625 (1=7) (2=6) (3=5) (5=3) (6=2) (7=1)
(118 changes made to plj0623)
(125 changes made to plj0624)
(118 changes made to plj0625)

.         label define scale_recoded ///
>                 1       "[1] [de] 1=Stimme voll zu, (Skale 1-7) recoded " ///
>                 2       "[2] [de] 2 auf Skala 0-7 recoded" ///
>                 3       "[3] [de] 3 auf Skala 0-7 recoded" ///
>                 4       "[4] [de] 4 auf Skala 0-7 recoded" ///
>                 5       "[5] [de] 5 auf Skala 0-7 recoded" ///
>                 6       "[6] [de] 6 auf Skala 0-7 recoded" ///
>                 7       "[7] [de] 7=Stimme überhaupt nicht zu, (Skale 1-7) re
> coded " ///
>                 , replace

.         label values plj0623 plj0624 plj0625 scale_recoded

. 
.         **z-standardize - index - z-standardize
.         foreach var of varlist plj0620 plj0621 plj0622 plj0623 plj0624 plj062
> 5 {
  2.                 egen z_`var' = std(`var')
  3.                 }
(1,723 missing values generated)
(1,720 missing values generated)
(1,721 missing values generated)
(1,723 missing values generated)
(1,723 missing values generated)
(1,719 missing values generated)

. 
.         gen attitude_gender_equality = (z_plj0620 + z_plj0621 + z_plj0622 + z
> _plj0623 + z_plj0624 + z_plj0625) / 6
(1,732 missing values generated)

.         
.         egen z_attitude_gender_equality = std(attitude_gender_equality)
(1,732 missing values generated)

.         
.         
. *------------------------------------------------------ 
. ***INDEPENDENT VARIABLE: Having Daughter 
. *------------------------------------------------------
.                 
.         **kidsex == 2 means daughter 
.         gen having_daughter = 0 

.         replace having_daughter = 1 if kidsex01 == 2 | kidsex02 == 2 | kidsex
> 03 == 2 | ///
>                 kidsex04 == 2 | kidsex05 == 2 | kidsex06 == 2 | kidsex07 == 2
>  | ///
>                 kidsex08 == 2 | kidsex09 == 2 | kidsex10 == 2 | kidsex11 == 2
>  | kidsex12 == 2 | ///
>                 kidsex13 == 2 | kidsex14 == 2 | kidsex15 == 2 | kidsex16 == 2
>  | kidsex17 == 2 | ///
>                 kidsex18 == 2 | kidsex19 == 2 
(1,007 real changes made)

. 
. *------------------------------------------------------
. ***CONTROLS     
. *------------------------------------------------------
. 
. *INFO: Contrary to the PAP, we excluded the variables 'education of father' (
> lb0380) and 'education of mother' (lb0381), as both variables had only empty 
> values in 2016. We attempted to use lb0091_h and lb0092_h as alternatives, bu
> t these variables had insufficient observations. Consequently, we have decide
> d not to use these variables in our analysis.
. 
. 
. *------------------------------------------------------
. * RELIGIOUS: create variable religious
. *------------------------------------------------------
.         
.         gen religious = .
(1,853 missing values generated)

.         replace religious = 1 if inlist(plh0258_h, 1,2,3,4,5,7,8,9,10,11,12)
(135 real changes made)

.         replace religious = 0 if plh0258_h == 6
(7 real changes made)

.         bysort pid (syear): replace religious = religious[_n-1] if missing(re
> ligious)
(0 real changes made)

. 
.         
. *------------------------------------------------------ 
. * GENDER: recode sex
. *------------------------------------------------------
. 
.         recode sex (1=0) (2=1)
(1,853 changes made to sex)

.         label define sex ///
>                 0       "[0] male " ///
>                 1       "[1] female" ///
>                 , replace

.         label values sex sex 

.         
. 
. *------------------------------------------------------
. * ORIGIN: born in Germany - corigin 
. *------------------------------------------------------
. 
.         gen born_germany = .
(1,853 missing values generated)

.         replace born_germany = 1 if corigin == 1
(1,303 real changes made)

.         replace born_germany = 0 if corigin > 1
(550 real changes made)

.         
.         
. *------------------------------------------------------ 
. * EDUCATION: own education - pgpsbil 
. *------------------------------------------------------
. *INFO: An issue pertained to the variable pgpsbil within category 5 (other de
> gree), which encompassed a substantial number of observations. The interpreta
> tion of this category proved to be unfeasible.
. *Therefore, an alternative is employed in the form of the variable pgbilzeit 
> (years of education).
. 
.         recode pgbilzeit (-1 = .) (-2 = .) (-3 = .) (-4 = .) (-5 = .) (-6 = .
> ) (-7 = .) (-8 = .) (-9 = .) 
(105 changes made to pgbilzeit)

.         
.         
. *------------------------------------------------------
. * AGE: age in 2016 
. *------------------------------------------------------
. 
.         gen age = 2016 - ple0010_h  
(477 missing values generated)

.         gen age_ln = ln(age)
(477 missing values generated)

. 
. 
. *------------------------------------------------------ 
. * SINGLEPARENT: Singleparent/ partner in household 
. *------------------------------------------------------
. *INFO: pld0133 is conditional on having a "Lebensgemeinschaft". 
. *Married people living with their partner (pld0131_v1 == 1) are also coded as
>  1 (partner lives in household)
. 
.         gen with_partner = .
(1,853 missing values generated)

.         *married people living with their partner
.         replace with_partner = 1 if pld0131_v1 == 1 
(728 real changes made)

.         *partner lives in household
.         replace with_partner = 1 if pld0133 == 1
(136 real changes made)

.         *partner does not live in household
.         replace with_partner = 0 if pld0133 == 2
(107 real changes made)

.         *no "Lebensgemeinschaft" = no partner
.         replace with_partner = 0 if pld0132_h == 2
(255 real changes made)

. 
.         label define with_partner ///
>                 0       "[0] no(t with) partner " ///
>                 1       "[1] partner lives in household" ///
>                 , replace

.         label values with_partner with_partner

. 
. 
. *------------------------------------------------------
. * DAUGHTERS DISTANCE
. *------------------------------------------------------
. 
.         gen daughters_distance = 0 

.         replace daughters_distance = 1 if plj0122_h == 1 & having_daughter ==
>  1
(20 real changes made)

.         label define distance ///
>                 0       "[0] daughter does not live in household or only sons
> " ///
>                 1       "[1] daughter lives in household" ///
>                 , replace

.         label values daughters_distance distance

. 
. *------------------------------------------------------
. * INCOME: Personal contribution to income
. *------------------------------------------------------
. 
.         recode pglabnet (-1 = .) (-2 = .) (-3 = .) (-4 = .) (-5 = .) (-6 = .)
>  (-7 = .) (-8 = .) (-9 = .)
(636 changes made to pglabnet)

.         recode hlc0005_h (-1 = .) (-2 = .) (-3 = .) (-4 = .) (-5 = .) (-6 = .
> ) (-7 = .) (-8 = .) (-9 = .)
(90 changes made to hlc0005_h)

.         
.         gen income_ratio = pglabnet / hlc0005_h
(1,125 missing values generated)

. 
. 
. * ============================
. * ANALYSIS
. * ============================
.                   
.         reg z_attitude_gender_equality having_daughter##sex lb0285 pgbilzeit 
>  ///
>                 c.age_ln reli, vce(cluster pid)

Linear regression                               Number of obs     =        115
                                                F(7, 114)         =       2.10
                                                Prob > F          =     0.0488
                                                R-squared         =     0.0811
                                                Root MSE          =     .98828

                                  (Std. err. adjusted for 115 clusters in pid)
------------------------------------------------------------------------------
             |               Robust
z_attitude~y | Coefficient  std. err.      t    P>|t|     [95% conf. interval]
-------------+----------------------------------------------------------------
1.having_d~r |  -.5196831   .3350197    -1.55   0.124    -1.183355    .1439884
             |
         sex |
 [1] female  |  -.0374397   .3928816    -0.10   0.924    -.8157351    .7408557
             |
having_dau~r#|
         sex |
          1 #|
 [1] female  |   .0807937   .4303045     0.19   0.851    -.7716362    .9332237
             |
      lb0285 |   .0390425   .0507982     0.77   0.444    -.0615884    .1396733
   pgbilzeit |   .1051293    .043243     2.43   0.017     .0194653    .1907933
      age_ln |  -.8111579   .4570068    -1.77   0.079    -1.716485    .0941691
   religious |  -.2314844    .415257    -0.56   0.578    -1.054105    .5911365
       _cons |   2.550964   1.736953     1.47   0.145    -.8899272    5.991855
------------------------------------------------------------------------------

.         
.         
. **The variables daughters_distance, with_partner, and born_germany were eithe
> r omitted due to collinearity or not available for any observations in the es
> timation sample. Furthermore, including income_ratio and the interaction term
>  c.income_ratio#sex resulted in a loss of approximately 88% of the observatio
> ns. As a result, all these variables, although pre-specified in the PAP, were
>  excluded from the final regression models in order to preserve statistical p
> ower and ensure model convergence.
. **This may be resolved when using the full dataset
. 
. *reg z_attitude_gender_equality having_daughter##sex lb0285 pgbilzeit c.age_l
> n ///
> *               income_ratio c.income_ratio#sex reli born_germany with_partne
> r daughters_distance, vce(cluster pid)
. 
.         
.                 
. * ============================
. * EXTRACT AND EXPORT RESULTS 
. * ============================
. 
.         * Extract the required statistics
. 
.                 * (i) coefficient estimate
.                 local coefficient = _b[1.having_daughter#1.sex]

. 
.                 * (ii) standard error
.                 local se = _se[1.having_daughter#1.sex]

. 
.                 * (iii) family of the test statistic (e.g. z, t, F, Chi²)
.                 local test_stat_family = "t"

. 
.                 * (iv) residual and model degrees of freedom (DFs) if applica
> ble
.                 local df_residual = e(df_r)

.                 local df_model = e(df_m)

. 
.                 * (v) p-value
.                 local p_value = _b[1.having_daughter#1.sex] / _se[1.having_da
> ughter#1.sex]

.                 local p_value = 2 * ttail(e(df_r), abs(`p_value'))

. 
.                 * (vi) number of observations
.                 local num_obs = e(N)

. 
.                 * (vii) number of participants
.                 quietly levelsof pid if e(sample), local(participants)

.                 local num_participants : word count `participants'

. 
.                 * (viii) interpretation of directionality
.                 scalar coef_d_daughter = _b[1.having_daughter#1.sex]

.                 local interpretation "negative coefficient is in line with hy
> pothesis"

. 
.         // Display the saved statistics
.         di "Coefficient: `coefficient'"
Coefficient: .0807937276106758

.         di "Standard Error: `se'"
Standard Error: .4303045258413868

.         di "Test Statistic Family: `test_stat_family'"
Test Statistic Family: t

.         di "Residual Degrees of Freedom: `df_residual'"
Residual Degrees of Freedom: 114

.         di "Model Degrees of Freedom: `df_model'"
Model Degrees of Freedom: 7

.         di "p-value: " `p_value'
p-value: .85139904

.         di "Number of observations: " `num_obs'
Number of observations: 115

.         di      "Number of participants: " `num_participants'
Number of participants: 115

.         di "Interpretation of directionality: " "`interpretation'"
Interpretation of directionality: negative coefficient is in line with hypothes
> is

. 
