. do "20250725_160108_01hvq9_h2.do"

. *****************************************************************************
> ***
. ************************** H2: #ManyDaughters Project ***********************
> ***
. *****************************************************************************
> ***
. 
. * Authors: [REDACTED], [REDACTED]
. 
. * ============================
. * Setup *
. * ============================
. 
. * clear all
. version 16.1 // indicate the version of stata you are using here

. set maxvar 10000 // extend the maximum number of variables to 10,000


. 
. * INSTALL PACKAGES * 
. * ssc install outreg2
. 
. * CONFIGURE FILE PATHS * (Please do not change)
. /*
> * the following code automatically sets paths based on where you saved the di
> stributed file-package on your system *
> if strpos("`c(pwd)'", "code") {
>     global ROOT "`c(pwd)'/.."
> }
> else {
>     global ROOT "`c(pwd)'"
> }
> global IN "$ROOT/data/raw" // folder, in which the original datasets are stor
> ed
> global DATA "$ROOT/data/derived" // folder for datasets
> global OUT "$ROOT/out" // folder for output (results, tables)
> 
> */
. 
. * ============================
. * Data Preparation * 
. * ============================
. 
. * LOAD AND MERGE DATA *
. 
.         use "$IN/pl.dta", clear // use pl as a starting dataset
(SOEP-Core, v37 (EU Edition), doi:10.5684/soep.core.v37eu)

. 
.         * Merge pl with biobirth, which contains information on fertility his
> tory       
.         merge m:1 pid using "$IN/biobirth.dta", nogen keep(master matches) ke
> epusing(kidsex01 kidgeb01) 
(variable pid was long, now double to accommodate using data's values)
(label pid_EN already defined)
(label cid_EN already defined)
(label cid already defined)

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                            35,228  
    -----------------------------------------

.         
.         label language EN // change language of the labels to English

. 
.         save "$DATA/h2_dataset.dta", replace // save merged dataset
file C:\Users\dalbrecht\Research
    Projects\ManyDaughters\ManyDaughters_DataPreprocessing/data/derived_confi
    > dential/5%-sample/h2_dataset.dta saved

. 
. 
. * ============================
. * Analysis
. * ============================
. /* REMARKS: 
> 
> 1. The provided data set pl does not include the variable pla0009_h although 
> it was listed on paneldata.org as being part of the data set. We use variable
> s pla0009_v2 and pla0009_v3 to construct pla0009_h ourselves. 
> 
> 2. Our pre-analysis plan did not specify how we deal with cases where individ
> uals provided inconsistent responses for their year of birth or sex. In this 
> code, we set the corresponding variable to missing if an individual provided 
> inconsistent responses across the years. 
> 
> */
. 
. 
. * GENERATE VARIABLES * 
. 
.         * Generate dummy variable for whether participant has a first-born da
> ughter (1) or first-born son (0)
.         gen d_daughter = kidsex01==2

.         replace d_daughter=. if kidsex01<1 | kidsex01==. // set invalid respo
> nses to missing
(10,637 real changes made, 10,637 to missing)

.         
.         * Generate variable for individual being male based on plh0009 (consi
> dering sex observations across years)
.         gen pla0009_h = pla0009_v2
(8,122 missing values generated)

.         replace pla0009_v3 = -2 if  pla0009_v3==3
(0 real changes made)

.         replace pla0009_h = pla0009_v3 if syear>=2019
(3,051 real changes made)

.         replace pla0009_h=. if pla0009_h<0 // set invalid responses to missin
> g
(2,483 real changes made, 2,483 to missing)

.         bysort pid: egen sex_pla = mean(pla0009_h)
(476 missing values generated)

.         gen male = sex_pla==1

.         replace male = . if sex_pla!=1&sex_pla!=2 // replace with missings if
>  inconsistent responses across years 
(513 real changes made, 513 to missing)

.         
.         * Generate variable for year of first observation of plh0004 (input f
> or outcome variable) after first child was born
.         gen after = syear if syear>kidgeb01 & kidgeb01>0 & plh0004>=0 & plh00
> 04!=.
(31,901 missing values generated)

.         bysort pid: egen first = min(after)
(15,725 missing values generated)

.         drop after

.         
.         * Generate categorical variable for age in year of first relevant obs
> ervation (considering year of birth observations across years)
.         replace ple0010_h=. if ple0010_h<0
(1,493 real changes made, 1,493 to missing)

.         bysort pid: egen yearofbirth_min = min(ple0010_h)
(781 missing values generated)

.         bysort pid: egen yearofbirth_max = max(ple0010_h)
(781 missing values generated)

.         gen yearofbirth = yearofbirth_max if yearofbirth_min==yearofbirth_max
>  // results in missing if inconsistent responses across years
(971 missing values generated)

.         gen age_first = first-yearofbirth
(15,847 missing values generated)

.         gen age_cat = 1 if age_first>=18 & age_first<=24
(35,051 missing values generated)

.         replace age_cat = 2 if age_first>=25 & age_first<=30
(899 real changes made)

.         replace age_cat = 3 if age_first>=31 & age_first<=40
(4,457 real changes made)

.         replace age_cat = 4 if age_first>=41 & age_first<=50
(5,051 real changes made)

.         replace age_cat = 5 if age_first>=51 & age_first<=64
(4,864 real changes made)

.         replace age_cat = 6 if age_first>=65 & age_first!=.
(3,933 real changes made)

.         
.         * Generate outcome variable
.         replace plh0004=. if syear<first | plh0004<0
(23,779 real changes made, 23,779 to missing)

.         bysort pid: egen political = mean(plh0004) 
(15,725 missing values generated)

.         
. 
. * FILTERS * 
.         
.         * Exclude participants who have a missing value in one of the regress
> ors or outcome variable (which also excludes individuals below 18 based on ag
> e variable and individuals without children)
.         keep if d_daughter!=. & male!=. & age_cat!=. & political!=. & first!=
> .
(15,986 observations deleted)

.         
.         * Exclude participants without cid 
.         keep if cid!=. 
(1,707 observations deleted)

.         
.         * Keep only one row per individual
.         keep if syear==first
(15,764 observations deleted)

. 
.         
. * HYPOTHESIS TEST FOR H2 *
. 
.         * Description: We conduct an OLS regression, where we regress the out
> come variable (political leaning) on a dummy for whether the first-born child
>  is female. We additionally include a dummy for whether the respondent is mal
> e, a categorical variable for the age of the respondent in the survey year of
>  the first considered observation of plh0004 (i.e., the first observation aft
> er the birth of the first child), and a dummy for the year of the first consi
> dered observation of plh0004 as regressors. We cluster standard errors on the
>  household level. To test the hypothesis, we test whether we can reject that 
> the coefficient of the dummy for the first-born child being female is greater
>  than or equal to zero at the 5% significance level (based on a one-sided t-t
> est).
. 
.         reg political d_daughter male i.age_cat i.first, vce(cluster cid)

Linear regression                               Number of obs     =      1,771
                                                F(10, 1013)       =       5.05
                                                Prob > F          =     0.0000
                                                R-squared         =     0.0267
                                                Root MSE          =     1.5323

                                (Std. err. adjusted for 1,014 clusters in cid)
------------------------------------------------------------------------------
             |               Robust
   political | Coefficient  std. err.      t    P>|t|     [95% conf. interval]
-------------+----------------------------------------------------------------
  d_daughter |  -.2080121   .0809362    -2.57   0.010    -.3668339   -.0491903
        male |   .3030815   .0616115     4.92   0.000     .1821807    .4239822
             |
     age_cat |
          2  |  -.4550797   .4359352    -1.04   0.297    -1.310519    .4003597
          3  |  -.5071627    .409309    -1.24   0.216    -1.310353    .2960279
          4  |  -.7309739   .4127784    -1.77   0.077    -1.540973    .0790248
          5  |  -.5288219   .4098373    -1.29   0.197    -1.333049    .2754054
          6  |  -.4022166   .4137832    -0.97   0.331    -1.214187    .4097536
             |
       first |
       2009  |   -.126753   .1390506    -0.91   0.362    -.3996133    .1461073
       2014  |   -.213128   .1012153    -2.11   0.035    -.4117436   -.0145123
       2019  |  -.2728056   .1241012    -2.20   0.028    -.5163305   -.0292807
             |
       _cons |   5.383969   .4110006    13.10   0.000     4.577459    6.190479
------------------------------------------------------------------------------

. 
. 
. * EXTRACT AND EXPORT RESULTS * 
. 
.         * Extract the required statistics
. 
.                 * (i) coefficient estimate
.                 local coefficient = _b[d_daughter]

. 
.                 * (ii) standard error
.                 local se = _se[d_daughter]

. 
.                 * (iii) family of the test statistic (e.g. z, t, F, Chi²)
.                 local test_stat_family = "t"

. 
.                 * (iv) residual and model degrees of freedom (DFs) if applica
> ble
.                 local df_residual = e(df_r)

.                 local df_model = e(df_m)

. 
.                 * (v) p-value
.                 local p_value = _b[d_daughter] / _se[d_daughter]

.                 local p_value = 1-ttail(e(df_r), `p_value')

. 
.                 * (vi) number of observations
.                 local num_obs = e(N)

. 
.                 * (vii) number of participants
.                 quietly levelsof pid if e(sample), local(participants)

.                 local num_participants : word count `participants'

. 
.                 * (viii) interpretation of directionality
.                 scalar coef_d_daughter = _b[d_daughter]

.                 local interpretation "negative coefficient is in line with hy
> pothesis"

.                 
.                 * (iv) check that sample size does not fall below pre-specifi
> ed minimum 
.                 if `num_participants' < 1500 {
.                         local remark "DO NOT INTERPRET RESULTS SINCE EFFECTIV
> E SAMPLE SIZE IS BELOW PRE-SPECIFIED MINIMUM (1500)"
.                 } 

.                 else {
.                         local remark ""
.                 }

. 
.         // Display the saved statistics
.         di "Coefficient: `coefficient'"
Coefficient: -.2080121306650484

.         di "Standard Error: `se'"
Standard Error: .0809361954085314

.         di "Test Statistic Family: `test_stat_family'"
Test Statistic Family: t

.         di "Residual Degrees of Freedom: `df_residual'"
Residual Degrees of Freedom: 1013

.         di "Model Degrees of Freedom: `df_model'"
Model Degrees of Freedom: 10

.         di "p-value: " `p_value'
p-value: .00515481

.         di "Number of observations: " `num_obs'
Number of observations: 1771

.         di      "Number of participants: " `num_participants'
Number of participants: 1771

.         di "Interpretation of directionality: " "`interpretation'"
Interpretation of directionality: negative coefficient is in line with hypothes
> is

.         di "Remark: `remark'"
Remark: 

. 
.         * Export results to csv 
.         file open myfile using "$OUT/h2_results.csv", write replace
(file C:\Users\dalbrecht\Research
    Projects\ManyDaughters\ManyDaughters_DataPreprocessing/data/derived/5_res
    > ults/h2_results.csv not found)

.         file write myfile "coefficient,se,family,residual_df,model_df,p_value
> ,num_obs,num_participants,interpretation, remark" _n

.         file write myfile "`coefficient', `se', `test_stat_family', `df_resid
> ual', `df_model',`p_value',`num_obs',`num_participants',`interpretation',`rem
> ark'" _n

.         file close myfile

. 
. 
. *****************************************************************************
> ***
. 
. exit

end of do-file

. 
