          0 |      2,889       47.79       47.79
          1 |      3,156       52.21      100.00
------------+-----------------------------------
      Total |      6,045      100.00

. 
. * AgeD (age of oldest daughter)
. forvalues i = 1/19 {
  2.     local idx = string(`i', "%02.0f")
  3.     * Create temporary age variable for each daughter
.     gen age_temp`idx' = . 
  4.     replace age_temp`idx' = Wave - kidgeb`idx' ///
>         if kidsex`idx' == 2 & !missing(kidgeb`idx') & kidgeb`idx' < Wave
  5. }
