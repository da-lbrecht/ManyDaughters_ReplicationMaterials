  3.     forvalues i = 1/19 {
  4.         gen temp_age = `y' - kidgeb`=string(`i',"%02.0f")'
  5.         replace temp_age = . if kidsex`=string(`i',"%02.0f")' != 2
  6.         replace aged_`y' = cond(syear==`y', min(aged_`y', temp_age), aged_
> `y')
  7.         drop temp_age
  8.     }
  9.     replace aged_`y' = 0 if aged_`y' < 0
 10.     replace AgeD = aged_`y' if syear == `y'
 11.     drop aged_`y'
 12. }
