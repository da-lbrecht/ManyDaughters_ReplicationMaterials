  3.     forvalues i = 1/19 {
  4.         local kidyear = "kidgeb" + string(`i', "%02.0f")
  5.         quietly replace bk_`y' = bk_`y' + ///
>             ( `y' > `kidyear' & !missing(`kidyear') ) if syear == `y'
  6.     }
  7. }

. 
. forvalues y = 2000/2020 {
