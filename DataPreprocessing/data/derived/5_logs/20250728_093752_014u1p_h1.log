. * EXTRACT AND EXPORT RESULTS * 
. 
.         * Extract the required statistics
. 
. local i=1

. foreach reg in reg1 /*reg2 reg3 reg1b reg2b*/ reg3b {
  2.         
.         capture $`reg'
  3.         if _rc != 2000 & _rc != 2001 {
  4.             if `i'==1 {
  5.                 $`reg'
  6.                 }
  7.                 else {
  8.                 mi estimate, saving(results, replace): $`reg' 
  9.                 estimates use results
 10.                 }
 11.         * (i) coefficient estimate
.         local coefficient = _b[daughter]
 12. 
.         * (ii) standard error
.         local se = _se[daughter]
 13. 
.         * (iii) family of the test statistic (e.g. z, t, F, Chi²)
.         local test_stat_family = "t"
 14. 
.         * (iv) residual and model degrees of freedom (DFs) if applicable
.         local df_residual = e(df_r)
 15.         local df_model = e(df_m)
 16. 
.         * (v) p-value
.         local p_value = _b[daughter] / _se[daughter]
 17.         local p_value = 2 * ttail(e(df_r), abs(`p_value'))
 18. 
.         * (vi) number of observations
.         local num_obs = e(N)
 19. 
.         * (vii) number of participants
.         quietly levelsof pid if e(sample), local(participants)
 20.         local num_participants : word count `participants'
 21. 
.         * (viii) interpretation of directionality
.         local interpretation "positive coefficient is in line with hypothesis
> "
 22.         
. 
.         // Display the saved statistics
.         di "Coefficient: `coefficient'"
 23.         di "Standard Error: `se'"
 24.         di "Test Statistic Family: `test_stat_family'"
 25.         di "Residual Degrees of Freedom: `df_residual'"
 26.         di "Model Degrees of Freedom: `df_model'"
 27.         di "p-value: " `p_value'
 28.         di "Number of observations: " `num_obs'
 29.         di      "Number of participants: " `num_participants'
 30.         di "Interpretation of directionality: " "`interpretation'"
 31.         }
 32.                 
. * Export results to csv 
. capture $reg1
 33. if `i'==1 & _rc != 2000 & _rc != 2001 {
 34.         file open myfile using "$OUT/h1_results.csv", write replace
 35. }
 36. else {
 37.         file open myfile using "$OUT/h1_results.csv", write replace
 38. }
 39. file write myfile "coefficient,se,family,residual_df,model_df,p_value,num_
> obs,num_participants,interpretation" _n
 40. file write myfile "`coefficient', `se', `test_stat_family', `df_residual',
>  `df_model',`p_value',`num_obs',`num_participants',`interpretation'" _n
 41. file close myfile
 42.         
. local i=`i'+1
 43. }
