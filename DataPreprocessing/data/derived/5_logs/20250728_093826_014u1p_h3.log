. * HYPOTHESIS TEST FOR H3 * 
. 
. //having a daughter, parents are more likely to share the domestic and housew
> ork tasks equally between mothers and fathers within the same household
. //we analyze the change in the time share on domestic and housework before an
> d after having a child within the period of 2000 and 2020
. //we generate an index of time spend on domestic work for the respondent and 
> their partner, and then calculate the share for each partner
. //we run a OLS regression analysis with either share of domestic work as depe
> ndent variable as main independent variable as well as the dummy variable dau
> ghter, share of domestic work at baseline wave, and the dummy variable father
. //the second and third regressions of Model 1 are robustness checks, regressi
> ons of Model 2 are also robustness checks
. 
. gl CONTROLS1 "father edu1 edu2 edu3 edu4 edu5 child_age_t age_t year_bl year_
> t"

. gl CONTROLS2 "catholic protestant nonreligious migrant married hhincome_cap h
> gfhinc fulltime parttime workhours_cap workhours_miss disability"

. gl CONTROLS3 "birth_east siblings_female siblings_male"

. 
. gl reg1 "reg share_domesticwork_t daughter share_domesticwork_bl $CONTROLS1 i
> f exclusion==0 & syear==year_bl, cluster(hid)"

. gl reg2 "reg share_domesticwork_t daughter share_domesticwork_bl $CONTROLS1 $
> CONTROLS2 if exclusion==0 & syear==year_bl, cluster(hid)"

. gl reg3 "reg share_domesticwork_t daughter share_domesticwork_bl $CONTROLS1 $
> CONTROLS2 $CONTROLS3 if exclusion==0 & syear==year_bl, cluster(hid)"

. 
. gl reg4 "reg share_housework_t daughter share_housework_bl $CONTROLS1 if excl
> usion==0 & syear==year_bl, cluster(hid)"

. gl reg5 "reg share_housework_t daughter share_housework_bl $CONTROLS1 $CONTRO
> LS2 if exclusion==0 & syear==year_bl, cluster(hid)"

. gl reg6 "reg share_housework_t daughter share_housework_bl $CONTROLS1 $CONTRO
> LS2 $CONTROLS3 if exclusion==0 & syear==year_bl, cluster(hid)"

. 
. sum share_domesticwork_* share_housework_* $CONTROLS1 $CONTROLS2 $CONTROLS3 i
> f exclusion==0 & syear==year_bl

