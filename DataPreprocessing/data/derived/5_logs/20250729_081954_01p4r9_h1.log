  3.         }

.         tempvar rowtag

.         egen `rowtag' = rowtotal(tag_*)

.         replace h3_tag = 1 if `rowtag' > 0 // Tag respondents with at least o
> ne -2, -3 or -5 ('Does not apply', 'Implausible', 'Not included in this versi
> on of questionnaire') or missing in one of the pli0*
(300 real changes made)

