.         tempvar recode_plh0004

.         gen `recode_plh0004' = 10 - plh0004 // Original variable is recoded s
> o as to match the hypothesis (higher value = more leftist)
(273 missing values generated)

.         gen dep_var_h2 = (`recode_plh0004' - 0)/(10 - 0) // Normalized score 
> between 0 and 1    
(273 missing values generated)

.         
.         
.         * Dependent variable for H3: Share of women-specific stereotypical ac
> tivities done by men within the household
.         tempvar h_gender_typical_activities h_gender_typical_activities_hh sh
> are_gender_typical_activities

.         egen `h_gender_typical_activities' = rowtotal(pli0*) // Total hours d
> eclared on women-specific stereotypical activities at the individual level   
