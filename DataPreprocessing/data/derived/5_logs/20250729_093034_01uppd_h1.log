. * Calculate age
. gen age = syear - gebjahr

. 
. * Keep only 2018 respondents age 18+
. keep if age >= 18 & syear == 2018
(33,222 observations deleted)

. 
. * Drop observations with missing values on key attitude items and family stat
> us
. drop if missing(plh0357, plh0298_v2, plh0302_v2, plh0308_v2, plh0359, plh0360
> , age, pgbilzeit, hghinc, pgemplst, pgfamstd, migback)
(505 observations deleted)

