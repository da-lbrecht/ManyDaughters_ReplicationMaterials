. *---------------------------------------------------*
. * 2. Capture common stats
. *---------------------------------------------------*
. local df_residual = e(df_r)

. local df_model    = e(df_m)

. local num_obs     = e(N)

. quietly levelsof pid if e(sample), local(pids)

. local num_participants : word count `pids'

. 
. *---------------------------------------------------*
. * 3. Extract for each variable
. *---------------------------------------------------*
. foreach var in d_daughter d_daughter_female {
  2.     * (i) coefficient
.     local coef_`var' = _b[`var']
  3.     * (ii) standard error
.     local se_`var'   = _se[`var']
  4.     * (iii) t‑statistic
.     local t_`var'    = `coef_`var'' / `se_`var''
  5.     * (v) p‑value
.     local p_`var'    = 2 * ttail(`df_residual', abs(`t_`var''))
  6. 
.     * test family
.     local test_stat_family = "t"
  7. 
.     * (viii) interpretation ONLY for the interaction
.     local int_`var' = "negative coefficient is in line with hypothesis"
  8. }

. 
. 
. *---------------------------------------------------*
. * 4. Display on screen (now showing t‑stat)
. *---------------------------------------------------*
. di as txt "Variable           Coef.      SE       t‑stat     p‑value    Inter
> pretation"
Variable           Coef.      SE       t‑stat     p‑value    Interpretation

. foreach var in d_daughter d_daughter_female {
  2.     di as result ///
>         "`var'        " %9.4f `coef_`var''    "  " ///
>         %7.4f `se_`var''    "  " ///
>         %7.4f `t_`var''     "  " ///
>         %7.4f `p_`var''     "  " ///
>         "`int_`var''"
  3. }
d_daughter           0.0111   0.2200   0.0502   0.9600  negative coefficient is
>  in line with hypothesis
d_daughter_female           0.3023   0.2435   1.2417   0.2154  negative coeffic
> ient is in line with hypothesis

. 
. *---------------------------------------------------*
. * 5. Export to CSV (use t_stat instead of family)
. *---------------------------------------------------*
. file open myfile using "$OUT/h4_results.csv", write replace
(file C:\Users\dalbrecht\Research
    Projects\ManyDaughters\ManyDaughters_DataPreprocessing/data/derived/5_res
    > ults/h4_results.csv not found)

. file write myfile ///
>     "coefficient,se,family,residual_df,model_df,p_value,num_obs,num_participa
> nts,interpretation" _n

. 
. foreach var in /*d_daughter*/ d_daughter_female {
  2.     file write myfile ///
>         "`coef_`var'',`se_`var'',`test_stat_family',`df_residual',`df_model',
> `p_`var'',`num_obs',`num_participants',`int_`var''" _n
  3. }

. 
. file close myfile

. 
. exit

