. /** OLD **
> * HYPOTHESIS TEST FOR H3 * 
>         
>         /* We consider the male partner's share in domestic work as a good me
> asure for gender equality in the household. We use three sets of variables de
> noting hours spent in childcare, housework, and repair work, respectively, du
> ring weekdays (pli0044_h, pli0043_h, pli0049_h), Saturdays (pli0019_h, pli001
> 2_h, pli0031_h), and Sundays (pli0022_h, pli0016_h, pli0034_v4). We add the h
> ours spent in the three domains together and calculate for each household the
>  male partner's share, ranging from 0 to 100: A higher share indicates more g
> ender equality in HH. We calculate the share for weekdays, Saturdays, and Sun
> days separately, as information for Saturdays and Sundays is not available in
>  some years, while information for weekdays is available each year from 2000 
> to 2020. Therefore, we obtain three dependent variables.
>         
>         We run both random effects and fixed effects linear regresion analysi
> s with plh0004 as dependent variable, applying robust standard errors. Our in
> dependent variable kidsex_all has three categories denoting whether having bi
> ological daughters in the survey year: `No daughter', `Only daughter(s), and 
> `Mixed'. 
>         
>         We also include the following control variables: gender, age group, e
> ducation, employment status, net household income, marital status, number of 
> biological children, whether youngest biological child <= 3 years, region (We
> st or East Germany), and migration background. For fixed effects models, gend
> er and migraiton background as time-invariant variables are excluded.
>         */
>         
>         * Run analysis at household level
>         //Only keep male partner in HH to account for his socio-demographics
>         keep if sex == 1
>         
>         xtset pid syear
>         
>         //1. random effects model
>         local c = 1
>         foreach v of varlist domstcwd_rt domstcsat_rt domstcsun_rt {
>                 xtreg `v' i.kidsex_all i.age_gr i.educ_3cat i.emplst_4cat i.h
> inc_5cat i.sumkids_4cat i.youngest0to3_d i.sampreg i.migback, re vce(r)
>                 
>                 * Extract the required statistics
>                 
>         * (i) coefficient estimates
>                 local coefficient_onlyd_re`c' = _b[1.kidsex_all]
>                 local coefficient_mixed_re`c' = _b[2.kidsex_all]
> 
>                 * (ii) robust standard errors
>                 local se_onlyd_re`c' = _se[1.kidsex_all]
>                 local se_mixed_re`c' = _se[2.kidsex_all]
>                 
>                 * (iii) family of the test statistic (e.g. z, t, F, Chi²)
>                 local test_stat_family_re = "z"
> 
>                 * (iv) residual and model degrees of freedom (DFs) if applica
> ble
>                 local df_residual_re`c' = e(df_r)
>                 local df_model_re`c' = e(df_m)
> 
>                 * (v) p-value
>                 local p_value_onlyd_re`c' = _b[1.kidsex_all] / _se[1.kidsex_a
> ll]
>                 local p_value_onlyd_re`c' = 2 * (1 - normal(abs(`p_value_only
> d_re`c'')))
>                 
>                 local p_value_mixed_re`c' = _b[2.kidsex_all] / _se[2.kidsex_a
> ll]
>                 local p_value_mixed_re`c' = 2 * (1 - normal(abs(`p_value_mixe
> d_re`c'')))
> 
>                 * (vi) number of observations
>                 local num_obs_re`c' = e(N)
> 
>                 * (vii) number of participants
>                 quietly levelsof pid if e(sample), local(participants)
>                 local num_participants_re`c' : word count `participants'
> 
>                 * (viii) interpretation of results
>                 scalar coef_1kidsex_all_re`c' = _b[1.kidsex_all]
>                 scalar coef_2kidsex_all_re`c' = _b[2.kidsex_all]
>                 scalar p_value_1kidsex_all_re`c' = 2 * (1 - normal(abs(_b[1.k
> idsex_all] / _se[1.kidsex_all])))
>                 scalar p_value_2kidsex_all_re`c' = 2 * (1 - normal(abs(_b[2.k
> idsex_all] / _se[2.kidsex_all])))
> 
>                 if coef_1kidsex_all_re`c' > .1 & p_value_1kidsex_all_re`c' < 
> .05 {
>                         local interpretation_onlyd_re`c' "in line with hypoth
> esis"
>                 } 
>                 else {
>                         local interpretation_onlyd_re`c' "not in line with hy
> pothesis"
>                 }
>                 
>                 if coef_2kidsex_all_re`c' > .1 & p_value_2kidsex_all_re`c' < 
> .05 {
>                         local interpretation_mixed_re`c' "in line with hypoth
> esis"
>                 } 
>                 else {
>                         local interpretation_mixed_re`c' "not in line with hy
> pothesis"
>                 
>                 }
>         
>         // Display the saved statistics
>         di "Coefficient: `coefficient_onlyd_re`c''"
>         di "Standard Error: `se_onlyd_re`c''"
>         di "Coefficient: `coefficient_mixed_re`c''"
>         di "Standard Error: `se_mixed_re`c''"
>         di "Test Statistic Family: `test_stat_family_re'"
>         di "Residual Degrees of Freedom: `df_residual_re`c''"
>         di "Model Degrees of Freedom: `df_model_re`c''"
>         di "p-value: " `p_value_onlyd_re`c''
>         di "p-value: " `p_value_mixed_re`c''
>         di "Number of observations: " `num_obs_re`c''
>         di      "Number of participants: " `num_participants_re`c''
>         di "Interpretation of results: " "`interpretation_onlyd_re`c''"
>         di "Interpretation of results: " "`interpretation_mixed_re`c''"
>         
>         local c = `c'+1         
>         }
> 
>         //2. fixed effects model
>         local c = 1
>         foreach v of varlist domstcwd_rt domstcsat_rt domstcsun_rt {
>                 xtreg `v' i.kidsex_all i.age_gr i.educ_3cat i.emplst_4cat i.h
> inc_5cat i.sumkids_4cat i.youngest0to3_d i.sampreg, fe vce(r)
>                 
>                 * Extract the required statistics
>                 
>         * (i) coefficient estimates
>                 local coefficient_onlyd_fe`c' = _b[1.kidsex_all]
>                 local coefficient_mixed_fe`c' = _b[2.kidsex_all]
> 
>                 * (ii) robust standard errors
>                 local se_onlyd_fe`c' = _se[1.kidsex_all]
>                 local se_mixed_fe`c' = _se[2.kidsex_all]
>                 
>                 * (iii) family of the test statistic (e.g. z, t, F, Chi²)
>                 local test_stat_family_fe = "t"
> 
>                 * (iv) residual and model degrees of freedom (DFs) if applica
> ble
>                 local df_residual_fe`c' = e(df_r)
>                 local df_model_fe`c' = e(df_m)
> 
>                 * (v) p-value
>                 local p_value_onlyd_fe`c' = _b[1.kidsex_all] / _se[1.kidsex_a
> ll]
>                 local p_value_onlyd_fe`c' = 2 * ttail(e(df_r), abs(`p_value_o
> nlyd_fe`c''))
>                 
>                 local p_value_mixed_fe`c' = _b[2.kidsex_all] / _se[2.kidsex_a
> ll]
>                 local p_value_mixed_fe`c' = 2 * ttail(e(df_r), abs(`p_value_m
> ixed_fe`c''))
> 
>                 * (vi) number of observations
>                 local num_obs_fe`c' = e(N)
> 
>                 * (vii) number of participants
>                 quietly levelsof pid if e(sample), local(participants)
>                 local num_participants_fe`c' : word count `participants'
> 
>                 * (viii) interpretation of directionality
>                 scalar coef_1kidsex_all_fe`c' = _b[1.kidsex_all]
>                 scalar coef_2kidsex_all_fe`c' = _b[2.kidsex_all]
>                 scalar p_value_1kidsex_all_fe`c' = 2 * ttail(e(df_r), abs(_b[
> 1.kidsex_all] / _se[1.kidsex_all]))
>                 scalar p_value_2kidsex_all_fe`c' = 2 * ttail(e(df_r), abs(_b[
> 2.kidsex_all] / _se[2.kidsex_all]))
> 
>                 if coef_1kidsex_all_fe`c' > 0 & p_value_1kidsex_all_fe`c' <.0
> 5 {
>                         local interpretation_onlyd_fe`c' "in line with hypoth
> esis"
>                 } 
>                 else {
>                         local interpretation_onlyd_fe`c' "not in line with hy
> pothesis"
>                 }
>                 
>                 if coef_2kidsex_all_fe`c' > 0 & p_value_2kidsex_all_fe`c' <.0
> 5 {
>                         local interpretation_mixed_fe`c' "in line with hypoth
> esis"
>                 } 
>                 else {
>                         local interpretation_mixed_fe`c' "not in line with hy
> pothesis"
>                 
>                 }
>         
>         // Display the saved statistics
>         di "Coefficient: `coefficient_onlyd_fe`c''"
>         di "Standard Error: `se_onlyd_fe`c''"
>         di "Coefficient: `coefficient_mixed_fe`c''"
>         di "Standard Error: `se_mixed_fe`c''"
>         di "Test Statistic Family: `test_stat_family_fe'"
>         di "Residual Degrees of Freedom: `df_residual_fe`c''"
>         di "Model Degrees of Freedom: `df_model_fe`c''"
>         di "p-value: " `p_value_onlyd_fe`c''
>         di "p-value: " `p_value_mixed_fe`c''
>         di "Number of observations: " `num_obs_fe`c''
>         di      "Number of participants: " `num_participants_fe`c''
>         di "Interpretation of results: " "`interpretation_onlyd_fe`c''"
>         di "Interpretation of results: " "`interpretation_mixed_fe`c''"
>         
>         local c = `c'+1         
>         }
