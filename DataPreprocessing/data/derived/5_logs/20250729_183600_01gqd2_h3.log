. * GENERATE VARIABLES * 
.     
.         /** OLD **
>         ** Male partner's share in domestic work as measure of gender equalit
> y in HH
>         //share on weedays, saturdays and sundays separately due to data avai
> lability
>         
>         sort hid syear pid
>         
>         // Weekdays
>         tab1 pli0044_h pli0043_h pli0049_h //childcare, housework, repair wor
> k
>         foreach v of varlist pli0044_h pli0043_h pli0049_h {
>                 replace `v' = . if `v' <0 & `v' != -2 //recoding missings
>                 replace `v' = 0 if `v' == -2 //0 hours when does not apply
>         }
>         gen domstcwd_sf = pli0044_h + pli0043_h + pli0049_h
>         tab domstcwd_sf
>         
>         * partners work
>         gen domstcwd_pt = domstcwd_sf[_n+1] if parid == pid[_n+1] & syear == 
> syear[_n+1]
>         replace domstcwd_pt = domstcwd_sf[_n-1] if parid == pid[_n-1] & syear
>  == syear[_n-1] 
>         tab domstcwd_pt
>         
>         * male partner's share
>         gen domstcwd_rt = domstcwd_sf/(domstcwd_sf + domstcwd_pt)*100 if sex 
> == 1 //for men
>         replace domstcwd_rt = domstcwd_pt/(domstcwd_sf + domstcwd_pt)*100 if 
> sex == 2 //for women
>         tab domstcwd_rt
>         
>         // Saturdays
>         tab1 pli0019_h pli0012_h pli0031_h //childcare, housework, repair wor
> k
>         foreach v of varlist pli0019_h pli0012_h pli0031_h {
>                 replace `v' = . if `v' <0 & `v' != -2 //recoding missings
>                 replace `v' = 0 if `v' == -2 //0 hours when does not apply
>         }
>         gen domstcsat_sf = pli0019_h + pli0012_h + pli0031_h
>         
>         * partners work
>         gen domstcsat_pt = domstcsat_sf[_n+1] if parid == pid[_n+1] & syear =
> = syear[_n+1]
>         replace domstcsat_pt = domstcsat_sf[_n-1] if parid == pid[_n-1] & sye
> ar == syear[_n-1]
>         
>         * male partner's share
>         gen domstcsat_rt = domstcsat_sf/(domstcsat_sf + domstcsat_pt)*100 if 
> sex == 1 //for men
>         replace domstcsat_rt = domstcsat_pt/(domstcsat_sf + domstcsat_pt)*100
>  if sex == 2 //for women
>         
>         // Sundays
>         tab1 pli0022_h pli0016_h pli0034_v4 //childcare, housework, repair wo
> rk
>         foreach v of varlist pli0022_h pli0016_h pli0034_v4 {
>                 replace `v' = . if `v' <0 & `v' != -2 //recoding missings
>                 replace `v' = 0 if `v' == -2 //0 hours when does not apply
>         }
>         gen domstcsun_sf = pli0022_h + pli0016_h + pli0034_v4
>         
>         * partners work
>         gen domstcsun_pt = domstcsun_sf[_n+1] if parid == pid[_n+1] & syear =
> = syear[_n+1]
>         replace domstcsun_pt = domstcsun_sf[_n-1] if parid == pid[_n-1] & sye
> ar == syear[_n-1]
>         tab domstcsun_pt, m
