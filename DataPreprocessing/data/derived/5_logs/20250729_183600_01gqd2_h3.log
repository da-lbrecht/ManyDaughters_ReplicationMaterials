> * EXPORT RESULTS * 
> 
>         * Export results to csv 
>         local x1 "Male partner's share in domest. work: Workdays"
>         local x2 "Male partner's share in domest. work: Saturdays"
>         local x3 "Male partner's share in domest. work: Sundays" 
>         
>         file open myfile using "$OUT/h3_results.csv", write replace
>     file write myfile " , coefficient,r_se,family,residual_df,model_df,p_valu
> e,num_obs,num_participants,interpretation" _n
>         forvalues c=1/3 {
>                 file write myfile "`x`c''" _n
>                 file write myfile "RE model" _n
>             file write myfile "only daugthers, `coefficient_onlyd_re`c'', `se
> _onlyd_re`c'', `test_stat_family_re', `df_residual_re`c'', `df_model_re`c'',`
> p_value_onlyd_re`c'',`num_obs_re`c'',`num_participants_re`c'',`interpretation
> _onlyd_re`c''" _n
>             file write myfile "mixed, `coefficient_mixed_re`c'', `se_mixed_re
> `c'', `test_stat_family_re', `df_residual_re`c'', `df_model_re`c'',`p_value_m
> ixed_re`c'',`num_obs_re`c'',`num_participants_re`c'',`interpretation_mixed_re
> `c''" _n
>                 
>                 file write myfile "FE model" _n
>             file write myfile "only daugthers, `coefficient_onlyd_fe`c'', `se
> _onlyd_fe`c'', `test_stat_family_fe', `df_residual_fe`c'', `df_model_fe`c'',`
> p_value_onlyd_fe`c'',`num_obs_fe`c'',`num_participants_fe`c'',`interpretation
> _onlyd_fe`c''" _n
