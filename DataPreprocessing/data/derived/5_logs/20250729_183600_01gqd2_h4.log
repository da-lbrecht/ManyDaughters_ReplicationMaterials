. /** OLD **      
> * HYPOTHESIS TEST FOR H4 * 
> 
>         /* We consider attitudes towards the following three statements as go
> od measures of support for gender equality: 1) Children below the age of 6 su
> ffer if their mother works (plh0298_v2); 2) Children below the age of 3 suffe
> r if their mother works (plh0302_v2); 3) Best if man and woman work the same 
> amount so they can share the responsibility (plh0308_v2). We reverse the dire
> ction of the first two variables (plh0298_v2_r and plh0302_v2_r) so that for 
> all three variables (ranging from 1 to 7): the higher the value, the stronger
>  the support for gender equality. 
>         
>         The three dependent variables are only availabe in 2018 (The first tw
> o variables and a similar version of the third variable were also surveyed in
>  2012 but on a much smaller, completely different group of participants.). Th
> erefore, we run linear OLS regresion analysis for each dependent variable, ap
> plying sampling weights (phrf) and standard errors at the household level. Ou
> r independent variable kidsex_all has three categories denoting whether havin
> g biological daughters in the survey year: `No daughter', `Only daughter(s), 
> and `Mixed'. We interact kidsex_all with sex (female or male) to test whether
>  having daughters leads to a larger increase in the support of gender equalit
> y for men than for women.
>         
>         We also include the following control variables: gender, age group, e
> ducation, employment status, net household income, marital status, number of 
> biological children, whether youngest biological child <= 3 years, region (We
> st or East Germany), and migration background.
>         */
> 
> local c = 1
>         foreach v of varlist plh0298_v2_r plh0302_v2_r plh0308_v2 {
>                 reg `v' i.kidsex_all##ib2.sex i.age_gr i.educ_3cat i.emplst_4
> cat i.hinc_5cat i.famstd_3cat i.sumkids_4cat i.youngest0to3_d i.sampreg i.mig
> back [pw=phrf], vce(cluster hid)
>                 
>                 * Extract the required statistics
>                 
>         * (i) coefficient estimates
>                 local coefficient_onlyd`c' = _b[1.kidsex_all]
>                 local coefficient_mixed`c' = _b[2.kidsex_all]
>                 
>                 local coefficient_onlyd`c'_male = _b[1.kidsex_all#1.sex]
>                 local coefficient_mixed`c'_male = _b[2.kidsex_all#1.sex]
>                 
>                 local coefficient_male`c' = _b[1.sex]
> 
>                 * (ii) standard errors
>                 local se_onlyd`c' = _se[1.kidsex_all]
>                 local se_mixed`c' = _se[2.kidsex_all]
>                 
>                 local se_onlyd`c'_male = _se[1.kidsex_all#1.sex]
>             local se_mixed`c'_male = _se[2.kidsex_all#1.sex]
>                 
>                 local se_male`c' = _se[1.sex]
>                 
>                 * (iii) family of the test statistic (e.g. z, t, F, Chi²)
>                 local test_stat_family = "t"
> 
>                 * (iv) residual and model degrees of freedom (DFs) if applica
> ble
>                 local df_residual`c' = e(df_r)
>                 local df_model`c' = e(df_m)
> 
>                 * (v) p-value
>                 local p_value_onlyd`c' = _b[1.kidsex_all] / _se[1.kidsex_all]
>                 local p_value_onlyd`c' = 2 * ttail(e(df_r), abs(`p_value_only
> d`c''))
>                 
>                 local p_value_mixed`c' = _b[2.kidsex_all] / _se[2.kidsex_all]
>                 local p_value_mixed`c' = 2 * ttail(e(df_r), abs(`p_value_mixe
> d`c''))            
>                 
>                 local p_value_onlyd`c'_male = _b[1.kidsex_all#1.sex] / _se[1.
> kidsex_all#1.sex]
>                 local p_value_onlyd`c'_male = 2 * ttail(e(df_r), abs(`p_value
> _onlyd`c'_male'))
>                 
>                 local p_value_mixed`c'_male = _b[2.kidsex_all#1.sex] / _se[2.
> kidsex_all#1.sex]
>                 local p_value_mixed`c'_male = 2 * ttail(e(df_r), abs(`p_value
> _mixed`c'_male'))
>                 
>                 local p_value_male`c' = _b[1.sex] / _se[1.sex]
>                 local p_value_male`c' = 2 * ttail(e(df_r), abs(`p_value_male`
> c''))
> 
>                 * (vi) number of observations
>                 local num_obs`c' = e(N)
> 
>                 * (vii) number of participants
>                 quietly levelsof pid if e(sample), local(participants)
>                 local num_participants`c' : word count `participants'
> 
>                 * (viii) interpretation of results 
>                 scalar coef_1kidsex_all`c'_male = _b[1.kidsex_all#1.sex]
>                 scalar coef_2kidsex_all`c'_male = _b[2.kidsex_all#1.sex]
>                 scalar p_value_1kidsex_all`c'_male = 2 * ttail(e(df_r), abs(_
> b[1.kidsex_all#1.sex] / _se[1.kidsex_all#1.sex]))
>                 scalar p_value_2kidsex_all`c'_male = 2 * ttail(e(df_r), abs(_
> b[2.kidsex_all#2.sex] / _se[2.kidsex_all#2.sex]))
>                 
>                 if coef_1kidsex_all`c'_male > 0 & p_value_1kidsex_all`c'_male
>  < .05 {
>                         local interpretation_onlyd`c'_male "in line with hypo
> thesis"
>                 } 
>                 else {
>                         local interpretation_onlyd`c'_male "not in line with 
> hypothesis"
>                 }
>                 
>                 if coef_2kidsex_all`c'_male > 0 & p_value_2kidsex_all`c'_male
>  < .05 {
>                         local interpretation_mixed`c'_male "in line with hypo
> thesis"
>                 } 
>                 else {
>                         local interpretation_mixed`c'_male "not in line with 
> hypothesis"
>                 }
> 
>         // Display the saved statistics
>         di "Coefficient: `coefficient_onlyd`c''"
>         di "Standard Error: `se_onlyd`c''"
>         di "Coefficient: `coefficient_mixed`c''"
>         di "Standard Error: `se_mixed`c''"
>         di "Coefficient: `coefficient_onlyd`c'_male'"
>         di "Standard Error: `se_onlyd`c'_male'"
>         di "Coefficient: `coefficient_mixed`c'_male'"
>         di "Standard Error: `se_mixed`c'_male'"
>         di "Coefficient: `coefficient_male`c''"
>         di "Standard Error: `se_male`c''"
>         di "Test Statistic Family: `test_stat_family'"
>         di "Residual Degrees of Freedom: `df_residual`c''"
>         di "Model Degrees of Freedom: `df_model`c''"
>         di "p-value: " `p_value_onlyd`c''
>         di "p-value: " `p_value_mixed`c''
>         di "p-value: " `p_value_onlyd`c'_male'
>         di "p-value: " `p_value_mixed`c'_male'
>         di "p-value: " `p_value_male`c''
>         di "p-value: " `p_value_male`c''
>         di "Number of observations: " `num_obs`c''
>         di      "Number of participants: " `num_participants`c''
>         di "Interpretation of results: " "`interpretation_onlyd`c'_male'"
>         di "Interpretation of results: " "`interpretation_mixed`c'_male'"
>         
>         local c = `c'+1 
>         }
> 
>         
> * EXPORT RESULTS * 
> 
>         * Export results to csv 
>         local x1 "Child under 6 NOT suffer when mother works"
>         local x2 "Child under 3 NOT suffer when mother works"
>         local x3 "Best if man and woman work same amount to share responsibil
> ity"       
>         
>         file open myfile using "$OUT/h4_results.csv", write replace
>     file write myfile " , coefficient,se,family,residual_df,model_df,p_value,
> num_obs,num_participants,interpretation" _n
>         forvalues c=1/3 {
>                 file write myfile "`x`c''" _n
>             file write myfile "only daugthers, `coefficient_onlyd`c'', `se_on
> lyd`c'', `test_stat_family', `df_residual`c'', `df_model`c'',`p_value_onlyd`c
> '',`num_obs`c'',`num_participants`c'',`interpretation_onlyd`c''" _n
>             file write myfile "mixed, `coefficient_mixed`c'', `se_mixed`c'', 
> `test_stat_family', `df_residual`c'', `df_model`c'',`p_value_mixed`c'',`num_o
> bs`c'',`num_participants`c'',`interpretation_mixed`c''" _n
>             file write myfile "male, `coefficient_male`c'', `se_male`c'', `te
> st_stat_family', `df_residual`c'', `df_model`c'',`p_value_male`c'',`num_obs`c
> '',`num_participants`c'',`interpretation_male`c''" _n
>                 file write myfile "only daugthers # male, `coefficient_onlyd`
> c'_male', `se_onlyd`c'_male', `test_stat_family', `df_residual`c'', `df_model
> `c'',`p_value_onlyd`c'_male',`num_obs`c'',`num_participants`c'',`interpretati
> on_onlyd`c'_male'" _n
>             file write myfile "mixed # male, `coefficient_mixed`c'_male', `se
> _mixed`c'_male', `test_stat_family', `df_residual`c'', `df_model`c'',`p_value
> _mixed`c'_male',`num_obs`c'',`num_participants`c'',`interpretation_mixed`c'_m
> ale'" _n
>                 
>         }
> 
>         file close myfile
> */
