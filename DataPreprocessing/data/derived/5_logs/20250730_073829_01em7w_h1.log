. * GENERATE VARIABLES * (Please adapt according to your needs)
. 
.         * Count number of children and daughters born before or during the su
> rvey year
.         gen num_children = 0

.         gen num_daughters = 0

. 
.         forvalues i = 1/19 {
  2.                 local idx : display %02.0f `i'
  3.                 
.                 gen child_born_`i' = (kidgeb`idx' <= syear & kidgeb`idx' > 0)
  4.                 gen is_daughter_`i' = (child_born_`i' == 1 & kidsex`idx' =
> = 2)
  5. 
.                 replace num_children = num_children + child_born_`i'
  6.                 replace num_daughters = num_daughters + is_daughter_`i'
  7.         }
