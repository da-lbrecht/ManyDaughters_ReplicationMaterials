. * FILTERS * (Please adapt according to your needs)
. 
.     * Keep only relevant variables
.     keep kidgeb01-kidgeb19 kidsex01-kidsex19 sumkids cid pid syear sex psampl
> e ///
>          gebjahr germborn sampreg partner hghinc pgbilzeit plh0004

. 
.     * Drop if no biological kids ever
.     drop if kidsex01 <= 0
(10,637 observations deleted)

. 
. 
. * GENERATE VARIABLES * (Please adapt according to your needs)
. 
.     * Left-Right political scale (DV)
.     gen lrscale = plh0004
(3,718 missing values generated)

.     replace lrscale = . if lrscale < 0
(17,373 real changes made, 17,373 to missing)

. 
.     * First child female dummy (treatment group)
.     gen first_child_female = .
(24,591 missing values generated)

.     replace first_child_female = 1 if kidsex01 == 2 & !missing(kidsex01)
(11,310 real changes made)

.     replace first_child_female = 0 if kidsex01 == 1 & !missing(kidsex01)
(13,281 real changes made)

. 
.     * Post indicator (treatment timing)
.     gen post = .
(24,591 missing values generated)

.     replace post = 1 if syear >= kidgeb01 & !missing(kidgeb01)
(23,631 real changes made)

.     replace post = 0 if syear < kidgeb01 & kidgeb01 > 1900 & !missing(kidgeb0
> 1)
(960 real changes made)

. 
.     * Control variables
.     replace sex = 0 if sex == 1
(11,108 real changes made)

.     replace sex = 1 if sex == 2
(13,483 real changes made)

. 
.     replace germborn = 0 if germborn == 1
(19,472 real changes made)

.     replace germborn = 1 if germborn == 2
(5,119 real changes made)

. 
.     rename sampreg westgerm

.     replace westgerm = . if westgerm <= 0
(27 real changes made, 27 to missing)

.     replace westgerm = 0 if westgerm == 2
(5,703 real changes made)

. 
.     replace partner = . if partner < 0 | partner == 5
(75 real changes made, 75 to missing)

.     replace partner = 1 if partner != 0
(2,328 real changes made)

. 
.     replace pgbilzeit = . if pgbilzeit < 0
(315 real changes made, 315 to missing)

. 
.     gen age = syear - gebjahr

.     gen age_sq = age^2

. 
.     gen ln_hghinc = log(hghinc)
(3,862 missing values generated)

.         
.         * Dummies for number of kids
.         forvalues k = 0/7 {
  2.                 gen kids_`k' = .
  3.                 replace kids_`k' = 1 if sumkids == `k'
