  variable kidgeb14 was double now byte
  variable kidgeb15 was double now byte
  variable kidgeb16 was double now byte
  variable kidgeb17 was double now byte
  variable kidgeb18 was double now byte
  variable kidgeb19 was double now byte
  variable kidsex01 was double now byte
  variable kidsex02 was double now byte
  variable kidsex03 was double now byte
  variable kidsex04 was double now byte
  variable kidsex05 was double now byte
  variable kidsex06 was double now byte
  variable kidsex07 was double now byte
  variable kidsex08 was double now byte
  variable kidsex09 was double now byte
  variable kidsex10 was double now byte
  variable kidsex11 was double now byte
  variable kidsex12 was double now byte
  variable kidsex13 was double now byte
  variable kidsex14 was double now byte
  variable kidsex15 was double now byte
  variable kidsex16 was double now byte
  variable kidsex17 was double now byte
  variable kidsex18 was double now byte
  variable kidsex19 was double now byte
  (7,426,482 bytes saved)

. save "$DATA/hypotheses-dataset.dta", replace // save merged dataset
(file C:\Users\dalbrecht\Research
    Projects\ManyDaughters\ManyDaughters_DataPreprocessing/data/derived_confi
    > dential/5%-sample/hypotheses-dataset.dta not found)
file C:\Users\dalbrecht\Research
    Projects\ManyDaughters\ManyDaughters_DataPreprocessing/data/derived_confi
    > dential/5%-sample/hypotheses-dataset.dta saved

. 
. *****************************************************************************
> ***
.                                 /* Create and recode variables for H1-H4  */
. *****************************************************************************
> ***
. 
. 
. * Generate age
. gen age = syear - gebjahr

. 
. ** First child is a girl
. 
. gen first_daughter = kidsex01 == 2 if inlist(kidsex01, 1, 2)

. rename kidgeb01 first_byear

.         
. 
. 
. ** H2: left-leaning political preferences **
. gen polattitude = plh0004
(3,718 missing values generated)

. replace polattitude = . if inlist(plh0004, -8, -5, -1)
(17,373 real changes made, 17,373 to missing)

. 
. gen sample_h2 = inlist(first_byear, 2004, 2008, 2013, 2018)

. 
. preserve

. keep if sample_h2 == 1
(23,264 observations deleted)

. 
. replace polattitude = . if syear != first_byear + 1
(140 real changes made, 140 to missing)

. 
. save "$DATA/h2_dataset.dta", replace
file C:\Users\dalbrecht\Research
    Projects\ManyDaughters\ManyDaughters_DataPreprocessing/data/derived_confi
    > dential/5%-sample/h2_dataset.dta saved

. 
. 
. *****************************************************************************
> ***
.  /*  H2: Having daughters leads to more left-leaning political preferences.  
> */
. *****************************************************************************
> ***
. 
. * Authors: [REDACTED], [REDACTED] (based on example code)
. 
. use "$DATA/h2_dataset.dta", clear

. 
. 
. * ============================
. * Analysis
. * ============================
. 
. 
. * HYPOTHESIS TEST FOR H2 *
. 
.         /* We regress political attitudes (0: entirely left, 10: entirely rig
> ht, 
>         measured in the year after the first child was born) on the first chi
> ld 
>         being a girl, age of the parent and survey year.  We cluster the stan
> dard 
>         errors on the household level. */
. 
.         reg polattitude i.first_daughter age i.syear, cluster(hid)

Linear regression                               Number of obs     =         43
                                                F(5, 25)          =       7.19
                                                Prob > F          =     0.0003
                                                R-squared         =     0.2884
                                                Root MSE          =       1.79

                                   (Std. err. adjusted for 26 clusters in hid)
------------------------------------------------------------------------------
             |               Robust
 polattitude | Coefficient  std. err.      t    P>|t|     [95% conf. interval]
-------------+----------------------------------------------------------------
1.first_da~r |  -1.069976    .571127    -1.87   0.073    -2.246234    .1062823
         age |  -.0667701   .0709417    -0.94   0.356    -.2128773     .079337
             |
       syear |
       2009  |  -1.137841   .9978004    -1.14   0.265    -3.192849    .9171671
       2014  |  -2.645186   1.029363    -2.57   0.017    -4.765198    -.525173
       2019  |  -2.256968   1.137697    -1.98   0.058      -4.6001    .0861633
             |
       _cons |   9.091256    2.06717     4.40   0.000      4.83384    13.34867
------------------------------------------------------------------------------

. 
. 
. * EXTRACT AND EXPORT RESULTS *
. 
.         * Extract the required statistics
. 
.                 * (i) coefficient estimate
.                 local coefficient = _b[1.first_daughter]

. 
.                 * (ii) standard error
.                 local se = _se[1.first_daughter]

. 
.                 * (iii) family of the test statistic (e.g. z, t, F, Chi²)
.                 local test_stat_family = "t"

. 
.                 * (iv) residual and model degrees of freedom (DFs) if applica
> ble
.                 local df_residual = e(df_r)

.                 local df_model = e(df_m)

. 
.                 * (v) p-value
.                 local p_value = _b[1.first_daughter] / _se[1.first_daughter]

.                 local p_value = 2 * ttail(e(df_r), abs(`p_value'))

. 
.                 * (vi) number of observations
.                 local num_obs = e(N)

. 
.                 * (vii) number of participants
.                 quietly levelsof pid if e(sample), local(participants)

.                 local num_participants : word count `participants'

. 
.                 * (viii) interpretation of directionality
.                 scalar coef_first_daughter = _b[1.first_daughter]

.                 local interpretation "negative coefficient is in line with hy
> pothesis"

. 
.         // Display the saved statistics
.         di "Coefficient: `coefficient'"
Coefficient: -1.069975843331089

.         di "Standard Error: `se'"
Standard Error: .5711270291781704

.         di "Test Statistic Family: `test_stat_family'"
Test Statistic Family: t

.         di "Residual Degrees of Freedom: `df_residual'"
Residual Degrees of Freedom: 25

.         di "Model Degrees of Freedom: `df_model'"
Model Degrees of Freedom: 5

.         di "p-value: " `p_value'
p-value: .07274343

.         di "Number of observations: " `num_obs'
Number of observations: 43

.         di      "Number of participants: " `num_participants'
Number of participants: 43

.         di "Interpretation of directionality: " "`interpretation'"
Interpretation of directionality: negative coefficient is in line with hypothes
> is

. 
.         * Export results to csv 
.         file open myfile using "$OUT/h2_results.csv", write replace
(file C:\Users\dalbrecht\Research
    Projects\ManyDaughters\ManyDaughters_DataPreprocessing/data/derived/5_res
    > ults/h2_results.csv not found)

.         file write myfile "coefficient,se,family,residual_df,model_df,p_value
> ,num_obs,num_participants,interpretation" _n

.         file write myfile "`coefficient',`se',`test_stat_family',`df_residual
> ',`df_model',`p_value',`num_obs',`num_participants',`interpretation'" _n

.         file close myfile

. 
. 
. *****************************************************************************
> ***
. 
. exit

end of do-file

. 
