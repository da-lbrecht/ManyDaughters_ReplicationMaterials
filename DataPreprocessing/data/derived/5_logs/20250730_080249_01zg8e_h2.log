. do "20250730_080249_01zg8e_h2.do"

.                                         /* ManyDaughters master file  */
. *****************************************************************************
> ***
. 
. * Authors: [REDACTED], [REDACTED] (based on the example code) *
. 
. 
. *************** SETUP ***************
. 
. * clear all
. version 15 // indicate the version of stata you are using here

. set maxvar 10000 // extend the maximum number of variables to 10,000


. 
. /*
> * Configure file paths * (Please do not change)
> if strpos("`c(pwd)'", "code") {
>     global ROOT "`c(pwd)'/.."
> }
> else {
>     global ROOT "`c(pwd)'"
> }
> global IN "$ROOT/data/raw" // folder, in which the original datasets are stor
> ed
> global DATA "$ROOT/data/derived" // folder for datasets
> global OUT "$ROOT/out" // folder for output (results, tables)
> */
. 
. *****************************************************************************
> ***
.                                 /* Create dataset for testing H1-H4  */
. *****************************************************************************
> ***
. 
. 
. 
. * Load and merge data * 
. 
. use "$IN/ppathl.dta", clear // use ppathl as a starting dataset
(SOEP-Core, v37 (EU Edition), doi:10.5684/soep.core.v37eu)

. 
. keep pid hid syear parid partner sex gebjahr

. 
. * Merge ppathl with other datasets.
. 
. * biobirth contains information on fertility history
. merge m:1 pid using "$IN/biobirth.dta", nogen keep(master matches) ///
>         keepusing(sumkids kidgeb* kidsex*)
(variable pid was long, now double to accommodate using data's values)
(label sex already defined)
(label sex_EN already defined)

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                            35,228  
    -----------------------------------------

.         
. /* drop those who don't have children (sumkids and all variables related to 
>         children seem to be updated at the end of the sample periods, 
>         so sumkids are kids until 2020) */
. drop if sumkids == 0
(10,594 observations deleted)

. * drop those for whom we don't know the gender of the first child
. drop if inlist(kidsex01, -2, -1)
(43 observations deleted)

.                 
. * pl contains all variables from the individual questionnaire 
. * pli* is time use for H3
. * plj* and plh* are gender attitudes + some plh* are topics of disagreement 
.         * with partner for H1 and H4
. * plh0004 is political orientation, plh0012_h is party preference, 
.         * plh0013_h is preference intensity for H2
. merge 1:1 pid syear using "$IN/pl.dta", nogen keep(master matches) ///
>         keepusing(pli0010 pli0011 pli0012_h pli0016_h pli0019_h pli0022_h pli
> 0024_h ///
>         pli0028_h pli0031_h pli0036 pli0038_h pli0040 pli0043_h pli0044_h ///
>         pli0046 pli0049_h pli0051 pli0052 pli0055 pli0057 pli0059 pli0060 ///
>         pli0159 pli0162 pli0163 pli0164 pli0178 pli0175 pli0176 pli0177 ///
>         plj0620 plj0621 plj0622 plj0623 plj0624 plj0625 plh0298_v1 plh0298_v2
>  ///
>         plh0301 plh0302_v1 plh0302_v2 plh0303 plh0304 plh0308_v1 plh0308_v2 /
> //
>         plh0309 plh0307 plh0322 plh0323 plh0324 plh0329 plh0004 plh0012_h plh
> 0013_h)
(label cid already defined)
(label pid_EN already defined)
(label cid_EN already defined)

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                            24,591  
    -----------------------------------------

.         
. * hgen contains generated variables on household level from the household int
> erview; use for household net income
. merge m:1 hid syear using "$IN/hgen.dta", nogen keep(master matches) ///
>         keepusing(hid syear hghinc)
(variable syear was long, now double to accommodate using data's values)
(label iyear already defined)
(label iyear_EN already defined)

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                            24,591  
    -----------------------------------------

. 
.         
. label language EN // change language of the labels to English

. 
. compress
  variable pli0012_h was float now byte
  variable pli0016_h was float now byte
  variable pli0019_h was float now byte
  variable pli0022_h was float now byte
  variable pli0024_h was float now byte
  variable pli0028_h was float now byte
  variable pli0031_h was float now byte
  variable pli0038_h was float now byte
  variable pid was double now long
  variable syear was double now int
  variable partner was double now byte
  variable sumkids was double now byte
  variable kidgeb01 was double now int
  variable kidgeb02 was double now int
  variable kidgeb03 was double now int
  variable kidgeb04 was double now int
  variable kidgeb05 was double now int
  variable kidgeb06 was double now int
  variable kidgeb07 was double now int
  variable kidgeb08 was double now int
