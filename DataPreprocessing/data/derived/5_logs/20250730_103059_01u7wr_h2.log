. keep pid gebjahr cid biovalid sumkids biokids kidsex* kidgeb* // hid

. foreach var of var kidgeb*  kidsex* {
  2.         qui replace `var'=. if `var'<0
  3. }

. g firstboy=0  // the year of birth of first boy

. g firstgirl=0 // the year of birth of first girl

. g kidboys=0

. g kidgirls=0

. foreach var of var kidsex* {
  2.         local zz=(substr("`var'",-2,2))
  3.         replace firstboy=kidgeb`zz' if kidsex`zz'==1 & firstboy==0
  4.         replace firstgirl=kidgeb`zz' if kidsex`zz'==2 & firstgirl==0
  5.         replace kidboys=kidboys+1 if kidsex`zz'==1
  6.         replace kidgirls=kidgirls+1 if kidsex`zz'==2
  7. }
