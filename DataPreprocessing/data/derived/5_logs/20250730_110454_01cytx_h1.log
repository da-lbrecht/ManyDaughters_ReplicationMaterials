file C:\Users\dalbrecht\Research
    Projects\ManyDaughters\ManyDaughters_DataPreprocessing/data/derived_confi
    > dential/5%-sample/h1_dataset.dta saved

. 
. 
. * ============================
. * Analysis
. * ============================
.  
. ******************
. ***** H1
. ******************
. * Main dependent variable for H1: plh0308_v2 
. * "It's best if the man and the woman work the same amount so they can share 
> the responsibility for taking care of the family and household equally."
. * The latest available year is 2018.
. 
. ******************
. **** Filters
. ******************
. gen year=2018

. 
. *** 1) Keep the latest available year 
. keep if syear==year
(33,168 observations deleted)

. 
. *** 2) Keep individuals with 1 to 5 children
. gen number_kids=.
(2,060 missing values generated)

. replace number_kids= 1 if kidsex01==1 | kidsex01==2
(1,478 real changes made)

. replace number_kids= 2 if kidsex02==1 | kidsex02==2
(1,137 real changes made)

. replace number_kids= 3 if kidsex03==1 | kidsex03==2
(491 real changes made)

. replace number_kids= 4 if kidsex04==1 | kidsex04==2
(198 real changes made)

. replace number_kids= 5 if kidsex05==1 | kidsex05==2
(77 real changes made)

. replace number_kids= 6 if kidsex06==1 | kidsex06==2
(34 real changes made)

. keep if number_kids>=1 & number_kids <=5
(616 observations deleted)

. 
. *** 3) Exclude families with first-born twins
. *** Proxy for the first-born is the first and second child are born in the sa
> me year and in the sam months
. drop if (kidgeb01 == kidgeb02) & (kidmon01==kidmon02) & kidgeb01>0
(15 observations deleted)

. 
. *** 4) Exclude not heterosexual individuals 
. drop if sexor!=0
(84 observations deleted)

. 
. *** 5) Keep only individuals with an identity as a man or a woman
. keep if sex ==1 | sex==2 
(0 observations deleted)

. 
. *** 6) Keep only individuals who are not younger as 25 and not older than 60
. gen age = year-ple0010_h
(282 missing values generated)

. keep if age >=25 & age <=60
(580 observations deleted)

. 
. *** 7) Keep only individuals who were born in Germany
. keep if corigin==1
(268 observations deleted)

. 
. **** Private housholds only
. keep if inlist(pop,1,2)
(0 observations deleted)

. 
. ****************************************************************
. * GENERATE VARIABLES * (Please adapt according to your needs)
. ****************************************************************
. ** Dependent variable H1:
. replace plh0308_v2=. if plh0308_v2<0
(5 real changes made, 5 to missing)

. sum  plh0308_v2, d

     Best if man and woman work the same amount so they
                can share the responsibility 
-------------------------------------------------------------
      Percentiles      Smallest
 1%            1              1
 5%            2              1
10%            2              1       Obs                 492
25%            4              1       Sum of wgt.         492

50%            6                      Mean           5.148374
                        Largest       Std. dev.      1.833257
75%            7              7
90%            7              7       Variance       3.360832
95%            7              7       Skewness       -.598633
99%            7              7       Kurtosis       2.148007

. gen z_plh0308_v2 = (plh0308_v2-r(mean))/r(sd)
(5 missing values generated)

. 
. 
. ** Independent variable:
. ***** First born child is daughter
. gen d_daughter=1 if kidsex01==2 // 1 if the first-born child is female
(291 missing values generated)

. replace d_daughter=0 if kidsex01==1 // 0 if the first-born child is m
(291 real changes made)

. 
. 
. ** Control variables: 
. *** male dummy
. gen male=1 if sex ==1
(283 missing values generated)

. replace male =0 if sex ==2
(283 real changes made)

. 
. *** age --> see above
. 
. *** number of other daughters
. gen num_daughters_02_05=0

. replace num_daughters_02_05= num_daughters_02_05+1 if kidsex02==2
(186 real changes made)

. replace num_daughters_02_05= num_daughters_02_05+1 if kidsex03==2
(77 real changes made)

. replace num_daughters_02_05= num_daughters_02_05+1 if kidsex04==2
(22 real changes made)

. replace num_daughters_02_05= num_daughters_02_05+1 if kidsex05==2
(4 real changes made)

. 
. *** number of children --> see above 
. 
. *** race of the respondent (dummy equals one if White-Caucasian vs. zero if n
> ot)
. * not included in year 2018
. 
. *** age of the first-born child at the point of the survey
. gen age_kid_01= year - kidgeb01 if kidgeb01>0
(1 missing value generated)

. 
. *** highest educational level achieved by the respondent (linear value, 0 = w
> ithout school degree, 1 = school degree, 2 = professional degree (Ausbildung)
> , 3 = university degree)
. * not available. Instead number of years in education
. gen education_yrs= pgbilzeit if pgbilzeit>=0
(8 missing values generated)

. 
. *** marital status (dummy, equals one if married or living with a partner, ze
> ro otherwise)
. * we control only for married, as living in together (not-marries) is not ava
> ilable.
. gen married=1 if pgfamstd==1
(153 missing values generated)

. replace married =0 if pgfamstd!=1
(153 real changes made)

. 
. 
. *** political party affiliation
. * will reduce the sample by half
. 
. *** religion
. * not included in year 2018
. 
. *** employment status (linear value, 0 not employed, 1 part-time, 2 full-time
> , 3 self-employed)
. gen employment = 0 if pgemplst ==5
(431 missing values generated)

. replace employment = 1 if pgemplst ==2 | pgemplst ==4
(164 real changes made)

. replace employment = 3 if pgemplst ==1
(267 real changes made)

. 
. *** income
. gen income = pglabgro if pglabgro>=0
(66 missing values generated)

. * The missing values are set to 0 for those respondents who chose "doesn't ap
> ply" and are not employed
. replace income =0 if pglabgro ==-2 & employment ==0
(66 real changes made)

. 
. *** east/west Germany (dummy)
. gen west=1 if sampreg  ==1
(113 missing values generated)

. replace west=0 if sampreg==2
(113 real changes made)

. 
. **************************************************************************
. ***** HYPOTHESIS TEST FOR H1 * (Please adapt according to your needs)
. **************************************************************************
. 
.         * Let's  assume that agreeing with the statement "It's best if the ma
> n and the woman work the same amount so they can share the responsibility for
>  taking care of the family and household equally." is a good measure of suppo
> rt for gender equality attitudes (hypothesis 1), 
.         * if agreeing with the statement to a higher extend, the respondent i
> s more likely to support gender equality.
.         * Accordingly, we run a linear OLS regression analysis with normalize
> d plh0308_v2 as the dependent variable and the dummy variable d_daughter (the
>  first child is a girl) as the independent variable
.         * We use control variables as specified in the PAP and defined above.
>  
. 
. reg z_plh0308_v2 d_daughter male age num_daughters_02_05 number_kids age_kid_
> 01 education_yrs married income employment west, ro

Linear regression                               Number of obs     =        483
                                                F(11, 471)        =       4.78
                                                Prob > F          =     0.0000
                                                R-squared         =     0.0949
                                                Root MSE          =     .96326

------------------------------------------------------------------------------
             |               Robust
z_plh0308_v2 | Coefficient  std. err.      t    P>|t|     [95% conf. interval]
-------------+----------------------------------------------------------------
  d_daughter |  -.0189231   .0912441    -0.21   0.836     -.198219    .1603728
        male |   -.131126   .1048191    -1.25   0.212     -.337097     .074845
         age |   .0028133   .0099348     0.28   0.777    -.0167086    .0223353
num_daugh~05 |  -.0208853   .0871309    -0.24   0.811    -.1920987     .150328
 number_kids |  -.0457678   .0687933    -0.67   0.506    -.1809476     .089412
  age_kid_01 |   .0161259    .008823     1.83   0.068    -.0012115    .0334633
education_~s |  -.0057342   .0183269    -0.31   0.755    -.0417467    .0302783
     married |  -.2979862   .0959912    -3.10   0.002    -.4866101   -.1093623
      income |   5.09e-06   .0000149     0.34   0.733    -.0000242    .0000343
  employment |   .0511438   .0449248     1.14   0.256     -.037134    .1394216
        west |  -.3583924   .1043523    -3.43   0.001    -.5634462   -.1533386
       _cons |   .2103338   .3914489     0.54   0.591    -.5588685    .9795361
------------------------------------------------------------------------------

. 
. 
. * EXTRACT AND EXPORT RESULTS * (Please check whether the suggested code autom
> atically picks up the correct statistics for your chosen regression analysis 
> and adapt if needed)
. 
.         * Extract the required statistics
. 
.                 * (i) coefficient estimate
.                 local coefficient = _b[d_daughter]

. 
.                 * (ii) standard error
.                 local se = _se[d_daughter]

. 
.                 * (iii) family of the test statistic (e.g. z, t, F, Chi²)
.                 local test_stat_family = "t"

. 
.                 * (iv) residual and model degrees of freedom (DFs) if applica
> ble
.                 local df_residual = e(df_r)

.                 local df_model = e(df_m)

. 
.                 * (v) p-value
.                 local p_value = _b[d_daughter] / _se[d_daughter]

.                 local p_value = 2 * ttail(e(df_r), abs(`p_value'))

. 
.                 * (vi) number of observations
.                 local num_obs = e(N)

. 
.                 * (vii) number of participants
.                 quietly levelsof pid if e(sample), local(participants)

.                 local num_participants : word count `participants'

. 
.                 * (viii) interpretation of directionality
.                 local interpretation "positive coefficient is in line with hy
> pothesis"

.                 
. 
.         // Display the saved statistics
.         di "Coefficient: `coefficient'"
Coefficient: -.0189231100459438

.         di "Standard Error: `se'"
Standard Error: .0912441174344299

.         di "Test Statistic Family: `test_stat_family'"
Test Statistic Family: t

.         di "Residual Degrees of Freedom: `df_residual'"
Residual Degrees of Freedom: 471

.         di "Model Degrees of Freedom: `df_model'"
Model Degrees of Freedom: 11

.         di "p-value: " `p_value'
p-value: .83579499

.         di "Number of observations: " `num_obs'
Number of observations: 483

.         di      "Number of participants: " `num_participants'
Number of participants: 483

.         di "Interpretation of directionality: " "`interpretation'"
Interpretation of directionality: positive coefficient is in line with hypothes
> is

. 
