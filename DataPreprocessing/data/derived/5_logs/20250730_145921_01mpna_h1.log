. *** First child born between 2014 and 2018 and no second child in that time
. gen fc=.
(35,228 missing values generated)

. replace fc=0 if ((syear<kidgeb01) | (syear==kidgeb01 & pgmonth<kidmon01)) & (
> kidgeb01>=2014 & kidgeb01<=2018)
(405 real changes made)

. replace fc=1 if ((syear>kidgeb01) | (syear==kidgeb01 & pgmonth>kidmon01)) & (
> kidgeb01>=2014 & kidgeb01<=2018)
(526 real changes made)

. replace fc=. if ((syear>kidgeb02) | (syear==kidgeb02 & pgmonth>kidmon02)) & (
> kidgeb02>=2014 & kidgeb02<=2018)
(119 real changes made, 119 to missing)

