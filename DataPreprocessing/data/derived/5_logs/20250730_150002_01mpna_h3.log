note: $remainingtest initialized with 5 variables.

.         
. forvalues  i = 1(1)5{ 
  2.                 local max_loss = 0  // Reset max_loss for each iteration
  3.                 local var`i'toremove ""  // Reset variable to be removed f
> or each iteration
  4. 
.                 * Identify which variable is the next candidate to be removed
.                 foreach var of varlist $remaining {
  5.                         quietly regress `dep_var' `key_indvar' `var'
  6.                         local obs`i' = e(N)
  7.                         local loss = `obs_comp' - `obs`i''
  8.                         // Check if the current loss is greater than the m
> ax_loss
.                                 if `loss' > `max_loss' {
  9.                                 // Update max_loss and var1toremove
.                                         local max_loss = `loss'
 10.                                         local var`i'toremove  `var'
 11.                                 }
 12.                 display "`var`i'toremove'"
 13.                 }
 14.                 
.                 *Calculate the share of observations remaining in the sample 
> after we remove the candidate  
.                 vl modify remainingtest=remaining - (`var`i'toremove')
 15.                 disp "$remainingtest"
 16.                 regress `dep_var' `key_indvar' $remainingtest
 17.                 local obs_selvar`i'=e(N)
 18.                 local check10_loss`i'=`obs_comp'-`obs_selvar`i''
 19.                 local check10_share`i'=(`check10_loss`i''/`obs_comp')
 20.                 disp "`obs_comp'"
 21.                 disp "`obs_selvar`i''"
 22.                 display "`check10_loss`i''"
 23.                 display "`check10_share`i''"
 24.                 
.                 * If the loss is above 10 % remove the variable, else stop
.                 if (`check10_share`i''>0.10 ){
 25.                         local varlist `var`i'toremove'
 26.                         vl modify remaining=remaining - (`var`i'toremove')
 27.                         }
 28.                 else {
 29.                         local last_var `var`i'toremove'
 30.                         break
 31.                         display "Iteration stopped."    
 32.                         
.                         display "`last_var'"
 33.                         }
 34.         }

