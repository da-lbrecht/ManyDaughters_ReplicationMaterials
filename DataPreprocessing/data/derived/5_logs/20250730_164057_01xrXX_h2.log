. do "20250730_164057_01xrXX_h2.do"

. *****************************************************************************
> ***
. ****************** Do-File H2: #ManyDaughters Project ******************
. *****************************************************************************
> ***
. 
. * Author: RT 01xrXX
. * (adapted from the framework provided by the organisers and written by Tina 
> Wang, David Albrecht)
. 
. * ============================
. * Setup 
. * ============================
. 
. * clear all
. version 19 // indicate the version of stata you are using here

. set maxvar 10000 // extend the maximum number of variables to 10,000


. 
. * INSTALL PACKAGES 
. ssc install outreg2
checking outreg2 consistency and verifying not already installed...
all files already exist and are up to date.

. 
. * CONFIGURE FILE PATHS * (Please do not change)
. /*
> * the following code automatically sets paths based on where you saved the di
> stributed file-package on your system *
> if strpos("`c(pwd)'", "code") {
>     global ROOT "`c(pwd)'/.."
> }
> else {
>     global ROOT "`c(pwd)'"
> }
> global IN "$ROOT/data/raw" // folder, in which the original datasets are stor
> ed
> global DATA "$ROOT/data/derived" // folder for datasets
> global OUT "$ROOT/out" // folder for output (results, tables)
> */
. 
. * ============================
. * Data Preparation * 
. * ============================
. 
. * LOAD AND MERGE DATA 
. 
.         use "$IN/ppathl.dta", clear // use ppathl as a starting dataset
(SOEP-Core, v37 (EU Edition), doi:10.5684/soep.core.v37eu)

. 
.         * Merge ppathl with all datasets
. 
.         * biobirth contains information on fertility history
.         merge m:1 pid using "$IN/biobirth.dta", nogen keep(master matches)
(variable pid was long, now double to accommodate using data's values)
(variable cid was long, now double to accommodate using data's values)
(variable gebjahr was int, now double to accommodate using data's values)
(label sex already defined)
(label sex_EN already defined)

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                            35,228  
    -----------------------------------------

.         * pgen contains user-friendly data on the individual level that are c
> onsolidated from different sources
.         merge 1:1 pid syear using "$IN/pgen.dta", nogen keep(master matches)
(variable syear was long, now double to accommodate using data's values)

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                            35,228  
    -----------------------------------------

.         * pl contains all variables from the individual questionnaire
.         merge 1:1 pid syear using "$IN/pl.dta", nogen keep(master matches)
(variable inputdataset was str6, now str9 to accommodate using data's values)
(label cid already defined)
(label pid_EN already defined)
(label cid_EN already defined)

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                            35,228  
    -----------------------------------------

.         * hgen contains generated variables on household level from the house
> hold interview; use for household net income
.         merge m:1 hid syear using "$IN/hgen.dta", nogen keep(master matches) 
> keepusing(hid syear hghinc)
(label iyear already defined)
(label iyear_EN already defined)

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                            35,228  
    -----------------------------------------

. 
.         label language EN // change language of the labels to English

. 
.         save "$DATA/h2_dataset.dta", replace // save merged dataset
file C:\Users\dalbrecht\Research
    Projects\ManyDaughters\ManyDaughters_DataPreprocessing/data/derived_confi
    > dential/5%-sample/h2_dataset.dta saved

. 
. 
. * ============================
. * Analysis
. * ============================
. 
. * FILTERS * 
.  
.         * Keep only participants who have children
.         keep if sumkids>0
(10,594 observations deleted)

. 
. 
. * GENERATE VARIABLES * 
. 
.         * generate dummy variable for whether participant has at least one da
> ughter (1) or not (0)
.         egen num_daughters = anycount(kidsex01-kidsex19), values(2)

.         gen d_daughter = (num_daughters > 0) if num_daughters!=.

.         
.         * recode the sex variable for ease of interpretation
.         gen male = 1- (sex - 1)

.         
.         * clean & standardize variable for political orientation, and define 
> so that higher values means more left-wing
.         des plh0004

Variable      Storage   Display    Value
    name         type    format    label      Variable label
-------------------------------------------------------------------------------
plh0004         byte    %54.0g     plh0004_EN
                                              Political attitude

.         replace plh0004=. if plh0004<0
(17,402 real changes made, 17,402 to missing)

.         egen std_plh0004 = std(plh0004)
(21,128 missing values generated)

.         gen left_wing = - std_plh0004
(21,128 missing values generated)

.         
. 
.         
. * HYPOTHESIS TEST FOR H2 
. 
.         * I run a OLS regression with a variable measuring political orientat
> ion (on the left-right scale) as the dependent variable and an indicator for 
> having at least one daughter as the dependent variable. The sample is restric
> ted to individuals who have children, because I think they are a better compa
> rison (people with and without children tend to be different, while sex at bi
> rth conditional on having a child is randomly assigned)
. 
.         reghdfe left_wing d_daughter, absorb(sumkids gebjahr syear corigin ma
> le) vce(cluster pid syear)
(dropped 23 singleton observations)
(MWFE estimator converged in 7 iterations)

HDFE Linear regression                            Number of obs   =      3,483
Absorbing 5 HDFE groups                           F(   1,      3) =       1.40
Statistics robust to heteroskedasticity           Prob > F        =     0.3223
                                                  R-squared       =     0.0764
                                                  Adj R-squared   =     0.0400
Number of clusters (pid)     =      1,842         Within R-sq.    =     0.0011
Number of clusters (syear)   =          4         Root MSE        =     0.9793

                              (Std. err. adjusted for 4 clusters in pid syear)
------------------------------------------------------------------------------
             |               Robust
   left_wing | Coefficient  std. err.      t    P>|t|     [95% conf. interval]
-------------+----------------------------------------------------------------
  d_daughter |   .0791091   .0669259     1.18   0.322    -.1338789    .2920972
       _cons |  -.0580035   .0491723    -1.18   0.323    -.2144916    .0984847
------------------------------------------------------------------------------

Absorbed degrees of freedom:
-----------------------------------------------------+
 Absorbed FE | Categories  - Redundant  = Num. Coefs |
-------------+---------------------------------------|
     sumkids |         9           1           8     |
     gebjahr |        78           1          77     |
       syear |         4           4           0    *|
     corigin |        43           1          42    ?|
        male |         2           1           1    ?|
-----------------------------------------------------+
? = number of redundant parameters may be higher
* = FE nested within cluster; treated as redundant for DoF computation

. 
. 
. * EXTRACT AND EXPORT RESULTS 
. 
.         * Extract the required statistics
. 
.                 * (i) coefficient estimate
.                 local coefficient = _b[d_daughter]

. 
.                 * (ii) standard error
.                 local se = _se[d_daughter]

. 
.                 * (iii) family of the test statistic (e.g. z, t, F, Chi²)
.                 local test_stat_family = "t"

. 
.                 * (iv) residual and model degrees of freedom (DFs) if applica
> ble
.                 local df_residual = e(df_r)

.                 local df_model = e(df_m)

. 
.                 * (v) p-value
.                 local p_value = _b[d_daughter] / _se[d_daughter]

.                 local p_value = 2 * ttail(e(df_r), abs(`p_value'))

. 
.                 * (vi) number of observations
.                 local num_obs = e(N)

. 
.                 * (vii) number of participants
.                 quietly levelsof pid if e(sample), local(participants)

.                 local num_participants : word count `participants'

. 
.                 * (viii) interpretation of directionality
.                 scalar coef_d_daughter = _b[d_daughter]

.                 local interpretation "positive coefficient is in line with hy
> pothesis"

. 
.         // Display the saved statistics
.         di "Coefficient: `coefficient'"
Coefficient: .0791091463501513

.         di "Standard Error: `se'"
Standard Error: .0669258909090274

.         di "Test Statistic Family: `test_stat_family'"
Test Statistic Family: t

.         di "Residual Degrees of Freedom: `df_residual'"
Residual Degrees of Freedom: 3

.         di "Model Degrees of Freedom: `df_model'"
Model Degrees of Freedom: 1

.         di "p-value: " `p_value'
p-value: .322348

.         di "Number of observations: " `num_obs'
Number of observations: 3483

.         di      "Number of participants: " `num_participants'
Number of participants: 1842

.         di "Interpretation of directionality: " "`interpretation'"
Interpretation of directionality: positive coefficient is in line with hypothes
> is

. 
.         * Export results to csv 
.         file open myfile using "$OUT/h2_results.csv", write replace
(file C:\Users\dalbrecht\Research
    Projects\ManyDaughters\ManyDaughters_DataPreprocessing/data/derived/5_res
    > ults/h2_results.csv not found)

.         file write myfile "coefficient,se,family,residual_df,model_df,p_value
> ,num_obs,num_participants,interpretation" _n

.         file write myfile "`coefficient', `se', `test_stat_family', `df_resid
> ual', `df_model',`p_value',`num_obs',`num_participants',`interpretation'" _n

.         file close myfile

. 
. 
. *****************************************************************************
> ***
. 
. exit

end of do-file

. 
end of do-file
