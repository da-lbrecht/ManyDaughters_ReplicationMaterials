.  
.  
. .........................................

. // Labour income net
. ......................................... 

. qui g wageinc= pglabnet

. qui replace wageinc=. if wageinc<0

. qui replace wageinc=1 if wageinc==0

. qui g lwage_i=log(wageinc)

. 
. 
