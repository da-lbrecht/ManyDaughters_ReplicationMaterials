. /***********************************************************************
> *  The spreadsheet  $OUT/h2_model_results.xls  now contains eight
> *  columns with coefficients ± cluster-robust SEs and two info rows
> *  indicating whether individual and/or year fixed effects were used.
> ***********************************************************************/
. 
. /***********************************************************************
> *  EXTRACT & EXPORT  –  Column 8 results (FE + TV + Year FE)
> *  (Our preferred specification for the two-way fixed effects model)
> ***********************************************************************/
. 
. *--------------------------------------------------
. * 1.  Pull raw statistics
. *--------------------------------------------------
. local coef  = _b[anydaughter_sofar]

. local se    = _se[anydaughter_sofar]

. local tstat = `coef' / `se'

. 
. * (iv) residual and model degrees of freedom (DFs) if applicable
.                 local df_residual = e(df_r)

.                 local df_model = e(df_m)

. 
. * p-value (use df_r if available, else normal)
. capture local df = e(df_r)

. if missing(`df') {
.     local pval = 2*normal(-abs(`tstat'))
. }

. else {
.     local pval = 2*ttail(`df',abs(`tstat'))
. }

. 
. local nobs = e(N)

. 
. *--------------------------------------------------
. * 2.  Conclusion
. *  Rule: if the treatment coefficient is statistically insignificant
. *        (p ≥ .05), treat it as zero and mark as "not in line".
. *--------------------------------------------------
. 
. * interpretation
. local interpretation = "positive coefficient is in line with hypothesis"

. 
. * (iii) family of the test statistic (e.g. z, t, F, Chi²) // Added by DA for 
> consistency
. local test_stat_family = "t"

. 
. *--------------------------------------------------
. * 3.  Display for quick check
. *--------------------------------------------------
. di "Coefficient (adjusted) : " `coef'
Coefficient (adjusted) : .64315578

. di "Standard Error         : " `se'
Standard Error         : .28647484

. di "p-value                : " `pval'
p-value                : .02493535

. di "Number of observations : " `nobs'
Number of observations : 1837

. di "Interpretation         : " "`interpretation'"
Interpretation         : positive coefficient is in line with hypothesis

. di "Family                 : " "`test_stat_family'"
Family                 : t

. 
. *--------------------------------------------------
. * 4.  Export to CSV
. *--------------------------------------------------
. file open myfile using "$OUT/h2_results.csv", write replace
(file C:\Users\dalbrecht\Research
    Projects\ManyDaughters\ManyDaughters_DataPreprocessing/data/derived/5_res
    > ults/h2_results.csv not found)

. //file write myfile "coefficient,se,p_value,df_residual,df_model,num_obs,inte
> rpretation" _n
. file write myfile "coefficient,se,family,residual_df,model_df,p_value,num_obs
> ,num_participants,interpretation" _n //Adapted by DA to ensure consistent exp
> ort of results.

. file write myfile "`coef',`se',`test_stat_family',`df_residual',`df_model',`p
> val',`nobs',,`interpretation'" _n

. file close myfile

. 
. 
. *****************************************************************************
> ***
. 
. exit

end of do-file

. 
end of do-file
