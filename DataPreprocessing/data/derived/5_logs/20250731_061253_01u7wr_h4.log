. 
. * Number of bootstrap iterations
. local reps = 100

. 
. * Begin bootstrap loop
. forvalues i = 1/`reps' {
  2.     display "Iteration `i'"
  3. 
.     * Step 1: Randomly select 1000 unique pids
.     use `master', clear
  4.     keep pid
  5.     duplicates drop
  6.     gen rand = runiform()
  7.     sort rand
  8.     keep in 1/1000
  9.     drop rand
 10.     tempfile sample_pids
 11.     save `sample_pids', replace
 12. 
.     * Step 2: Merge to get full data for those 1000 selected pids
.     use `master', clear
 13.     joinby pid using `sample_pids'
 14. 
.        * Step 3: Run csdid
.           /// males
>     csdid gender_score2 if sex == 1, ivar(pid) time(syear) gvar(firstgirl)
 15. estat event
 16.     matrix b = r(table)
 17.         
.         /// females
>     csdid gender_score2 if sex == 2, ivar(pid) time(syear) gvar(firstgirl)
 18. estat event
 19.     matrix c = r(table)
 20.         
.     * Step 4: Extract results
.     gen iter = `i'
 21.     gen att_m  = b[1,2]
 22.     gen se_m   = b[2,2]
 23.         gen att_f  = c[1,2]
 24.     gen se_f   = c[2,2]
 25.         
.         
.         preserve 
 26.         collapse (mean) att_* se_* iter
 27. 
.     append using `results'
 28.     save `results', replace
 29.         save  "$OUT\block_boot_results.dta", replace
 30.         restore
 31. }
