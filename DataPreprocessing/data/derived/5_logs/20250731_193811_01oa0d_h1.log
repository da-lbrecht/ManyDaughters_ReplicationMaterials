. ***************************************************************
. ****************** Many Daughters Project - H1  ***************
. ***************************************************************
. 
. * ============================
. * Setup
. * ============================
. * clear all
. version 19

. set maxvar 10000


. 
. 
. * CONFIGURE FILE PATHS * (Please do not change)
. /*
> * the following code automatically sets paths based on where you saved the di
> stributed file-package on your system *
> if strpos("`c(pwd)'", "code") {
>     global ROOT "`c(pwd)'/.."
> }
> else {
>     global ROOT "`c(pwd)'"
> }
> global IN "$ROOT/data/raw" // folder, in which the original datasets are stor
> ed
> global DATA "$ROOT/data/derived" // folder for datasets
> global OUT "$ROOT/out" // folder for output (results, tables)
> 
> */
. 
. * ============================
. * Data Preparation
. * ============================
. 
. * Our dependent variable is from 2018 survey.
. * Variables: agreement_share (plh0308_v2),
. use "$IN/pl.dta", clear
(SOEP-Core, v37 (EU Edition), doi:10.5684/soep.core.v37eu)

. keep if syear == 2018
(33,168 observations deleted)

. keep pid plh0308_v2

. rename plh0308_v2 agreement_sharework

. keep if agreement_sharework > 0 & !missing(agreement_sharework)
(789 observations deleted)

. save "$DATA/h1_sharework.dta", replace
(file C:\Users\dalbrecht\Research
    Projects\ManyDaughters\ManyDaughters_DataPreprocessing/data/derived_confi
    > dential/5%-sample/h1_sharework.dta not found)
file C:\Users\dalbrecht\Research
    Projects\ManyDaughters\ManyDaughters_DataPreprocessing/data/derived_confi
    > dential/5%-sample/h1_sharework.dta saved

. 
. * Partner information, sex, birth year, migration background
. * Variables: pid, syear, hid, cid, parid, partner
. use "$IN/ppathl.dta", clear
(SOEP-Core, v37 (EU Edition), doi:10.5684/soep.core.v37eu)

. keep if syear == 2018
(33,168 observations deleted)

. keep pid hid parid partner sex gebjahr migback

. replace parid = . if parid < 0
(765 real changes made, 765 to missing)

. replace partner = . if partner < 0
(0 real changes made)

. keep if (!missing(pid)) & (!missing(hid)) & (!missing(partner))
(0 observations deleted)

. save "$DATA/h1_partner_migration.dta", replace
(file C:\Users\dalbrecht\Research
    Projects\ManyDaughters\ManyDaughters_DataPreprocessing/data/derived_confi
    > dential/5%-sample/h1_partner_migration.dta not found)
file C:\Users\dalbrecht\Research
    Projects\ManyDaughters\ManyDaughters_DataPreprocessing/data/derived_confi
    > dential/5%-sample/h1_partner_migration.dta saved

. 
. * First child information
. * Variables: pid, kidsex01, kidgeb01
. * Generated variable: firstkid_female
. use "$IN/biobirth.dta", clear
(SOEP-Core, v37 (EU Edition), doi:10.5684/soep.core.v37eu)

. keep pid kidsex01 kidgeb01

. keep if kidsex01 > 0
(1,469 observations deleted)

. keep if kidgeb01 > 0
(12 observations deleted)

. gen firstkid_female = kidsex01 == 2

. rename kidgeb01 firstkid_birthyear

. rename kidsex01 firstkid_sex

. save "$DATA/h1_firstkid.dta", replace
(file C:\Users\dalbrecht\Research
    Projects\ManyDaughters\ManyDaughters_DataPreprocessing/data/derived_confi
    > dential/5%-sample/h1_firstkid.dta not found)
file C:\Users\dalbrecht\Research
    Projects\ManyDaughters\ManyDaughters_DataPreprocessing/data/derived_confi
    > dential/5%-sample/h1_firstkid.dta saved

. 
. 
. * Education and income 
. use "$IN/pgen.dta", clear
(SOEP-Core, v37 (EU Edition), doi:10.5684/soep.core.v37eu)

. keep if syear == 2018
(33,168 observations deleted)

. keep pid pgbilzeit pglabnet

. replace pgbilzeit = . if pgbilzeit < 0
(110 real changes made, 110 to missing)

. replace pglabnet = . if pglabnet < 0
(650 real changes made, 650 to missing)

. keep if (!missing(pid)) 
(0 observations deleted)

. rename pglabnet incomelabor_net

. rename pgbilzeit education_totalyears

. save "$DATA/h1_education_income.dta", replace
(file C:\Users\dalbrecht\Research
    Projects\ManyDaughters\ManyDaughters_DataPreprocessing/data/derived_confi
    > dential/5%-sample/h1_education_income.dta not found)
file C:\Users\dalbrecht\Research
    Projects\ManyDaughters\ManyDaughters_DataPreprocessing/data/derived_confi
    > dential/5%-sample/h1_education_income.dta saved

. 
. use "$IN/biobirth.dta", clear
(SOEP-Core, v37 (EU Edition), doi:10.5684/soep.core.v37eu)

. drop if kidsex01 < 0 & kidgeb01 < 0
(1,466 observations deleted)

. 
. * Remove kids born after 2018
. forvalues i = 1/19 {
  2.     local k = string(`i', "%02.0f")
  3. 
.     * Replace both sex and birth year with missing if born after 2018
.     quietly replace kidsex`k' = . if kidsex`k' < 0
  4.         quietly replace kidgeb`k' = . if kidgeb`k' < 0
  5.         
.         quietly replace kidsex`k' = . if kidgeb`k' > 2018
  6.     quietly replace kidgeb`k' = . if kidgeb`k' > 2018
  7. }

. 
. 
. gen num_sons = 0

. gen num_daughters = 0

. 
. forvalues i = 1/19 {
  2.     local k = string(`i', "%02.0f")
  3.     quietly replace num_sons = num_sons + 1 if kidsex`k' == 1
  4.     quietly replace num_daughters = num_daughters + 1 if kidsex`k' == 2
  5. }

. 
. gen num_biochildren = num_sons + num_daughters

. gen has_children = num_biochildren > 0

. gen has_daughters = num_daughters > 0

. 
. 
. gen lastkid_birthyear = .
(3,042 missing values generated)

. forvalues i = 1/19 {
  2.     local k = string(`i', "%02.0f")
  3.     quietly replace lastkid_birthyear = max(lastkid_birthyear, kidgeb`k') 
> ///
>         if !missing(kidgeb`k') & (missing(lastkid_birthyear) | kidgeb`k' > la
> stkid_birthyear)
  4. }

. 
. 
. keep pid num_biochildren num_sons num_daughters has_children has_daughters la
> stkid_birthyear

. 
. save "$DATA/h1_nkids.dta", replace
(file C:\Users\dalbrecht\Research
    Projects\ManyDaughters\ManyDaughters_DataPreprocessing/data/derived_confi
    > dential/5%-sample/h1_nkids.dta not found)
file C:\Users\dalbrecht\Research
    Projects\ManyDaughters\ManyDaughters_DataPreprocessing/data/derived_confi
    > dential/5%-sample/h1_nkids.dta saved

. 
. 
. * ============================
. * Merge All Data
. * ============================
. use "$DATA/h1_firstkid.dta", clear
(SOEP-Core, v37 (EU Edition), doi:10.5684/soep.core.v37eu)

. merge 1:1 pid using "$DATA/h1_nkids.dta", nogen
(label pid_EN already defined)

    Result                      Number of obs
    -----------------------------------------
    Not matched                            15
        from master                         0  
        from using                         15  

    Matched                             3,027  
    -----------------------------------------

. merge 1:1 pid using "$DATA/h1_education_income.dta", nogen

    Result                      Number of obs
    -----------------------------------------
    Not matched                         2,144
        from master                     1,563  
        from using                        581  

    Matched                             1,479  
    -----------------------------------------

. merge 1:1 pid using "$DATA/h1_sharework.dta", nogen
(label pid_EN already defined)

    Result                      Number of obs
    -----------------------------------------
    Not matched                         2,352
        from master                     2,352  
        from using                          0  

    Matched                             1,271  
    -----------------------------------------

. merge 1:1 pid using "$DATA/h1_partner_migration.dta", nogen

    Result                      Number of obs
    -----------------------------------------
    Not matched                         1,563
        from master                     1,563  
        from using                          0  

    Matched                             2,060  
    -----------------------------------------

. 
. 
. replace education_totalyears = . if education_totalyears < 0
(0 real changes made)

. replace agreement_sharework = . if agreement_sharework < 0
(0 real changes made)

. 
. 
. keep if !missing(sex) & !missing(firstkid_birthyear) & !missing(firstkid_sex)
>  & !missing(agreement_sharework) & !missing(gebjahr)
(2,649 observations deleted)

. keep if num_biochildren > 0
(9 observations deleted)

. 
. * ============================
. * Generate additional vars
. * ============================
. 
. gen male = sex == 1

. gen years_since_lastkid = 2018 - lastkid_birthyear

. gen years_since_firstkid = 2018 - firstkid_birthyear

. gen age = 2018 - gebjahr

. gen logincome = log(incomelabor_net)
(356 missing values generated)

. 
. keep if years_since_firstkid >= 1
(17 observations deleted)

. save "$DATA/h1_dataset.dta", replace
file C:\Users\dalbrecht\Research
    Projects\ManyDaughters\ManyDaughters_DataPreprocessing/data/derived_confi
    > dential/5%-sample/h1_dataset.dta saved

. 
. 
. * ============================
. * Regression
. * ============================
. 
. ivregress 2sls agreement_sharework (has_daughters = firstkid_female) ///
>     num_biochildren male age education_totalyears logincome i.migback i.partn
> er years_since_firstkid, cluster(hid)

