        from master                     1,586  
        from using                        564  

    Matched                             1,456  
    -----------------------------------------

. merge 1:1 pid using "$DATA/h2_politics.dta", nogen
(label pid_EN already defined)

    Result                      Number of obs
    -----------------------------------------
    Not matched                         2,368
        from master                     2,368  
        from using                          0  

    Matched                             1,238  
    -----------------------------------------

. merge 1:1 pid using "$DATA/h2_partner_migration.dta", nogen

    Result                      Number of obs
    -----------------------------------------
    Not matched                         1,587
        from master                     1,587  
        from using                          0  

    Matched                             2,019  
    -----------------------------------------

. 
. 
. 
. replace education_totalyears = . if education_totalyears < 0
(0 real changes made)

. replace political_attitude = . if political_attitude < 0
(0 real changes made)

. 
. 
. keep if !missing(sex) & !missing(firstkid_birthyear) & !missing(firstkid_sex)
>  & !missing(political_attitude) & !missing(gebjahr)
(2,676 observations deleted)

. keep if num_biochildren > 0
(0 observations deleted)

. 
. * ============================
. * Generate additional vars
. * ============================
. 
. 
. gen male = sex == 1

. gen years_since_lastkid = 2019 - lastkid_birthyear

. gen years_since_firstkid = 2019 - firstkid_birthyear

. gen age = 2019 - gebjahr

. gen logincome = log(incomelabor_net)
(340 missing values generated)

. 
. keep if years_since_firstkid >= 1
(11 observations deleted)

. save "$DATA/h2_dataset.dta", replace
file C:\Users\dalbrecht\Research
    Projects\ManyDaughters\ManyDaughters_DataPreprocessing/data/derived_confi
    > dential/5%-sample/h2_dataset.dta saved

. 
. 
. * ============================
