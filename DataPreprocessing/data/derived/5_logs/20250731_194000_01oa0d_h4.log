Endogenous: has_daughters has_daughters_male
Exogenous:  num_biochildren male age education_totalyears logincome 2.migback 3.migback
            1.partner 2.partner years_since_firstkid firstkid_female firstkid_female_male

. 
. 
. * ============================
. * Collect parameters
. * ============================
. 
. * (i) Coefficient
. local coefficient = _b[has_daughters_male]

. 
. * (ii) Standard error
. local se = _se[has_daughters_male]

. 
. * (iii) Test statistic family
. local test_stat_family = "z"  

. 
. * (iv) Degrees of freedom
. * Residual d.f.
. local num_clusters = e(N_clust)

. local df_residual = `num_clusters' - 1

. 
. * Model d.f.
. local df_model = e(df_m)

. 
. * (v) p-value
. matrix b = r(table)

. local col = colnumb(b, "has_daughters_male")

. local p_value = b[4, `col']

. 
. * (vi) Number of observations
. local num_obs = e(N)

. 
. * (vii) number of participants
. local num_participants = e(N)

. 
. * (viii) Interpretation of directionality
. scalar coef_interaction = _b[has_daughters_male]

.                 local interpretation "positive coefficient is in line with hypothesis"

. 
. * ============================
. * Write to CSV
. * ============================
. 
. file open myfile using "$OUT/h4_results.csv", write replace
(file C:\Users\dalbrecht\Research
    Projects\ManyDaughters\ManyDaughters_DataPreprocessing/data/derived/5_results/h4_results.csv
    not found)

. file write myfile "coefficient,se,family,residual_df,model_df,p_value,num_obs,num_participants,in
> terpretation" _n

. file write myfile ///
>     "`coefficient',`se',`test_stat_family',`df_residual',`df_model',`p_value',`num_obs',`num_part
> icipants',`interpretation'" _n

. file close myfile

. 
. exit

