                 num_biochildren |  -.1935508   .0989539    -1.96   0.050    -.3874968    .0003953
                            male |    .209559   .4540561     0.46   0.644    -.6803747    1.099493
                             age |   -.023625   .0177589    -1.33   0.183    -.0584318    .0111817
