.                 local df_model = e(df_m)

. 
.                 * (v) p-value
.                 
.                 * ADDED
.                 local tstat   = _b[1.d_daughter#1.male] / _se[1.d_daughter#1.
> male]

.                 local p_value = 2 * ttail(e(df_r), abs(`tstat'))

.                 * END ADDED
