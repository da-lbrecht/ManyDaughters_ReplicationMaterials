.                 * Control variables: gender, with reference being female [2];
>  pla0009_v2
.                 * Deviation from PAP: we state to use pla0009_h. However, thi
> s is not present in the pl dataset.
.                 * Therefore we use pla0009_v2.
.                 rename pla0009_v2 gender

.         
.                 * Control variables: age and age squared, 
.                 gen age = 2018 - ple0010_h
(554 missing values generated)

.                 gen age_sqrd = age^2
(554 missing values generated)

.                 
.                 * Control variables: income, already there; plc0013_h
. 
.                 rename plc0013_h income

.                 
.                 * Control variables: type of emplyoment, reference being full
> -time employed [1]; plb0022_h
.                 rename plb0022_h employment

.                 
.                 * Control variables: marital status , reference being married
> ; pld0131_v1; 
.                 * according to the pap, we merge the first two (married as re
> ference)
.                 * Deviation from the PAP: Same issue as with gender. pld0131_
> h not present.
.                 * Therefore we use pld0131_v1
.                 gen marital_status = .
(1,825 missing values generated)

.                 
.                 * Merge categories 1 and 2 into 1 ("Married")
.                 replace marital_status = 1 if inlist(pld0131_v1, 1, 2)
(758 real changes made)

. 
.                 * Keep others as-is
.                 replace marital_status = pld0131_v1 if !inlist(pld0131_v1, 1,
>  2)
(513 real changes made)

.                 
.                 * Label the new variable
.                 label define marital_lbl 1 "Verheiratet" 3 "Ledig" 4 "Geschie
> den" 5 "Verwitwed"

.                 label values marital_status marital_lbl

.                 label variable marital_status "Marital status (1 = Married)"

.                 
.                 * Control variables: political party supported, reference bei
> ng SPD [1]; plh0012_h
.                 * Deviation from PAP: before this question, it was asked if t
> here was a political leaning (yes and no)
.                 * if yes, they were asked which political party.
.                 * We will use both questions now. If they indicated to have a
>  political leaning, we take the party they favor. 
.                 * Otherwise we make a new category being no political leaning
.                 gen pol_affiliation = .
(1,825 missing values generated)

.                 
.                 replace pol_affiliation = 99 if plh0011_v2 == 2 // those who 
> declared to have no political leaning
(723 real changes made)

.                 label define plh0012_h 99 "[99] keine Präferenz", add // add 
> label to variable

. 
.                 replace pol_affiliation = plh0012_h if plh0011_v2 == 1 // if 
> respondent indicated to have a preference
(541 real changes made)

.                 label values pol_affiliation plh0012_h // copy labels from ha
> rmonized to new one

.                 
.                 
.                 * Control variable: having obtained a university degree; base
> d on pgpbbil02
.                 gen higher_education = .
(1,825 missing values generated)

.                 replace higher_education = 1 if pgpbbil02 > 0
(882 real changes made)

.                 replace higher_education = 0 if pgpbbil02 <= 0 | missing(pgpb
> bil02)
(1,470 real changes made)

.                 
.                 label variable higher_education "Binary if individual obtaine
> d higher education"

.                 
.                 * collect the variables necessary for the analysis
.                 keep pid plh0308_v2 num_daughters num_children sumkids gender
>  age age_sqrd income employment pld0131_v1 marital_status pol_affiliation pgp
> bbil02 higher_education

.                 
. 
.                 save "$DATA/h1_dataset.dta", replace // save preprocessed dat
> aset
