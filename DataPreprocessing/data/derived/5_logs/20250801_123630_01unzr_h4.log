. * ================================================================
. * Data Preparation for H4 (No Changes Needed)
. * ================================================================
. 
. * This script performs the complete data preparation for H4.
. 
. * --- Step 1: Merge the raw data ---
. use "$IN/ppathl.dta", clear
(SOEP-Core, v37 (EU Edition), doi:10.5684/soep.core.v37eu)

. keep pid syear gebjahr sex sampreg corigin

. 
. * Merge with pl to get the dependent variables for H4
. merge 1:1 pid syear using "$IN/pl.dta", nogen keep(master matches) ///
>     keepusing(plh0395i01-plh0395i06)

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                            35,228  
    -----------------------------------------

. 
. * Merge with pgen to get the education control variable
. merge 1:1 pid syear using "$IN/pgen.dta", nogen keep(master matches) ///
>     keepusing(pgbilzeit)
(variable syear was long, now double to accommodate using data's values)

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                            35,228  
    -----------------------------------------

. 
. * Merge with biobirth for IV construction
. sort pid

. merge m:1 pid using "$IN/biobirth.dta", nogen keep(master matches) ///
>     keepusing(sumkids kidsex*)
(variable pid was long, now double to accommodate using data's values)
(label sex already defined)
(label sex_EN already defined)
(label pid_EN already defined)
(label cid_EN already defined)
(label cid already defined)

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                            35,228  
    -----------------------------------------

. 
. * --- Step 2: Clean and Filter the sample for H4 ---
. * Clean Dependent Variables
. foreach var of varlist plh* {
  2.     replace `var' = . if `var' < 1
  3. }
(25,848 real changes made, 25,848 to missing)
(25,839 real changes made, 25,839 to missing)
(25,852 real changes made, 25,852 to missing)
(25,875 real changes made, 25,875 to missing)
(25,838 real changes made, 25,838 to missing)
(25,824 real changes made, 25,824 to missing)

. * Clean Control Variables
. foreach var of varlist sex sampreg pgbilzeit {
  2.     replace `var' = . if `var' < 1
  3. }
(0 real changes made)
(60 real changes made, 60 to missing)
(1,548 real changes made, 1,548 to missing)

. replace corigin = . if corigin < 1
(12 real changes made, 12 to missing)

. gen is_german = (corigin == 1)

. replace is_german = . if corigin == .
(12 real changes made, 12 to missing)

. 
. * Filter the sample (for 2019, adults, parents)
. keep if syear == 2019
(33,208 observations deleted)

. gen age = 2019 - gebjahr

. keep if age >= 18 & age < .
(24 observations deleted)

. keep if sumkids >= 1 & sumkids < .
(539 observations deleted)

. 
. * --- Step 3: Generate analysis variables ---
. gen num_daughters = 0

. forval i = 1/19 {
  2.     local child_num : di %02.0f `i'
  3.     replace num_daughters = num_daughters + 1 if kidsex`child_num' == 2
  4. }
(683 real changes made)
(564 real changes made)
(262 real changes made)
(96 real changes made)
(30 real changes made)
(17 real changes made)
(9 real changes made)
(5 real changes made)
(0 real changes made)
(0 real changes made)
(0 real changes made)
(0 real changes made)
(0 real changes made)
(0 real changes made)
(0 real changes made)
(0 real changes made)
(0 real changes made)
(0 real changes made)
(0 real changes made)

. gen share_daughters = num_daughters / sumkids

. gen age_sq = age^2

. 
. * --- Step 4: Save the final dataset ---
. keep pid syear plh* share_daughters age age_sq sex sampreg is_german pgbilzei
> t

. save "$DATA/h4_data_final.dta", replace
(file C:\Users\dalbrecht\Research
    Projects\ManyDaughters\ManyDaughters_DataPreprocessing/data/derived_confi
    > dential/5%-sample/h4_data_final.dta not found)
file C:\Users\dalbrecht\Research
    Projects\ManyDaughters\ManyDaughters_DataPreprocessing/data/derived_confi
