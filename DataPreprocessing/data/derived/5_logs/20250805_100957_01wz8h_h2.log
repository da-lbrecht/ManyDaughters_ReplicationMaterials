. foreach var in $set1   {
  2.     
.    
.         
.         // Model 1
.         **************************************************************
.         reghdfe `var' at_least_1d $X if `var'>=0 & `var'!=. $w ,  $vce $abs
  3.         scalar N1_`var'=e(N)
  4. 
.                 
.                 ** Store Info
.                 lincom  at_least_1d , level(90)
  5.                 scalar b1_`var'=r(estimate)
  6.                 scalar ub1_`var'=r(ub)
  7.                 scalar lb1_`var'=r(lb)
  8.                 scalar P1_`var'=r(p)
  9.                 scalar se1_`var'=r(se)
 10.                 
.         
.         
