. *****************************************************************************
> ***
. ** Regression
. *****************************************************************************
> ***
. global men_with_d                       "Father with D"

. global men_without_d            "Father without D"

. global female_with_d            "Mother with D"

. 
. 
. *************
. gen men_with_d          =(at_least_1d==1 & female==0)

. gen men_without_d       =(at_least_1d==0 & female==0)

. gen female_with_d       =(at_least_1d==1 & female==1)

. *************
. 
. * Step 1: Run regressions and store estimates
. local i = 1

. local labels

. foreach var in ///
>                                         $set1   ///
>                         {
  2.     
.         gen l`var'=ln(`var')
  3.    
.         // Model 3 - Intenisty of Daughters
.         **************************************************************
.         reghdfe l`var' men_with_d men_without_d female_with_d $X if `var'>=0 
> & `var'!=.  & parents==1 $w , $vce $abs
  4.         scalar N_`var'=e(N)             
  5.         
.         
.                 ** Store Info
.                 foreach v in men_with_d men_without_d female_with_d {
  6.                         lincom  `v' , level(90)
  7.                         scalar b_`v'_`var'=r(estimate)
  8.                         scalar ub_`v'_`var'=r(ub)
  9.                         scalar lb_`v'_`var'=r(lb)
 10.                         scalar P_`v'_`var'=r(p)
 11.                         scalar se_`v'_`var'=r(p)
 12.                 }
 13.                 
.                         lincom men_with_d-men_without_d, level(90)
 14.                         scalar b_D_`var'=r(estimate)
 15.                         scalar ub_D_`var'=r(ub)
 16.                         scalar lb_D_`var'=r(lb)
 17.                         scalar P_D_`var'=r(p)
 18.                         scalar se_D_`var'=r(p)
 19.         
.         drop l`var'
 20.                 
.         ** store description of variable
.         *local xx : variable label `var'
.         *global `var' "`xx'"                    
.         
.         
