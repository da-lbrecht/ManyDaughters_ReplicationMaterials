. * ============================================
. * STEP 6: Prepare for Cross-Section
. * ============================================
. 
. gen pre = (rel_year < 0)

. gen post1 = (rel_year > 0)

. egen ever_pre = max(pre), by(pid)

. egen ever_post = max(post1), by(pid)

. gen include_in_did = (ever_pre == 1 & ever_post == 1)

. 
. * Cross-section flags
. gen relevant_post_polpref = rel_year if rel_year > 0 & !missing(political_pre
> f)
(21,151 missing values generated)

. egen latest_post_polpref = max(relevant_post_polpref), by(pid)
(5,032 missing values generated)

. gen relevant_for_cs_pref = (latest_post_polpref == rel_year)

. 
. gen relevant_post_partyid = rel_year if rel_year > 0 & !missing(party_ideolog
> y)
(16,215 missing values generated)

. egen latest_post_partyid = max(relevant_post_partyid), by(pid)
(7,994 missing values generated)

. gen relevant_for_cs_id = (latest_post_partyid == rel_year)

. 
. * ============================================
. * STEP 7: Prepare for Difference-in-Differences Estimation
. * ============================================
. 
. * A) DiD flags for political_pref
. gen rel_pre_polpref = rel_year if rel_year < 0 & include_in_did == 1 & !missi
> ng(political_pref)
(24,340 missing values generated)

. gen rel_post_polpref = rel_year if rel_year > 0 & include_in_did == 1 & !miss
> ing(political_pref)
(24,255 missing values generated)

. egen closest_pre_polpref = max(rel_pre_polpref), by(pid)
(23,174 missing values generated)

. 
. gen keep_pre_polpref = (rel_year == closest_pre_polpref & rel_year < 0 & incl
> ude_in_did == 1)

. gen keep_post_polpref = (rel_year == latest_post_polpref & rel_year > 0 & inc
> lude_in_did == 1)

. gen observations_for_dif_polpref = inlist(1, keep_pre_polpref, keep_post_polp
> ref)

. sum observations_for_dif_polpref if observations_for_dif_polpref == 1

    Variable |        Obs        Mean    Std. dev.       Min        Max
-------------+---------------------------------------------------------
observatio~f |        212           1           0          1          1

. scalar num_two_obs_A = r(N)

. display "num_two_obs_A = " num_two_obs_A
num_two_obs_A = 212

. 
. * B) DiD flags for party_ideology
. gen rel_pre_partyid = rel_year if rel_year < 0 & include_in_did == 1 & !missi
> ng(party_ideology)
(24,147 missing values generated)

. gen rel_post_partyid = rel_year if rel_year > 0 & include_in_did == 1 & !miss
> ing(party_ideology)
(24,139 missing values generated)

. egen closest_pre_partyid = max(rel_pre_partyid), by(pid)
(23,193 missing values generated)

. 
. gen keep_pre_partyid = (rel_year == closest_pre_partyid & rel_year < 0 & incl
> ude_in_did == 1)

. gen keep_post_partyid = (rel_year == latest_post_partyid & rel_year > 0 & inc
> lude_in_did == 1)

. gen observations_for_dif_partyid = inlist(1, keep_pre_partyid, keep_post_part
> yid)

. sum observations_for_dif_partyid if observations_for_dif_partyid == 1

    Variable |        Obs        Mean    Std. dev.       Min        Max
-------------+---------------------------------------------------------
observatio~d |        176           1           0          1          1

. scalar num_two_obs_B = r(N)

. display "num_two_obs_B = " num_two_obs_B
num_two_obs_B = 176

