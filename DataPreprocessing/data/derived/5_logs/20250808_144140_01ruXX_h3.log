.         * Original code: in hours
. 
.         recode pli0044_h  (-5=.) (-3=.) (-2=.) (-1=.), generate(child_care_ho
> urs)
(1,324 differences between pli0044_h and child_care_hours)

.         
.         recode sex (2=0), generate(man)
(14,192 differences between sex and man)

.         
.         * Calculate what "equal" would be (overall population mean)
.         quietly sum child_care_hours

.         scalar equal_share = r(mean)

. 
.         * Create equality measure (DV)
.         gen equality_measure = cond(man == 1, ///
>                 child_care_hours - equal_share, ///  
>                 equal_share - child_care_hours)      
(1,609 missing values generated)

.                 
.         * controls (rename)
.         
.         rename pglabnet income

.         
.         rename pgstib occup_position

.         
.         rename pgbilzeit years_educ

. 
. 
. * HYPOTHESIS TEST FOR H3 * 
. 
.         * H3 tests whether Having daughters leads to more gender equality in 
> the household (as measured by behaviors or outcomes).
.         * The dependent variable in the individual deviation from gender-equa
> l childcare arrangements
.         * the expectation is a positive coefficient (men doing more than the 
> equal share, women doing less than the equal share)
. 
.         local controls "gebjahr years_educ income occup_position sumkids"

.         
.         reg equality_measure d_daughter `controls', robust

