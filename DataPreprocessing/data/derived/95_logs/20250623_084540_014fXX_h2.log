. 
.     // Model 4: full (all interactions + controls)
.      *logit left_pol_preference i.firstborn_child_female##i.firstborn_age_gro
> up_2019 respondent_female i.education_level age_2019 age_square_2019 [pweight
> =phrf], cluster(hid)
. 
. * EXTRACT AND EXPORT RESULTS * (Please check whether the suggested code autom
> atically picks up the correct statistics for your chosen regression analysis 
> and adapt if needed)
. 
.         * Extract the required statistics
. 
.                 * (i) coefficient estimate
.                 local coefficient = _b[firstborn_child_female]

. 
.                 * (ii) standard error
.                 local se = _se[firstborn_child_female]

. 
.                 * (iii) family of the test statistic (e.g. z, t, F, Chi²)
.                 local test_stat_family = "z"

. 
.                 * (iv) residual and model degrees of freedom (DFs) if applica
> ble
.                 *in logistic regression estimation is by maximum likelihood;
.                 *Stata does not define or store a residual degrees of freedom
>  in the same way, so e(df_r) is missing.
.                 *That slot is not applicable
.                 local df_residual = "Not applicable for logit regression"

.                 local df_model = e(df_m)

.                 
.                 
.                 * (v) p-value
.                 
.                 local z = _b[firstborn_child_female] / _se[firstborn_child_fe
> male]

.         local p_value = 2 * normal(-abs(`z'))

. 
.                 * (vi) number of observations
.                 local num_obs = e(N)

. 
.                 * (vii) number of participants
.                 quietly levelsof pid if e(sample), local(participants)

.                 local num_participants : word count `participants'

. 
.                 * (viii) interpretation of directionality
.                 scalar coef_firstborn_child_female = _b[firstborn_child_femal
> e]

.                 local interpretation "positive coefficient is in line with hy
> pothesis"

