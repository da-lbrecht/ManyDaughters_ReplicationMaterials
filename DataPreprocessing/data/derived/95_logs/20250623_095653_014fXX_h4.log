.          * Model 1: daughter only
.       *reg support_h4 ib0.firstborn_child_female [aweight=phrf], cluster(hid)
. 
.      // Model 3: + age-group interactions
.       * reg support_h4 ib0.firstborn_child_female##i.firstborn_age_group_2018
>  [aweight=phrf], cluster(hid)
. 
.     // Model 4: full (all interactions + controls)
.      *reg support_h4 ib0.firstborn_child_female##i.firstborn_age_group_2018##
> ib0.respondent_male i.education_level age_2018 age_square_2018 [aweight=phrf]
> , cluster(hid)
. 
. * EXTRACT AND EXPORT RESULTS * (Please check whether the suggested code autom
> atically picks up the correct statistics for your chosen regression analysis 
> and adapt if needed)
. 
.         * Extract the required statistics
. 
.                 * (i) coefficient estimate
.                 local coefficient = _b[1.firstborn_child_female#1.respondent_
> male]

. 
.                 * (ii) standard error
.                 local se = _se[1.firstborn_child_female#1.respondent_male]

. 
.                 * (iii) family of the test statistic (e.g. z, t, F, Chi²)
.                 local test_stat_family = "t"

. 
.                 * (iv) residual and model degrees of freedom (DFs) if applica
> ble
.                 local df_residual = e(df_r)

.                 local df_model = e(df_m)

. 
.                 * (v) p-value
.                 local p_value = _b[1.firstborn_child_female#1.respondent_male
> ] / _se[1.firstborn_child_female#1.respondent_male]

.                 local p_value = 2 * ttail(e(df_r), abs(`p_value'))

. 
.                 * (vi) number of observations
.                 local num_obs = e(N)

. 
.                 * (vii) number of participants
.                 quietly levelsof pid if e(sample), local(participants)

.                 local num_participants : word count `participants'

. 
.                 * (viii) interpretation of directionality
.                 scalar coef_interaction = _b[1.firstborn_child_female#1.respo
> ndent_male]

.                 local interpretation "positive coefficient is in line with hy
> pothesis"

. 
