. * Marital status
. *clean marital status (collapse all others to not married)
. replace pgfamstd = 0 if pgfamstd != 1 & !missing(pgfamstd) 
(35,060 real changes made)

. 
. * --- Assign continent codes based on country of origin (corigin) ---
. gen byte birth_continent = .
(113,825 missing values generated)

. 
. * Europe
. replace birth_continent = 1 if inlist(corigin, 1, 3, 4, 5, 6, 10, 11, 14, 15,
>  21, 22, 26, 28, 29, 31, 32, 41, 73, 74, 75, 76, 78, 113, 118, 119, 120, 121,
>  122, 123, 132, 140, 143, 146, 148, 152, 165, 196)
(96,551 real changes made)

