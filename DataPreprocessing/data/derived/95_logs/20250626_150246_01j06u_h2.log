. 
. * Time-varying count of kids up to and including current year
. gen num_kids = 0

. foreach i of numlist 1/13 {
  2.     local birthvar = "kidgeb" + string(`i', "%02.0f")
  3.     gen kid`i'_born = (`birthvar' <= syear) & !missing(`birthvar')
  4.     replace num_kids = num_kids + kid`i'_born
  5. }
