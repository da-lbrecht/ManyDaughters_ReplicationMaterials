(37,374 real changes made, 37,374 to missing)

. gen avg_h_children = (pli0055 + pli0057 + pli0046*5)/7 if pli0055!=. & pli005
> 7!=. & pli0046!=. 
(280,110 missing values generated)

. 
. gen avg_h_chores_children = avg_h_chores + avg_h_children
(281,972 missing values generated)

. 
.         * gender 1st child
. gen daughter=1 if kidsex01==2
(229,481 missing values generated)

. replace daughter=0 if kidsex01==1
(229,481 real changes made)

