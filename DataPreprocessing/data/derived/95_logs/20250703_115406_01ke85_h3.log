. * GENERATE VARIABLES * 
. 
.         * Outcome: Gender equality in the household (as measured by behaviors
>  or outcomes)
. 
.         // We generate a variable to measure housework hours
.         gen housework = .
(663,123 missing values generated)

.         replace housework = pli0043_h if pli0043_h  > -1
(493,472 real changes made)

. 
.         // We generate a couple id 
.         gen coupleid = pid if sex == 1 & parid > 0 & parid != .
(458,383 missing values generated)

.         replace coupleid = parid if sex == 2 & parid > 0 & parid != .
(208,915 real changes made)

. 
.         // We generate the housework of the wife
.         sort coupleid syear

.         gen     partner_housework =     housework if sex == 2 & housework > -
> 1 & housework < 100        
(400,465 missing values generated)

.         by coupleid syear: egen housework_wf = max(partner_housework) if coup
> leid != .  
(325,462 missing values generated)

.         drop partner_housework

.         label variable housework_wf "Housework hours of the female partner"

. 
.         // We calculate the housework shares of the husband
.         gen total_housework = .
(663,123 missing values generated)

.         replace total_housework = housework + housework_wf if housework != . 
> & housework_wf  != . & sex == 1
(151,319 real changes made)

.         label variable total_housework "Total housework of both partners"

.         gen husband_hw_share = (housework / total_housework) if housework != 
> . & total_housework  != . & sex == 1
(512,489 missing values generated)

.         label variable husband_hw_share "Housework share of husband"

. 
.         // We generate the absolute housework difference, where values closer
>  to 0 indicate equality
.         gen abs_gap_housework = abs(housework - housework_wf) if sex ==1 & co
> upleid !=.
(511,804 missing values generated)

.         label variable abs_gap_housework "Absolute housework gap (husband hou
> sework - wife housework)"

.         
.         // We reverse code the housework gap, negative values = inequality, 0
>  = equality
.         gen hh_gender_equal = .
(663,123 missing values generated)

.         replace  hh_gender_equal = abs_gap_housework*(-1)
(151,319 real changes made)

.         label variable hh_gender_equal "Gender equality in the household (bas
> ed on husband housework - wife housework)"

. 
.         // We topcode the housework gap, differences of 10 hours or more as t
> hreshold
.         replace hh_gender_equal =-10 if hh_gender_equal <-10
(164 real changes made)

.         
