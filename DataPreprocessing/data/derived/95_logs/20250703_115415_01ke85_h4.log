.         label values d_daughter d_daughter

. 
.         * Additional variables 
.         
.         // We generate a variable for age
.         gen age = (syear - gebjahr) if syear > 0 & syear != . & gebjahr > 0 &
>   gebjahr!=.
(8 missing values generated)

.         label var age "Age"

.         
.         // We generate a variable for age squared
.         gen age_sq = age*age
(8 missing values generated)

.         label var age_sq "Age, squared"

.         
.         // We generate a variable for the gender that is 1 for men and 0 for 
> women
.         recode sex (2=0 "Female") (1=1 "Male"), gen(d_male)
(343,767 differences between sex and d_male)

.         label var d_male "Dummy: Male"

. 
.         // We make sure that the variable d_male has only two values
.         replace d_male =. if d_male <0
(13 real changes made, 13 to missing)

.         replace d_male =. if d_male >1 & sex !=.
(0 real changes made)

