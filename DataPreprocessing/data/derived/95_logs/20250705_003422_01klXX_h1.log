file C:\Users\dalbrecht\Research
    Projects\ManyDaughters\ManyDaughters_DataPreprocessing/data/derived_confi
    > dential/95%-sample/h1_dataset.dta saved

. 
. 
. * ============================
. * Analysis
. * ============================
. 
. * FILTERS *
. 
.         * only keep participants with kids
.         keep if sumkids > 0 & !missing(sumkids)
(216,191 observations deleted)

.         * only keep participants with kids in survey year
.         keep if kidgeb01 < syear & kidgeb01 > 0
(23,363 observations deleted)

.         * only keep participants with information on sex of first child
.         keep if kidsex01 > 0
(241 observations deleted)

. 
.         
. * GENERATE VARIABLES *
. 
.         * generate variable for number of kids in survey year
.         gen n_kids = 1

.         replace n_kids = 2 if kidgeb02 < syear & kidgeb02 > 0
(299,986 real changes made)

.         replace n_kids = 3 if kidgeb03 < syear & kidgeb03 > 0
(119,414 real changes made)

.         replace n_kids = 4 if kidgeb04 < syear & kidgeb04 > 0
(40,856 real changes made)

.         replace n_kids = 5 if kidgeb05 < syear & kidgeb05 > 0
(14,802 real changes made)

.         replace n_kids = 6 if kidgeb06 < syear & kidgeb06 > 0
(5,982 real changes made)

.         replace n_kids = 7 if kidgeb07 < syear & kidgeb07 > 0
(2,620 real changes made)

.         replace n_kids = 8 if kidgeb08 < syear & kidgeb08 > 0
(1,136 real changes made)

.         replace n_kids = 9 if kidgeb09 < syear & kidgeb09 > 0
(521 real changes made)

.         replace n_kids = 10 if kidgeb10 < syear & kidgeb10 > 0
(289 real changes made)

.         replace n_kids = 11 if kidgeb11 < syear & kidgeb11 > 0
(165 real changes made)

.         replace n_kids = 12 if kidgeb12 < syear & kidgeb12 > 0
(45 real changes made)

.         replace n_kids = 13 if kidgeb13 < syear & kidgeb13 > 0
(1 real change made)

.         replace n_kids = 14 if kidgeb14 < syear & kidgeb14 > 0
(1 real change made)

.         replace n_kids = 15 if kidgeb15 < syear & kidgeb15 > 0
(0 real changes made)

.         replace n_kids = 16 if kidgeb16 < syear & kidgeb16 > 0
(0 real changes made)

.         replace n_kids = 17 if kidgeb17 < syear & kidgeb17 > 0
(0 real changes made)

.         replace n_kids = 18 if kidgeb18 < syear & kidgeb18 > 0
(0 real changes made)

.         replace n_kids = 19 if kidgeb19 < syear & kidgeb19 > 0
(0 real changes made)

.         label variable n_kids "Number of kids in survey year"

. 
.         * generate dummy variable for whether participant has at least one da
> ughter (1) or not (0)
.         gen d_daughter = 0

.         replace d_daughter = 1 if (kidsex01 == 2 & n_kids >= 1) | (kidsex02 =
> = 2 & n_kids >= 2) | (kidsex03 == 2 & n_kids >= 3) | (kidsex04 == 2 & n_kids 
> >= 4) | (kidsex05 == 2 & n_kids >= 5) | (kidsex06 == 2 & n_kids >= 6) | (kids
> ex07 == 2 & n_kids >= 7) | (kidsex08 == 2 & n_kids >= 8) | (kidsex09 == 2 & n
> _kids >= 9) | (kidsex10 == 2 & n_kids >= 10) | (kidsex11 == 2 & n_kids >= 11)
>  | (kidsex12 == 2 & n_kids >= 12) | (kidsex13 == 2 & n_kids >= 13) | (kidsex1
> 4 == 2 & n_kids >= 14) | (kidsex15 == 2 & n_kids >= 15) | (kidsex16 == 2 & n_
> kids >= 16) | (kidsex17 == 2 & n_kids >= 17) | (kidsex18 == 2 & n_kids >= 18)
>  | (kidsex19 == 2 & n_kids >= 19)
(298,794 real changes made)

.         label variable d_daughter "Dummy variable for whether participant has
>  at least one daughter (1) or not (0)"

. 
.         * generate dummy variable for female (0) or male (1) gender
.         gen d_sex = 0 if sex == 2
(187,238 missing values generated)

.         replace d_sex = 1 if sex == 1
(187,234 real changes made)

.         label variable d_sex "Dummy variable for female (0) or male (1) gende
> r"

. 
.         * generate variable for age in survey year
.         gen age = syear - gebjahr

.         label variable age "Age in survey year"

. 
.         * generate variable for support for gender equality (as measured by a
> ttitudes)
.         gen support_gender_equality = 1 if lb1120 == 1
(420,271 missing values generated)

.         replace support_gender_equality = 2/3 if lb1120 == 2
(2,342 real changes made)

.         replace support_gender_equality = 1/3 if lb1120 == 3
(2,019 real changes made)

.         replace support_gender_equality = 0 if lb1120 == 4
(642 real changes made)

.         label variable support_gender_equality "Support for gender equality"

. 
. 
. * HYPOTHESIS TEST FOR H1 *
. 
.         * linear OLS regression
. 
.         * as measure of support for gender equality (hypothesis 1), we use th
> e question "Fam: Man/Women Equal in Household/Family and Job" (lb1120); if ag
> reeing to this statement, we assume the respondent is more likely to support 
> gender equality
.         * we run a linear OLS regression analysis with lb1120, recoded to ran
> ge between 0 (completely disagree) and 1 (agree completely), as dependent var
> iable, and the dummy variable d_daughter as independent variable, controlling
>  for number of kids (n_kids), gender (d_sex), age (age), and survey year (sye
> ar) fixed effects, with robust standard errors clustered at the household (hi
> d) level
. 
.         reg support_gender_equality d_daughter n_kids d_sex age i.syear, clus
> ter(hid)

Linear regression                               Number of obs     =      8,060
                                                F(7, 4982)        =      35.31
                                                Prob > F          =     0.0000
                                                R-squared         =     0.0287
                                                Root MSE          =     .31992

                                (Std. err. adjusted for 4,983 clusters in hid)
------------------------------------------------------------------------------
             |               Robust
support_ge~y | Coefficient  std. err.      t    P>|t|     [95% conf. interval]
-------------+----------------------------------------------------------------
  d_daughter |   .0060998   .0091511     0.67   0.505    -.0118404    .0240399
      n_kids |  -.0423828   .0038955   -10.88   0.000    -.0500197    -.034746
       d_sex |  -.0638564   .0065416    -9.76   0.000    -.0766808    -.051032
         age |   .0023806   .0005163     4.61   0.000     .0013684    .0033928
             |
       syear |
       2011  |   .0172035   .0108517     1.59   0.113    -.0040706    .0384776
       2012  |   .0947388   .0195172     4.85   0.000     .0564764    .1330012
       2013  |   .0473568   .0444157     1.07   0.286    -.0397175    .1344311
             |
       _cons |    .674171    .019624    34.35   0.000     .6356994    .7126427
------------------------------------------------------------------------------

. 
. 
. * EXTRACT AND EXPORT RESULTS *
. 
.         * Extract the required statistics
. 
.                 * (i) coefficient estimate
.                 local coefficient = _b[d_daughter]

. 
.                 * (ii) standard error
.                 local se = _se[d_daughter]

. 
.                 * (iii) family of the test statistic (e.g. z, t, F, Chi²)
.                 local test_stat_family = "t"

. 
.                 * (iv) residual and model degrees of freedom (DFs) if applica
> ble
.                 local df_residual = e(df_r)

.                 local df_model = e(df_m)

. 
.                 * (v) p-value
.                 local p_value = _b[d_daughter] / _se[d_daughter]

.                 local p_value = 2 * ttail(e(df_r), abs(`p_value'))

. 
.                 * (vi) number of observations
.                 local num_obs = e(N)

. 
.                 * (vii) number of participants
.                 quietly levelsof pid if e(sample), local(participants)

.                 local num_participants : word count `participants'

. 
.                 * (viii) interpretation of directionality
.                 scalar coef_d_daughter = _b[d_daughter]

.                 local interpretation "positive coefficient is in line with hy
> pothesis"

. 
.         // Display the saved statistics
.         di "Coefficient: `coefficient'"
Coefficient: .0060997574839175

.         di "Standard Error: `se'"
Standard Error: .0091511027246643

.         di "Test Statistic Family: `test_stat_family'"
Test Statistic Family: t

.         di "Residual Degrees of Freedom: `df_residual'"
Residual Degrees of Freedom: 4982

.         di "Model Degrees of Freedom: `df_model'"
Model Degrees of Freedom: 7

.         di "p-value: " `p_value'
p-value: .5050842

.         di "Number of observations: " `num_obs'
Number of observations: 8060

.         di      "Number of participants: " `num_participants'
Number of participants: 8053

.         di "Interpretation of directionality: " "`interpretation'"
Interpretation of directionality: positive coefficient is in line with hypothes
> is

. 
.         * Export results to csv 
.         file open myfile using "$OUT/h1_results.csv", write replace
(file C:\Users\dalbrecht\Research
    Projects\ManyDaughters\ManyDaughters_DataPreprocessing/data/derived/95_re
    > sults/h1_results.csv not found)

.         file write myfile "coefficient,se,family,residual_df,model_df,p_value
> ,num_obs,num_participants,interpretation" _n

.         file write myfile "`coefficient', `se', `test_stat_family', `df_resid
> ual', `df_model',`p_value',`num_obs',`num_participants',`interpretation'" _n

.         file close myfile

. 
. 
. *****************************************************************************
> ***
. 
. exit

end of do-file

