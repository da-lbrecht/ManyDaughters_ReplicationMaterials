. do "20250706_003444_01i1XX_h3.do"

. *****************************************************************************
> ***
. ****************** Do-File H3: #ManyDaughters Project ******************
. *** Having daughters leads to more gender equality in the household (as measu
> red by behaviors or outcomes)
. *****************************************************************************
> ***
. 
. * Authors: 
. 
. * ============================
. * Setup * (Please adapt according to your needs)
. * ============================
. 
. * clear all
. version 15.1 

. set maxvar 10000 


. 
. * INSTALL PACKAGES * 
. * install all packages you need here, for example:
. 
. * ssc install drdid
. * ssc install csdid
. * ssc install outreg2
. 
. // cd "/Users/dedelong/Documents/#ManyDaughters_RT_AnalysisPackage/code" //co
> mmented by David Albrecht on 07.07.2025
. 
. * CONFIGURE FILE PATHS * (Please do not change)
. /*
> * the following code automatically sets paths based on where you saved the di
> stributed file-package on your system *
> if strpos("`c(pwd)'", "code") {
>     global ROOT "`c(pwd)'/.."
> }
> else {
>     global ROOT "`c(pwd)'"
> }
> 
> global IN "$ROOT/data/raw" // folder, in which the original datasets are stor
> ed
> global DATA "$ROOT/data/derived" // folder for datasets
> global OUT "$ROOT/out" // folder for output (results, tables)
> 
> */
. 
. * ============================
. * Data Preparation * 
. * ============================
. 
. * LOAD AND MERGE DATA * (Please adapt according to your needs)
. 
. use "$IN/ppathl.dta", clear // use ppathl as a starting dataset
(SOEP-Core, v37 (EU Edition), doi:10.5684/soep.core.v37eu)

. 
. * Merge ppathl with all datasets, that you deem relevant for your analysis. (
> Tip: use keepusing() to specify which variables to keep from the using datase
> t; the default is all.)
. 
. * biobirth contains information on fertility history
. merge m:1 pid using "$IN/biobirth.dta", nogen keep(master matches)
(variable pid was long, now double to accommodate using data's values)
(variable cid was long, now double to accommodate using data's values)
(variable gebjahr was int, now double to accommodate using data's values)
(label sex already defined)
(label sex_EN already defined)

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                           663,123  
    -----------------------------------------

. * pgen contains user-friendly data on the individual level that are consolida
> ted from different sources
. merge 1:1 pid syear using "$IN/pgen.dta", nogen keep(master matches)
(variable syear was long, now double to accommodate using data's values)

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                           663,123  
    -----------------------------------------

. * pl contains all variables from the individual questionnaire
. merge 1:1 pid syear using "$IN/pl.dta", nogen keep(master matches)
(variable inputdataset was str6, now str9 to accommodate using data's values)
(label cid_EN already defined)
(label pid_EN already defined)
(label cid already defined)

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                           663,123  
    -----------------------------------------

. * hgen contains generated variables on household level from the household int
> erview; use for household net income
. merge m:1 hid syear using "$IN/hgen.dta", nogen keep(master matches) keepusin
> g(hid syear hghinc)
(label iyear already defined)
(label iyear_EN already defined)

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                           663,123  
    -----------------------------------------

. 
. label language EN // change language of the labels to English

. 
. save "$DATA/h3_dataset.dta", replace // save merged dataset
file C:\Users\dalbrecht\Research
    Projects\ManyDaughters\ManyDaughters_DataPreprocessing/data/derived_confi
    > dential/95%-sample/h3_dataset.dta saved

. 
. * ============================
. * Analysis
. * HYPOTHESIS TEST FOR H3 * 
. * ============================
. 
. * use "$DATA/h3_dataset.dta", replace
. *--------------------------------------------
. * GENERATE DEPENDENT VARIABLES * 
. *--------------------------------------------
. * Generate the dependent variable
. ** pli0043_h: hours spent on housework during weekdays
. 
. gen housework_hours = .
(663,123 missing values generated)

. replace housework_hours = pli0043_h if inrange(pli0043_v3, 0, 24)
(493,472 real changes made)

. 
. *--------------------------------------------
. * GENERATE INDEPENDENT VARIABLES: Having Daughters
. *--------------------------------------------
. * 1. Find the year of first daughter for each individual
. gen first_daughter_year = .
(663,123 missing values generated)

. 
. foreach i of numlist 1/19 {
  2.     local j : display %02.0f `i'
  3.     quietly replace first_daughter_year = kidgeb`j' if ///
>         kidsex`j' == 2 & ///
>         inrange(kidgeb`j', 1900, 2025) & ///
>         (missing(first_daughter_year) | kidgeb`j' < first_daughter_year)
  4. }

. 
. * 2. Treatment indicator: 1 if ever had a daughter, 0 otherwise
. gen treated = !missing(first_daughter_year)

. 
. * 3. years at or after first daughter
. gen post = syear >= first_daughter_year if treated == 1
(345,723 missing values generated)

. replace post = 0 if treated == 0
(345,723 real changes made)

. 
. * 4. interaction term treat_post
. gen treat_post = treated * post

. 
. *--------------------------------------------
. * GENERATE ADDITIONAL CONTROLS
. *--------------------------------------------
. 
. * Education: Replace negative codes with missing 
. gen edu_years = pgbilzeit
(143,310 missing values generated)

. replace edu_years = . if inlist(edu_years, -1, -2)
(28,524 real changes made, 28,524 to missing)

. 
. * Employment status
. 
. gen employment_status = .
(663,123 missing values generated)

. 
. * Assign values
. replace employment_status = 1 if pgemplst == 1   // Full-time
(194,990 real changes made)

. replace employment_status = 2 if pgemplst == 2   // Regular part-time
(64,496 real changes made)

. replace employment_status = 3 if pgemplst == 3   // Vocational training
(13,966 real changes made)

. replace employment_status = 4 if pgemplst == 4   // Irregular part-time
(27,747 real changes made)

. replace employment_status = 5 if pgemplst == 5   // Not employed
(217,916 real changes made)

. replace employment_status = 6 if pgemplst == 6   // Sheltered workshop
(656 real changes made)

. 
. * Handle invalid/missing codes
. replace employment_status = . if inlist(pgemplst, -2)
(0 real changes made)

. 
. * Add labels
. label define empstat_lbl ///
>     1 "Full-time" ///
>     2 "Part-time (regular)" ///
>     3 "Vocational training" ///
>     4 "Part-time (irregular)" ///
>     5 "Not employed" ///
>     6 "Sheltered workshop"

. 
. *--------------------------------------------
. * I estimate a difference-in-differences (DID) model with multiple time perio
> ds 
. * using the estimator proposed by Callaway and Sant’Anna (2021).
. * The outcome variable is pli0043_h housework_hours, which measures the numbe
> r of hours an individual spends on housework during weekdays.
. * This serves as a measure of gender equality in the household (based on beha
> viors or outcomes), consistent with Hypothesis 2 (H2).
. 
. * The treatment year is defined as the first year an individual has a daughte
> r (treat_year). 
. * Individuals who never have a daughter are assigned as untreated (control gr
> oup).
. * I control for time trends (via time(syear)) and individual covariates (edu_
> years and employment_status).
. * The longdid option computes a long-difference estimator that pools across g
> roups and timing.
. *--------------------------------------------
. 
. 
. gen treat_year = first_daughter_year
(345,723 missing values generated)

. replace treat_year = . if treated == 0
(0 real changes made)

. 
. * Estimate DID with multiple time periods 
. * Use estat simple to obtain average treatment effect
. csdid housework_hours, time(syear) gvar(treat_year) ///
>       covariates(edu_years employment_status) ///
>       cluster(pid) atet longdid
