.                 keep if kidgeb01 != -2  //these persons never have children. 
(216,061 observations deleted)

.                 drop if kidgeb01 < 0 //Also drop [-1] No Answer [-2] Does not
>  apply [-3] Answer improbable
(1,011 observations deleted)

.                 
. 
.                 *Drop years before child1 was born
.                 drop if syear < kidgeb01 
(17,457 observations deleted)

. 
. 
.                 *(1b) Keep only if sex of child is known 
.                 drop if kidsex01 < 0 // missings 
(256 observations deleted)

. 
.         
.                 *(2) have one child only (dropped once second child arrives).
>  Except if twins, then counted as 'having daughter' if both of them are girls
>  
. 
.                 gen twins = 1 if kidgeb01==kidgeb02 & kidmon01==kidmon02 & ki
> dgeb02 != -2 //month and year of birth same, and second child present. 
(423,149 missing values generated)

.                 drop if twins==1 & kidsex02 < 0 // if 2nd twins gender unknow
> n 
(0 observations deleted)

.                 
.                 drop if syear > kidgeb02 & twins !=1  //drop observations (su
> rveyyears) once 2nd child is born (except first child is twin)
(408,265 observations deleted)

.                 drop if syear > kidgeb03 & twins ==1 //drop observations (sur
> veyyears) once 3rd child is born (if first child is twin)
(5,061 observations deleted)

. 
. 
. * GENERATE VARIABLES * 
. 
.         *(1)generate dummy variable for participants sex
.         fre sex

sex -- Gender
------------------------------------------------------------------
                     |      Freq.    Percent      Valid       Cum.
---------------------+--------------------------------------------
Valid   1 [1] Male   |       7002      46.64      46.64      46.64
        2 [2] Female |       8010      53.36      53.36     100.00
        Total        |      15012     100.00     100.00           
------------------------------------------------------------------

.         gen d_sex = sex-1

.         fre d_sex

d_sex
-----------------------------------------------------------
              |      Freq.    Percent      Valid       Cum.
--------------+--------------------------------------------
Valid   0     |       7002      46.64      46.64      46.64
        1     |       8010      53.36      53.36     100.00
        Total |      15012     100.00     100.00           
-----------------------------------------------------------

.         label variable d_sex "Sex of participants (0=Male, 1=Female)"

. 
.         *(2)Generate dummy variable for whether participant`s child is a girl
>  (1) or boy (0)
.         gen d_daughter = 1 if kidsex01== 2 //girl
(7,606 missing values generated)

.         replace d_daughter=0 if kidsex01==1 //boy       
(7,606 real changes made)

.         drop if twins==1 & d_daughter==0 & kidsex02==2 //drop if first child 
> is boy, but second twin is girl 
(24 observations deleted)

.         drop if twins==1 & d_daughter==1 & kidsex02==1 //drop if first child 
> is girl, but second twin is boy 
(12 observations deleted)

.         label variable d_daughter "Sex of first child (0=son, 1=daughter)"

.         fre d_daughter

d_daughter -- Sex of first child (0=son, 1=daughter)
-----------------------------------------------------------
              |      Freq.    Percent      Valid       Cum.
--------------+--------------------------------------------
Valid   0     |       7582      50.63      50.63      50.63
        1     |       7394      49.37      49.37     100.00
        Total |      14976     100.00     100.00           
-----------------------------------------------------------

.         
.         *(3)Construct total hours respondent does childcare, errands, housewo
> rk: 'CareAndHouse'                 
.         gen CaH1 = pli0044_v3 if pli0044_v3 >= 0 //Childcare during week
(1,588 missing values generated)

.         gen CaH2 = pli0040 if pli0040 >= 0       //errands during week
(2,072 missing values generated)

.         gen CaH3 = pli0043_h if pli0043_h >= 0   //housework during week
(1,995 missing values generated)

. 
.                 *Keep only persons with all items answered:
.                 egen rownonmiss =  rownonmiss(CaH1 CaH2 CaH3)

.                 keep if rownonmiss==3
(2,664 observations deleted)

.                 
.                 *Construct variable indicating 
.                 egen CareAndHouse =  rowtotal(CaH1 CaH2 CaH3)  

.                 
. 
.         *(4)Construct variable for 'relative' hours (comparing partners hours
>  to each other) 
. 
.                 *First identify partners (pgpartnr). Partners need to be in t
> he same household.
.                 keep if !missing(pgpartz) & pgpartz != 0 & pgpartz != 9 //if 
> pgpartz is 0, or [9] no partner (identified) 
(922 observations deleted)

.                 *If PGPARTZ is coded 1, 2, 3 or 4, a partnership was defined 
> and PGPARTNR is then assigned the value of the unchanging person ID number (=
> PERSNR) of the partner.
.                 drop if pgpartz==5 //drop also if PGPARTZ==5 (pgpartnr is the
> n -2)
(1 observation deleted)

. 
.                 *Generate 'partnermerge' that assigns couples the same id, wh
> ich corresponds either to theirs or their partners pid.
.                 gen partnermerge =      .
(11,389 missing values generated)

.                 replace partnermerge = pid  if pid < pgpartnr
(6,030 real changes made)

.                 replace partnermerge = pgpartnr if pgpartnr < pid
(5,359 real changes made)

. 
.                 *partners should also be in the same household:
.                 gen notsamehouse= 1 if partnermerge==partnermerge[_n+1] & hid
>  != hid[_n+1]
(11,333 missing values generated)

.                 drop if notsamehouse== 1 & (syear==syear[_n+1] | syear==syear
> [_n-1])
(4 observations deleted)

. 
. 
.                 *create variable 'partners_CareAndHouse' indicating partners 
> hours
.                 bysort partnermerge syear: gen partners_CareAndHouse = CareAn
> dHouse[_n+1] if syear==syear[_n+1]
(6,792 missing values generated)

.                 bysort partnermerge syear: replace partners_CareAndHouse = Ca
> reAndHouse[_n-1] if syear==syear[_n-1] & missing(partners_CareAndHouse)
(4589 real changes made)

. 
. 
.                 *How much hours each partner spends relative to the other (ma
> inly to identify if both partners have a value)
.                 *Then take Latest survey year which has info on relative_h 
.                 gen relative_h = (CareAndHouse*100)/(CareAndHouse + partners_
> CareAndHouse) 
(2,207 missing values generated)

.                 sort partnermerge syear

.                 
.                 keep if !missing(relative_h)
(2,207 observations deleted)

.                 bysort partnermerge syear: gen n_partner = _N

.                 keep if n_partner == 2 //keep only years in which both couple
> s present
(8 observations deleted)

. 
.                 bysort partnermerge (syear): gen latest = syear == syear[_N] 
>  //identify latest year==1 

.                 keep if latest==1
(5,786 observations deleted)

. 
. 
.         *(5)Create the IV: `equality' (equality in the household)
.         *We want 1 to be fully equal, so:  1-   (|(my hours/total)-0.5 | *2)
.         * 1- (|(CareAndHouse/(CareAndHouse + partners_CareAndHouse))-0.5 | *2
> )
.         gen share =     (CareAndHouse/(CareAndHouse + partners_CareAndHouse))
> -0.5

.         replace share = share*(-1) if share <0
(1,654 real changes made)

.         gen equality = 1- (share*2)

.         sum equality, d //0-1

                          equality
-------------------------------------------------------------
      Percentiles      Smallest
 1%            0              0
 5%     .0769231              0
10%     .1333333              0       Obs               3,384
25%          .25              0       Sum of wgt.       3,384

50%           .4                      Mean           .4387293
                        Largest       Std. dev.      .2537595
75%     .6153846              1
90%     .8333333              1       Variance       .0643939
95%     .9180328              1       Skewness       .4345613
99%            1              1       Kurtosis       2.389229

. 
. 
. 
. * HYPOTHESIS TEST FOR H3 * 
. 
.         * We assume that the division of childcare and housework tasks among 
> couples (equality) is a good measure of gender equality in the household (hyp
> othesis 3), 
.         * if having a daughter, the respondent is more likely to have higher 
> gender equality in the household (a higher score on scale indicating equality
>  within the household regarding division of childcare and household tasks).
.         * Accordingly, we run a linear OLS regression analysis with `equality
> ' as dependent variable and the dummy variable `d_daughter' as independent va
> riable
. 
.         reg equality d_daughter, cluster(hid) 

Linear regression                               Number of obs     =      3,384
                                                F(1, 1688)        =       0.01
                                                Prob > F          =     0.9292
                                                R-squared         =     0.0000
                                                Root MSE          =      .2538

                                (Std. err. adjusted for 1,689 clusters in hid)
------------------------------------------------------------------------------
             |               Robust
    equality | Coefficient  std. err.      t    P>|t|     [95% conf. interval]
-------------+----------------------------------------------------------------
  d_daughter |  -.0010827   .0121905    -0.09   0.929    -.0249927    .0228273
       _cons |   .4392678   .0085357    51.46   0.000      .422526    .4560095
------------------------------------------------------------------------------

. 
. 
. * EXTRACT AND EXPORT RESULTS * 
. 
.         * Extract the required statistics
. 
.                 * (i) coefficient estimate
.                 local coefficient = _b[d_daughter]

. 
.                 * (ii) standard error
.                 local se = _se[d_daughter]

. 
.                 * (iii) family of the test statistic (e.g. z, t, F, Chi²)
.                 local test_stat_family = "t"

. 
.                 * (iv) residual and model degrees of freedom (DFs) if applica
> ble
.                 local df_residual = e(df_r)

.                 local df_model = e(df_m)

. 
.                 * (v) p-value
.                 local p_value = _b[d_daughter] / _se[d_daughter]

.                 local p_value = 2 * ttail(e(df_r), abs(`p_value'))

. 
.                 * (vi) number of observations
.                 local num_obs = e(N)

. 
.                 * (vii) number of participants
.                 quietly levelsof pid if e(sample), local(participants)

.                 local num_participants : word count `participants'

. 
.                 * (viii) interpretation based of directionality and p-value
.                 local interpretation "positive coefficient is in line with hy
> pothesis"

.                         
.         // Display the saved statistics
.         di "Coefficient: `coefficient'"
Coefficient: -.0010826913940041

.         di "Standard Error: `se'"
Standard Error: .0121904659876641

.         di "Test Statistic Family: `test_stat_family'"
Test Statistic Family: t

.         di "Residual Degrees of Freedom: `df_residual'"
Residual Degrees of Freedom: 1688

.         di "Model Degrees of Freedom: `df_model'"
Model Degrees of Freedom: 1

.         di "p-value: " `p_value'
p-value: .92923979

.         di "Number of observations: " `num_obs'
Number of observations: 3384

.         di      "Number of participants: " `num_participants'
Number of participants: 3381

.         di "Interpretation of directionality: " "`interpretation'"
Interpretation of directionality: positive coefficient is in line with hypothes
> is

. 
