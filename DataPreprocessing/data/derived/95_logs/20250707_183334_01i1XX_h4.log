file C:\Users\dalbrecht\Research
    Projects\ManyDaughters\ManyDaughters_DataPreprocessing/data/derived_confi
    > dential/95%-sample/h4_dataset.dta saved

. 
. * ============================
. * Analysis
. * HYPOTHESIS TEST FOR H1 * 
. * ============================
. 
. *--------------------------------------------
. * GENERATE DEPENDENT VARIABLES * 
. *--------------------------------------------
. 
. * Available in years 2012 and 2018
. 
. ** plh0301: Women should rather care about family than career (2012)
. ** plh0303: Men invoivled in housework (2012)
. ** plh0304: Children suffer when father focused on career (2012)
. ** plh0308_v2: Best if man and woman work the same amount so they can share r
> esponsibility (2018)
. ** plh0302_v2: Child under 3 suffers if mother works (2018)
. 
. * optional: plh0309: Working mothers equal emotional warmth (2012)
. 
. * use "$DATA/h1_dataset.dta", replace
. 
. 
. * Step 1: Reverse code variables when necessary
. 
. * Reverse plh0301: Women should prioritize family over career
. gen plh0301_rev = .
(663,123 missing values generated)

. replace plh0301_rev = 5 - plh0301 if inrange(plh0301, 1, 4)
(6,720 real changes made)

. 
. * Reverse plh0302_v2: Children under 3 suffer if mother works
. gen plh0302_rev = .
(663,123 missing values generated)

. replace plh0302_rev = 8 - plh0302_v2 if inrange(plh0302_v2, 1, 7)
(24,272 real changes made)

. 
. * No reverse needed for plh0303: Men should do housework
. gen plh0303_clean = .
(663,123 missing values generated)

. replace plh0303_clean = plh0303 if inrange(plh0303, 1, 4)
(6,754 real changes made)

. 
. * Reverse plh0304: Children suffer when father focuses on career
. gen plh0304_rev = .
(663,123 missing values generated)

. replace plh0304_rev = 5 - plh0304 if inrange(plh0304, 1, 4)
(6,642 real changes made)

. 
. * No reverse needed for plh0308_v2: Equal work = shared responsibility
. gen plh0308_clean = .
(663,123 missing values generated)

. replace plh0308_clean = plh0308_v2 if inrange(plh0308_v2, 1, 7)
(24,299 real changes made)

. 
. 
. * Step 2: Standardize each variable
. 
. foreach var in plh0308_clean plh0301_rev plh0302_rev plh0303_clean plh0304_re
> v {
  2.     su `var'
  3.     gen z_`var' = (`var' - r(mean)) / r(sd) if !missing(`var')
  4. }

    Variable |        Obs        Mean    Std. dev.       Min        Max
-------------+---------------------------------------------------------
plh0308_cl~n |     24,299    5.451335    1.722319          1          7
(638,824 missing values generated)

    Variable |        Obs        Mean    Std. dev.       Min        Max
-------------+---------------------------------------------------------
 plh0301_rev |      6,720     2.31994     .955797          1          4
(656,403 missing values generated)

    Variable |        Obs        Mean    Std. dev.       Min        Max
-------------+---------------------------------------------------------
 plh0302_rev |     24,272    3.748599     2.14339          1          7
(638,851 missing values generated)

    Variable |        Obs        Mean    Std. dev.       Min        Max
-------------+---------------------------------------------------------
plh0303_cl~n |      6,754    1.567812    .7530423          1          4
(656,369 missing values generated)

    Variable |        Obs        Mean    Std. dev.       Min        Max
-------------+---------------------------------------------------------
 plh0304_rev |      6,642    2.948509     .788067          1          4
(656,481 missing values generated)

. 
. * Step 3: Create index of gender equity support
. 
. gen support_gender_equity_v2 = .
(663,123 missing values generated)

. gen str20 attitude_item = ""
(663,123 missing values generated)

. 
. * List of attitude variables and their source labels
. local items z_plh0308_clean z_plh0301_rev z_plh0302_rev z_plh0303_clean z_plh
> 0304_rev

. local labels plh0308_v2 plh0301 plh0302_v2 plh0303 plh0304

. 
. forvalues i = 1/5 {
  2.     local var : word `i' of `items'
  3.     local lab : word `i' of `labels'
  4. 
.     replace support_gender_equity_v2 = `var' if missing(support_gender_equity
> _v2) & !missing(`var')
  5.     replace attitude_item = "`lab'" if missing(attitude_item) & !missing(`
> var')
  6. }
(24,299 real changes made)
(24,299 real changes made)
(6,720 real changes made)
(6,720 real changes made)
(139 real changes made)
(139 real changes made)
(58 real changes made)
(58 real changes made)
(5 real changes made)
(5 real changes made)

. 
. *--------------------------------------------
. * GENERATE INDEPENDENT VARIABLES: Having Daughters
. *--------------------------------------------
. * Step 1. Find the year of first daughter for each individual
. 
. gen first_daughter_year = .
(663,123 missing values generated)

. 
. foreach i of numlist 1/19 {
  2.     local j : display %02.0f `i'
  3.     quietly replace first_daughter_year = kidgeb`j' if ///
>         kidsex`j' == 2 & ///
>         inrange(kidgeb`j', 1900, 2025) & ///
>         (missing(first_daughter_year) | kidgeb`j' < first_daughter_year)
  4. }

. 
. * Step 2. Treatment indicator: 1 if ever had a daughter, 0 otherwise
. gen treated = !missing(first_daughter_year)

. 
. * Step 3. years at or after first daughter
. gen post = syear >= first_daughter_year if treated == 1
(345,723 missing values generated)

. replace post = 0 if treated == 0
(345,723 real changes made)

. 
. * Step 4. interaction term treat_post
. gen treat_post = treated * post

. 
. 
. * Step 5. Generate gender dummy variable
. 
. gen female = (sex == 2)

. 
. *--------------------------------------------
. * GENERATE ADDITIONAL CONTROLS
. *--------------------------------------------
. 
. * Education: Replace negative codes with missing 
. gen edu_years = pgbilzeit
(143,310 missing values generated)

. replace edu_years = . if inlist(edu_years, -1, -2)
(28,524 real changes made, 28,524 to missing)

. 
. * Marital status: married
. gen married = .
(663,123 missing values generated)

. replace married = 1 if pgfamstd == 1          // 1 = Married
(303,558 real changes made)

. replace married = 0 if inrange(pgfamstd, 2, 8)  // 2 to 8 = Not Married categ
> ories
(213,940 real changes made)

. 
. * Employment status
. 
. gen employment_status = .
(663,123 missing values generated)

. 
. * Assign values
. replace employment_status = 1 if pgemplst == 1   // Full-time
(194,990 real changes made)

. replace employment_status = 2 if pgemplst == 2   // Regular part-time
(64,496 real changes made)

. replace employment_status = 3 if pgemplst == 3   // Vocational training
(13,966 real changes made)

. replace employment_status = 4 if pgemplst == 4   // Irregular part-time
(27,747 real changes made)

. replace employment_status = 5 if pgemplst == 5   // Not employed
(217,916 real changes made)

. replace employment_status = 6 if pgemplst == 6   // Sheltered workshop
(656 real changes made)

. 
. * Handle invalid/missing codes
. replace employment_status = . if inlist(pgemplst, -2)
(0 real changes made)

. 
. * Add labels
. label define empstat_lbl ///
>     1 "Full-time" ///
>     2 "Part-time (regular)" ///
>     3 "Vocational training" ///
>     4 "Part-time (irregular)" ///
>     5 "Not employed" ///
>     6 "Sheltered workshop"

. 
. *--------------------------------------------
. * I estimate a two-way fixed effects linear regression. 
. * Specifically, I interact a gender dummy variable with the treatment variabl
> e to examine if the treatment effect differs by gender
. 
. * A list of variables below is used to measure attidudes toward gender equity
> , which is the dependent variable in hypothesis 1 (H1).
. 
. ** plh0301: Women should rather care about family than career (2012)
. ** plh0303: Men invoivled in housework (2012)
. ** plh0304: Children suffer when father focused on career (2012)
. ** plh0308_v2: Best if man and woman work the same amount so they can share r
> esponsibility (2018)
. ** plh0302_v2: Child under 3 suffers if mother works (2018)
. 
. * Independent variables: 
. * A dummy variable treat_post indicating if an indivdiual has had a daugther 
> at or before the survey year (syear)
. * To examine if the treatment effect differs by gender, an interaction term b
> etween treat_post and gender are included 
. * I control for time trends (via i.syear) and individual covariates (edu_year
> s and employment_status).
. *--------------------------------------------
. 
. 
. * Two-way fixed effects with interaction
. 
. * Run regression
. xtset pid syear

Panel variable: pid (unbalanced)
 Time variable: syear, 2000 to 2020, but with gaps
         Delta: 1 unit

. xtreg support_gender_equity_v2 i.female##i.treat_post i.syear edu_years emplo
> yment_status, fe cluster(pid)
note: 1.female omitted because of collinearity.

