. 
.         /* DELAYED EFFECTS VARIANT      
>         xtreg Left first_daugh05 first_daugh614 first_daugh15plus c.Cbrth_y_f
> irst##c.Cbrth_y_first c.Cage##c.Cage, re cluster(pid)
>         */
. 
.         * EXTRACT AND EXPORT RESULTS * (Please check whether the suggested co
> de automatically picks up the correct statistics for your chosen regression a
> nalysis and adapt if needed)
. 
.         * Extract the required statistics
. 
.                 * (i) coefficient estimate
.                 local coefficient = _b[first_daugh]

. 
.                 * (ii) standard error
.                 local se = _se[first_daugh]

. 
.                 * (iii) family of the test statistic (e.g. z, t, F, Chi²)
.                 local test_stat_family = "z"

. 
.                 * (iv) residual and model degrees of freedom (DFs) if applica
> ble
.                 local df_residual = e(df_r)

.                 local df_model = e(df_m)

. 
.                 * (v) p-value
.                 local p_value = _b[first_daugh] / _se[first_daugh]

.                 * local p_value = 2 * ttail(e(df_r), abs(`p_value'))
.                 local p_value = 2*(1-normal(abs(`p_value')))

. 
.                 * (vi) number of observations
.                 local num_obs = e(N)

. 
.                 * (vii) number of participants
.                 quietly levelsof pid if e(sample), local(participants)

.                 local num_participants : word count `participants'

. 
.                 * (viii) interpretation of directionality
.                 scalar coef_daughter = _b[first_daugh]

.                 local interpretation "positive coefficient is in line with hy
> pothesis"

. 
