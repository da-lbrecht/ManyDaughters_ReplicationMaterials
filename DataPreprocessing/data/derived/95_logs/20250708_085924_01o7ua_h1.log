.         * DEPENDENT VARIABLE: attitudes supporting gender equality
.         * -----------------------------------------
.         
.         * (1) reverse the scales (higher values = stronger support for equali
> ty)
.         gen Suffer6_12 = plh0298_v1 if plh0298_v1>=1 & plh0298_v1<=4 /* origi
> nal */
(41,763 missing values generated)

.         gen Suffer3_12 = plh0302_v1 if plh0302_v1>=1 & plh0302_v1<=4 /* origi
> nal */
(41,776 missing values generated)

.         gen SameShare_12 = 5-plh0308_v1 if plh0308_v1>=1 & plh0308_v1<=4 /* r
> everse */
(41,819 missing values generated)

.         *
.         gen Suffer6_18 = 8-plh0298_v2 if plh0298_v2>=1 & plh0298_v2<=7 /* rev
> erse */
