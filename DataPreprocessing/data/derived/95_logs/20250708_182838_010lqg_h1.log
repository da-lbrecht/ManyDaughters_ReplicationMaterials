.         * generate indicator variable for whether the person has daughters (1
> ) or not (0) where 0 is literally any other        
.         * expression of the variable and includes missings and invalid answer
> s, etc.    
. 
.         use "$IN/biobirth.dta", clear // use biobirth as a starting dataset
(SOEP-Core, v37 (EU Edition), doi:10.5684/soep.core.v37eu)

.                 
.         keep pid cid kidsex* bioyear kidgeb* // calculate for each survey yea
> r if the person had a female child in that year

.         
.         forvalues y = 2000/2020 {
  2.                 gen hasdaughters`y' = 0
  3.                 forvalues i = 1/19 {
  4.                         local sexvar = "kidsex" + string(`i', "%02.0f")
  5.                         local yearvar = "kidgeb" + string(`i', "%02.0f")
  6.                         replace hasdaughters`y' = 1 if `sexvar' == 2 & `ye
> arvar' <= `y' & `yearvar' != .
  7.                 }
  8.         }
