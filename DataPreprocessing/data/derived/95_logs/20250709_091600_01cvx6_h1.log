             | z~3_su~r z~6_su~r z_work~l
-------------+---------------------------
z_child_3_~r |   1.0000
z_child_6_~r |   0.7763   1.0000
z_work_fam~l |   0.0785   0.0759   1.0000


.         matrix C   = r(C)

.         matrix iC  = syminv(C)

.         matrix one = J(3,1,1)

.         matrix tmp = one' * iC * one       // 1×1 matrix

.         scalar denom = tmp[1,1]            // extract the single entry

.         matrix w = (iC * one) / denom

.         matrix list w                      // check weights

w[3,1]
                     c1
z_child_3_~r  .26338902
z_child_6_~r  .26886527
z_work_fam~l  .46774572

.         * Build the weighted index
.         local varlist z_child_3_suffer z_child_6_suffer z_work_family_equal

.         generate double anderson_raw = 0

.         local i = 1

.         foreach v of local varlist {
  2.                 replace anderson_raw = anderson_raw + w[`i',1] * `v'
  3.                 local ++i
  4.         }
