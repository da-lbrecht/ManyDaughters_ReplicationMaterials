. * EXTRACT AND EXPORT RESULTS * 
. 
.         * Restore main specification
.         est restore h3_main
(results h3_main are active now)

. 
.         * Extract the required statistics
. 
.                 * (i) coefficient estimate
.                 local coefficient = _b[first_child_daughter]

. 
.                 * (ii) standard error
.                 local se = _se[first_child_daughter]

. 
.                 * (iii) family of the test statistic
.                 local test_stat_family = "t"

. 
.                 * (iv) residual and model degrees of freedom (DFs)
.                 local df_residual = e(df_r)

.                 local df_model = e(df_m)

. 
.                 * (v) p-value
.                 local p_value = _b[first_child_daughter] / _se[first_child_da
> ughter]

.                 local p_value = 2 * ttail(e(df_r), abs(`p_value'))

. 
.                 * (vi) number of observations
.                 local num_obs = e(N)

. 
.                 * (vii) number of participants
.                 quietly levelsof pid if e(sample), local(participants)

.                 local num_participants : word count `participants'

. 
.                 * (viii) interpretation of directionality // Adapted by DA du
> ring consistency check
.                 local interpretation "not linearly interpretable"

.                 * Set interpretation based on mean
.                 if `mean_female_housework_share' > 0.5 {
.         local interpretation "negative coefficient is in line with hypothesis
> "
.                 }

.                 if `mean_female_housework_share' == 0.5 {
.         local interpretation "not linearly interpretable"
.                 }

.                 else {
.         local interpretation "positive coefficient is in line with hypothesis
> "
.                 }

