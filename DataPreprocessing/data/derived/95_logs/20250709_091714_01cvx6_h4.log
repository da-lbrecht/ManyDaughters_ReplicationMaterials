z_work_fam~l |   0.0785   0.0759   1.0000


.         matrix C   = r(C)

.         matrix iC  = syminv(C)

.         matrix one = J(3,1,1)

.         matrix tmp = one' * iC * one       // 1×1 matrix

.         scalar denom = tmp[1,1]            // extract the single entry

.         matrix w = (iC * one) / denom

.         matrix list w                      // check weights

w[3,1]
                     c1
z_child_3_~r  .26338902
