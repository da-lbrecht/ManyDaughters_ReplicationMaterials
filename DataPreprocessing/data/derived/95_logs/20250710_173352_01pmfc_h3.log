. 
. * Authors: [REDACTED], [REDACTED]
. 
. * ============================
. * Setup *
. * ============================
. 
. * clear all
. version 17 // indicate the version of stata you are using here

. set maxvar 10000 // extend the maximum number of variables to 10,000


. 
. * INSTALL PACKAGES *
. 
. * CONFIGURE FILE PATHS * (Please do not change)
. /*
> * the following code automatically sets paths based on where you saved the di
> stributed file-package on your system *
> if strpos("`c(pwd)'", "code") {
>     global ROOT "`c(pwd)'/.."
> }
> else {
>     global ROOT "`c(pwd)'"
> }
> global IN "$ROOT/data/raw" // folder, in which the original datasets are stor
> ed
> global DATA "$ROOT/data/derived" // folder for datasets
> global OUT "$ROOT/out" // folder for output (results, tables)
> */
. 
. * ============================
. * Data Preparation * 
. * ============================
. 
. * LOAD AND MERGE DATA *
. 
.         use "$IN/ppathl.dta", clear // use ppathl as a starting dataset
(SOEP-Core, v37 (EU Edition), doi:10.5684/soep.core.v37eu)

. 
.         * Merge ppathl with all datasets, that you deem relevant for your ana
> lysis. (Tip: use keepusing() to specify which variables to keep from the usin
> g dataset; the default is all.)
. 
.         * biobirth contains information on fertility history
.         merge m:1 pid using "$IN/biobirth.dta", nogen keep(master matches)
(variable pid was long, now double to accommodate using data's values)
(variable cid was long, now double to accommodate using data's values)
(variable gebjahr was int, now double to accommodate using data's values)
(label sex already defined)
(label sex_EN already defined)

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                           663,123  
    -----------------------------------------

.         * pgen contains user-friendly data on the individual level that are c
> onsolidated from different sources
.         merge 1:1 pid syear using "$IN/pgen.dta", nogen keep(master matches)
(variable syear was long, now double to accommodate using data's values)

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                           663,123  
    -----------------------------------------

.         * pl contains all variables from the individual questionnaire
.         merge 1:1 pid syear using "$IN/pl.dta", nogen keep(master matches)
(variable inputdataset was str6, now str9 to accommodate using data's values)
(label cid_EN already defined)
(label pid_EN already defined)
(label cid already defined)

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                           663,123  
    -----------------------------------------

.         * hgen contains generated variables on household level from the house
> hold interview; use for household net income
.         merge m:1 hid syear using "$IN/hgen.dta", nogen keep(master matches) 
> keepusing(hid syear hghinc)
(label iyear already defined)
(label iyear_EN already defined)

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                           663,123  
    -----------------------------------------

. 
.         label language EN // change language of the labels to English

. 
.         save "$DATA/h3_dataset.dta", replace // save merged dataset
file C:\Users\dalbrecht\Research
    Projects\ManyDaughters\ManyDaughters_DataPreprocessing/data/derived_confi
    > dential/95%-sample/h3_dataset.dta saved

. 
. * ============================
. * Analysis
. * ============================
. 
. * FILTERS *
.  
.         keep if inlist(pop,1,2) // keeping participants from private househol
> ds
(89,279 observations deleted)

.         keep if sexor==0 // keeping hetero individuals
(97,425 observations deleted)

.         keep if biovalid==31 // keeping parents (dropping people without chil
> dren)
(219,239 observations deleted)

.         keep if nett1==1 // keeping subjects with successful interview
(9,458 observations deleted)

.         keep if syear==2018 // we test this hypothesis in the last available 
> data for which the outcome is available: 2018
(232,793 observations deleted)

.         bysort hid (syear): gen byte hid_to_drop = (sumkids[_N] > 3)

.         bysort hid (syear): replace hid_to_drop = 1 if (sumkids[_N-1] > 3) //
>  dropping few      cases in which the two parents give different reports
(5,311 real changes made)

.         drop if hid_to_drop ==1 // drop families that on the last wave report
>  4 children or more
(7,437 observations deleted)

. 
.         
. * GENERATE VARIABLES * 
. 
.         gen age = 2025-gebjahr

.         gen age2 = age^2

.         gen number_daughters=0

. 
.         foreach i of numlist 1/19 {                // loop over 01 … 19
  2.                 local v = "kidsex" + string(`i',"%02.0f")
  3.                 quietly replace number_daughters = number_daughters + (`v'
>  == 2)
  4.         }

.         
.         gen d_daughter = (number_daughters>=1 & number_daughters!=.) // any d
> aughter? conditional on having any children

.         
.         gen equality_fin_dec = 0 if inrange(plc0011,1,3)
(744 missing values generated)

.         replace equality_fin_dec = 1 if plc0011==3 // 1 = both partners make 
> financial decisions equally
(5,606 real changes made)

.         
.         
. * HYPOTHESIS TEST FOR H3 *
. 
.         * The outcome is a binary variable (equality_fin_dec) indicating whet
> her parteners in the household take financial decisions equally or not. The v
> ariable takes the value of 1 if both partners make financial decisions equall
> y in the household, and 0 otherwise (i.e., the male partner takes all financi
> al decisions). This outcome being a higher number (1), indicates greater supp
> ort for gender equality.
. 
.         * Accordingly, we run a linear OLS regression analysis with equality_
> fin_dec as dependent variable and the dummy variable d_daughter as independen
> t variable. We control for  number of children fixed effects, sex, whether th
> e participant was born in Germany, age and age^2.
. 
.         gl add_controls germborn age age2

.         reg equality_fin_dec d_daughter i.sumkids sex $add_controls, vce(clus
> ter hid)

Linear regression                               Number of obs     =      6,748
                                                F(7, 3384)        =       6.38
                                                Prob > F          =     0.0000
                                                R-squared         =     0.0118
                                                Root MSE          =     .37297

                                (Std. err. adjusted for 3,385 clusters in hid)
------------------------------------------------------------------------------
             |               Robust
equality_f~c | Coefficient  std. err.      t    P>|t|     [95% conf. interval]
-------------+----------------------------------------------------------------
  d_daughter |  -.0035677   .0130813    -0.27   0.785    -.0292157    .0220804
             |
     sumkids |
          2  |   .0143984   .0145021     0.99   0.321    -.0140353    .0428322
          3  |   .0069335   .0170929     0.41   0.685      -.02658     .040447
             |
         sex |   .0143042   .0058706     2.44   0.015     .0027939    .0258144
    germborn |  -.0217319   .0168685    -1.29   0.198    -.0548054    .0113415
         age |   .0138363    .003794     3.65   0.000     .0063975    .0212751
        age2 |  -.0000904   .0000292    -3.09   0.002    -.0001477   -.0000331
       _cons |   .3341883   .1260741     2.65   0.008     .0869993    .5813774
------------------------------------------------------------------------------

. 
. 
. * EXTRACT AND EXPORT RESULTS * 
. 
.         * Extract the required statistics
. 
.                 * (i) coefficient estimate
.                 local coefficient = _b[d_daughter]

. 
.                 * (ii) standard error
.                 local se = _se[d_daughter]

. 
.                 * (iii) family of the test statistic (e.g. z, t, F, Chi²)
.                 local test_stat_family = "t"

. 
.                 * (iv) residual and model degrees of freedom (DFs) if applica
> ble
.                 local df_residual = e(df_r)

.                 local df_model = e(df_m)

. 
.                 * (v) p-value
.                 local p_value = _b[d_daughter] / _se[d_daughter]

.                 local p_value = 2 * ttail(e(df_r), abs(`p_value'))

. 
.                 * (vi) number of observations
.                 local num_obs = e(N)

. 
.                 * (vii) number of participants
.                 quietly levelsof pid if e(sample), local(participants)

.                 local num_participants : word count `participants'

. 
.                 * (viii) interpretation of directionality
.                 scalar coef_d_daughter = _b[d_daughter]

.                 local interpretation "positive coefficient is in line with hy
> pothesis"

. 
.         // Display the saved statistics
.         di "Coefficient: `coefficient'"
Coefficient: -.003567657982192

.         di "Standard Error: `se'"
Standard Error: .013081283480902

.         di "Test Statistic Family: `test_stat_family'"
Test Statistic Family: t

.         di "Residual Degrees of Freedom: `df_residual'"
Residual Degrees of Freedom: 3384

.         di "Model Degrees of Freedom: `df_model'"
Model Degrees of Freedom: 7

.         di "p-value: " `p_value'
p-value: .78507744

.         di "Number of observations: " `num_obs'
Number of observations: 6748

.         di "Number of participants: " `num_participants'
Number of participants: 6748

.         di "Interpretation of directionality: " "`interpretation'"
Interpretation of directionality: positive coefficient is in line with hypothes
> is

. 
.         * Export results to csv 
.         file open myfile using "$OUT/h3_results.csv", write replace
(file C:\Users\dalbrecht\Research
    Projects\ManyDaughters\ManyDaughters_DataPreprocessing/data/derived/95_re
    > sults/h3_results.csv not found)

.         file write myfile "coefficient,se,family,residual_df,model_df,p_value
> ,num_obs,num_participants,interpretation" _n

.         file write myfile "`coefficient', `se', `test_stat_family', `df_resid
> ual', `df_model',`p_value',`num_obs',`num_participants',`interpretation'" _n

.         file close myfile

. 
. *****************************************************************************
> ***
