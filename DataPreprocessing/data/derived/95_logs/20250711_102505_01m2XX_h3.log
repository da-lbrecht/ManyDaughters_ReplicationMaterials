. label var daughters "Number of daughters"

. label var kids      "Total number of children"

. 
. bysort pid syear: keep if _n == 1               // 1 row per parent-year
(0 observations deleted)

. 
. * -------- Outcome: 7-point "equality in household" measure --------------
. 
. recode plh0308_v2 (-1 -2 -3 -5 -8 = .)                         
(19,973 changes made to plh0308_v2)

. egen  z_eq = std(plh0308_v2)                                      
(22,098 missing values generated)

. label var z_eq "Agree: man & woman should work equally (std)" 

. 
. * -------- Covariates ----------------------------------------------
. gen agesq   = age^2

. label var agesq "Age Square"

. gen lnhhinc = log(hghinc)
(2,210 missing values generated)

. label var lnhhinc "Household Income"

. label var pgbilzeit "Education Years"

. label var pgemplst "Employment Status"

. recode pgbilzeit pgemplst (-1 -2 -3 -5 = .)
(670 changes made to pgbilzeit)
(1 changes made to pgemplst)

. gen migrant = inlist(migback, 2, 3)

. label var migrant "Migration background =1"

. gen east = (loc1989 == 2)

. label var east "East Germany (DDR) =1"

. 
. * -------- Main regression -----------------------------------------
. assert !missing(phrf)                            // person weight exists

. reg z_eq daughters agesq age i.kids lnhhinc pgbilzeit i.pgemplst migrant east
>  i.syear [pw = phrf], cluster(pid)
(sum of wgt is 41,327,973.75)
