. * ============================
. * Analysis
. * ============================
. use "$DATA/h3_dataset.dta", clear

. 
. * -------- Filters --------------------------------------------------
. keep if inlist(pop, 1, 2)                       // private households
(15,713 observations deleted)

. gen  age = syear - gebjahr

. keep if age >= 40                               // completed fertility
(22,838 observations deleted)

. 
. * -------- Treatment & family size (kidsex## wide vars) ------------
. ds kidsex*, has(type numeric)
kidsex01  kidsex04  kidsex07  kidsex10  kidsex13  kidsex16  kidsex19
kidsex02  kidsex05  kidsex08  kidsex11  kidsex14  kidsex17
kidsex03  kidsex06  kidsex09  kidsex12  kidsex15  kidsex18

. local kidvars `r(varlist)'

. 
. gen daughters = 0

. foreach v of local kidvars {
  2.     replace daughters = daughters + (`v' == 2)
  3. }
