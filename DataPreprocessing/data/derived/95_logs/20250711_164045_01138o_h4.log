. * GENERATE VARIABLES * 
. 
.         gen male = (sex == 1)

.         gen age = syear - gebjahr

.         gen age2 = age*age

.         gen migbackdummy = (migback != 1)

.         
.         gen firstbornisdaughter = (kidsex01 == 2)

.         gen anydaughter = (kidsex01 == 2) | (kidsex02 == 2) | (kidsex03 == 2)
>  | (kidsex04 == 2) | (kidsex05 == 2) | (kidsex06 == 2) | (kidsex07 == 2) | //
> / 
>         (kidsex08 == 2) | (kidsex09 == 2) | (kidsex10 == 2) | (kidsex11 == 2)
>  | (kidsex12 == 2) | (kidsex13 == 2) | (kidsex14 == 2) | ///
>         (kidsex15 == 2) | (kidsex16 == 2) | (kidsex17 == 2) | (kidsex18 == 2)
>  | (kidsex19 == 2)

.         
.         gen male_and_firstbornisdaughter = male * firstbornisdaughter

.         gen male_and_anydaughter = male * anydaughter

.         gen male_x_age = male * age

.         gen male_x_age2 = male * age2

.         gen male_x_migbackdummy = male * migbackdummy

.         
.         keep pid hid syear male age age2 migbackdummy firstbornisdaughter any
> daughter plh0308_v2 male_and_firstbornisdaughter male_and_anydaughter male_x_
> age male_x_age2 male_x_migbackdummy

. 
. 
. * HYPOTHESIS TEST FOR H4 * 
. 
.         * We run an IV regression with plh0308_v2 as the dependent variable a
> nd anydaughter as well as male_and_anydaughter as the independent variables, 
.         * with anydaughter being instrumtended by firstbornisdaughter and mal
> e_and_anydaughter being instrumented by male_and_firstbornisdaughter.
.         * Controls are male, age, age2, migbackdummy, male_x_age, male_x_age2
> , and male_x_migbackdummy.
. 
.         ivreg2 plh0308_v2 male age age2 migbackdummy male_x_age male_x_age2 m
> ale_x_migbackdummy (anydaughter male_and_anydaughter = firstbornisdaughter ma
> le_and_firstbornisdaughter), cluster(hid) 

