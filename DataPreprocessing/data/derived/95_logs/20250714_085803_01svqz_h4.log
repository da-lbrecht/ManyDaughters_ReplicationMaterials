. * GENERATE VARIABLES * (Please adapt according to your needs)
.         * Outcome : support gender equality
.         foreach x in plj0620 plj0621 plj0622 plj0623 plj0624 plj0625 {
  2.         recode `x' (-8=.) (-5=.) (-1=.)
  3.         }
(12,679 changes made to plj0620)
(12,615 changes made to plj0621)
(12,612 changes made to plj0622)
(12,681 changes made to plj0623)
(12,600 changes made to plj0624)
(12,569 changes made to plj0625)

. 
.         foreach x in plj0623 plj0624 plj0625 {
  2.         g reverse_`x'=(7 + 1) - `x'
  3.         }
(15,990 missing values generated)
(15,909 missing values generated)
(15,878 missing values generated)

. 
.         foreach x in plj0621 plj0622 reverse_plj0623 reverse_plj0624 reverse_
