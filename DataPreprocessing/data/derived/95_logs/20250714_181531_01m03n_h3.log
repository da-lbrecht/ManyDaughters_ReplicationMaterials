. do "20250714_181531_01m03n_h3.do"

. *****************************************************************************
> ***
. ****************** Example Do-File H3: #ManyDaughters Project ***************
> ***
. *****************************************************************************
> ***
. 
. * Authors: Tina Wang, David Albrecht
. * Revised by Research Team RT01m03n: [REDACTED], [REDACTED]
. 
. 
. * ============================
. * Setup * 
. * ============================
. 
. * clear all
. version 17.0 // indicate the version of stata used here

. set maxvar 10000 // extend the maximum number of variables to 10,000


. 
. * INSTALL PACKAGES * 
. * ssc install outreg2
. * ssc install ftools
. * ssc install reghdfe, replace
. 
. * CONFIGURE FILE PATHS * (Please do not change)
. /*
> * the following code automatically sets paths based on where you saved the di
> stributed file-package on your system *
> if strpos("`c(pwd)'", "code") {
>     global ROOT "`c(pwd)'/.."
> }
> else {
>     global ROOT "`c(pwd)'"
> }
> global IN "$ROOT/data/raw" // folder, in which the original datasets are stor
> ed
> global DATA "$ROOT/data/derived" // folder for datasets
> global OUT "$ROOT/out" // folder for output (results, tables)
> 
> */
. 
. * ============================
. * Data Preparation * 
. * ============================
. 
. * LOAD AND MERGE DATA * 
. 
.         use "$IN/ppathl.dta", clear // use ppathl as a starting dataset
(SOEP-Core, v37 (EU Edition), doi:10.5684/soep.core.v37eu)

. 
.         * Merge ppathl with all datasets, relevant for the analysis. 
. 
.         * biobirth contains information on fertility history
.         merge m:1 pid using "$IN/biobirth.dta", nogen keep(master matches)
(variable pid was long, now double to accommodate using data's values)
(variable cid was long, now double to accommodate using data's values)
(variable gebjahr was int, now double to accommodate using data's values)
(label sex already defined)
(label sex_EN already defined)

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                           663,123  
    -----------------------------------------

.         * pgen contains user-friendly data on the individual level that are c
> onsolidated from different sources
.         merge 1:1 pid syear using "$IN/pgen.dta", nogen keep(master matches)
(variable syear was long, now double to accommodate using data's values)

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                           663,123  
    -----------------------------------------

.         * pl contains all variables from the individual questionnaire
.         merge 1:1 pid syear using "$IN/pl.dta", nogen keep(master matches)
(variable inputdataset was str6, now str9 to accommodate using data's values)
(label cid_EN already defined)
(label pid_EN already defined)
(label cid already defined)

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                           663,123  
    -----------------------------------------

.         * hgen contains generated variables on household level from the house
> hold interview; use for household net income
.         merge m:1 hid syear using "$IN/hgen.dta", nogen keep(master matches) 
> keepusing(hid syear hghinc)
(label iyear already defined)
(label iyear_EN already defined)

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                           663,123  
    -----------------------------------------

.         
.         
.         ** Merge also with biol data to gather the remaining original variabl
> es needed.
.         merge 1:1 pid syear using "$IN/biol.dta", nogen keep(master matches)
(variable instrument was long, now double to accommodate using data's values)
(label p_buh11_EN already defined)
(label p_buh10_EN already defined)
(label p_buh9_EN already defined)
(label p_buh8_EN already defined)
(label p_buh7_EN already defined)
(label p_buh6_EN already defined)
(label p_buh5_EN already defined)
(label p_buh4_EN already defined)
(label p_buh3_EN already defined)
(label p_buh2_EN already defined)
(label p_buh1_EN already defined)
(label intid_EN already defined)
(label iyear_EN already defined)
(label instrument_EN already defined)
(label p_anker_EN already defined)
(label syear_EN already defined)
(label pnr_EN already defined)
(label cid_EN already defined)
(label hid_EN already defined)
(label pid_EN already defined)
(label p_buh11 already defined)
(label p_buh10 already defined)
(label p_buh9 already defined)
(label p_buh8 already defined)
(label p_buh7 already defined)
(label p_buh6 already defined)
(label p_buh5 already defined)
(label p_buh4 already defined)
(label p_buh3 already defined)
(label p_buh2 already defined)
(label p_buh1 already defined)
(label intid already defined)
(label iyear already defined)
(label instrument already defined)
(label p_anker already defined)
(label pnr already defined)
(label cid already defined)
(label hid already defined)

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                           663,123  
    -----------------------------------------

. 
. 
.         label language EN // change language of the labels to English

.         
.         
. * Reduce dataset to retain only relevant variables.
. keep pid hid syear ///
>      parid ///
>      kidsex* kidgeb* ///
>          plb0176_h ///
>          gebjahr sumkids pgpartz 

.         
. 
.         save "$DATA/h3_dataset_RT01m03n.dta", replace // save merged dataset
(file C:\Users\dalbrecht\Research
    Projects\ManyDaughters\ManyDaughters_DataPreprocessing/data/derived_confi
    > dential/95%-sample/h3_dataset_RT01m03n.dta not found)
file C:\Users\dalbrecht\Research
    Projects\ManyDaughters\ManyDaughters_DataPreprocessing/data/derived_confi
    > dential/95%-sample/h3_dataset_RT01m03n.dta saved

. 
. 
. * ============================
. * Analysis
. * ============================
. 
. * FILTERS *
. 
.         * 1. Generate flags per child if that child is a daughter born before
>  2000. 
. gen byte daughter_pre2000 = 0

. 
. forvalues i = 1/19 {
  2.     local k = string(`i', "%02.0f")  // formats 1 as "01", 2 as "02", ...,
>  19 as "19"
  3.     quietly replace daughter_pre2000 = 1 if kidsex`k' == 2 & kidgeb`k' < 2
> 000
  4. }

. 
.         * 2. Drop participants with daughters born before 2000
. drop if daughter_pre2000 == 1
(214,109 observations deleted)

. 
. 
. * GENERATE VARIABLES * 
. 
.         * 1. Generate main predictor: binary variable to measure whether a gi
> ven respondent has (1) one or multiple daughters or (0) no children or one or
>  multiple sons born by the current year.
.         ** Using variables kidgeb* kidsex*. Binary assessed at all panel wave
> s (2000-2020)
.         *** Note: The answer "Does not apply (coded as -2)" in var kidgeb* is
>  assumed to measure absence of children, thus coded as 0
. 
. gen byte daughter_any = 0

. 
. forvalues i = 1/19 {
  2.     local k = string(`i', "%02.0f")
  3.     quietly replace daughter_any = 1 if kidsex`k' == 2 & kidgeb`k' <= syea
> r
  4.     quietly replace daughter_any = . if kidgeb`k' == -3 | kidgeb`k' == -1
  5. }

. 
. 
.         * 2. Generate main outcome: index of unequal participation in the lab
> or market (i.e., the difference in the number of working hours between partne
> rs). 
.         ** Using the following items: plb0176_h measuring the agreed weekly w
> orking hours (harmonized and assessed from 2000 to 2020).
.         *** Note: Differently from what indicated in the pre-analysis plan (P
> AP), we did not impute values for 2020, as the variable was also assessed in 
> 2020. 
.         
.         * 2.1 Recode missing values to Stata system missing (.) and generate 
> the variable age that we need in step 2.2.2 to build the covariate.
. gen weekly_hours = plb0176_h
(120,244 missing values generated)

.         replace weekly_hours = . if inlist(weekly_hours, -5, -3, -2)
(158,653 real changes made, 158,653 to missing)

. 
. gen age = syear - gebjahr

. 
. 
.         * 2.2 Constructing the difference score measuring inequality among th
> e dyad
.         
.         ** Using the following items: pid, syear, parid (partner person numbe
> r).
.         *** Note: Differently from what we indicated in the PAP, we do not us
> e the variables sex and hid to characterize dyads. Rather, we use the variabl
> e parid because, as stated in the PAP, we do not exclude same-sex partners. O
> ur measurement allows us to "capture" inequality among partners, regardless o
> f their sexual orientation.  
.         
.         * 2.2.1 Create a new frame that holds the lookup table of pid + worki
> ng hours (create & copy current data to "partner lookup")
.         
. frame copy default partner_lookup

. 
.         * 2.2.2 In the lookup frame (dataset copy), keep relevant variables (
> partner's age - to generate the covariate - and partner's working hours - for
>  the outcome). We generated the age variable before.
.         
. frame partner_lookup {
.     keep pid syear weekly_hours age
.     rename pid parid         // this is then used to match the parid in the m
> ain data and create dyads
.     rename weekly_hours hours_partner
.         rename age age_partner
. }

. 
.         * 2.2.3 Link partner to the default frame. This matches the observati
> ons in default.dta to those in partner_lookup.dta based on equal values of va
> riable parid and syear. 
.         
. frame default {
.     frlink m:1 parid syear, frame(partner_lookup)
(239,810 observations in frame default unmatched)
.         // Using many-to-one linkage becuse multiple people may refer to the 
> same partner in the same year or there may be duplicates
.     frget hours_partner age_partner, from(partner_lookup) 
(350,278 missing values generated)
(239,810 missing values generated)
(2 variables copied from linked frame)
.         // the frget command copies the variables and their associated metada
> ta needed from the data in the linked frame (partner_lookup.dta) to the data 
> in the current frame (default.dta)
.     
.     // Create the difference score - outcome
.     gen hour_gap = weekly_hours - hours_partner
(383,276 missing values generated)
.     label var hour_gap "Working hours gap: self - partner"
.     // Create the mean age of parents in the household - covariate
.         egen mean_age = rowmean(age age_partner)
. }

. 
. 
.         
. * FURTHER FILTER *: Exclude also couples that experienced a dissolution. 
. 
.         * 1. Generate partnership status: using the pgpartz variable to asses
> s the respondent's partnership status, distinguishing between (0) no partner 
> and (1) spouse/registered partner, partner, probably spouse/registered partne
> r, probably partner.
. gen partner_status = .
(449,014 missing values generated)

.         replace partner_status = 0 if pgpartz == 0
(127,666 real changes made)

.         replace partner_status = 1 if inlist(pgpartz, 1, 2, 3, 4)
(206,312 real changes made)

.         label define partner_lbl 0 "No partner" 1 "Has partner"

.         label values partner_status partner_lbl

. 
.         
.         * 2. Generate a variable that tracks whether couples experienced a di
> ssolution of the partnership. This may include couples that did not register 
> another partner after the dissolution, those that registered the same partner
>  as before, and those that changed it. 
. by pid (syear), sort: gen partner_status_lag = partner_status[_n-1]
(138,850 missing values generated)

. gen dissolution = partner_status_lag == 1 & partner_status == 0 

. 
.         * 3. Drop couples that experienced a dissolution after the birth of a
>  daughter. Note that the couples that changed partners within one year but di
> d not register a dissolution are retained.
.         *** Note: In contrast to what we specified in the PAP, we only exclud
> e couples that experienced a dissolution 'after' the daughter was born.
. drop if dissolution==1 & daughter_any==1
(810 observations deleted)

. 
. 
. 
. * HYPOTHESIS TEST FOR H3 * 
. 
.         * Fixed effects model.
. 
.         ** We assume that the measure unequal participation in the labor mark
> et is an appropriate measure to "capture" gender inequality in the household 
> (hypothesis 3). At higher values, the respondent is more likely to experience
>  more gender equality in the household.
. 
.         ** We run a fixed effects model with hour_gap as the dependent variab
> le and the dummy variable daughter_any as the main independent variable. 
.         
.         ** set data as panel so we can use Stata's panel data xt commands and
>  the time series operators. 
. xtset pid syear

Panel variable: pid (unbalanced)
 Time variable: syear, 2000 to 2020, but with gaps
         Delta: 1 unit

.                 
.         ** We predict respondents' gender inequality in the household as a fu
> nction of whether they had one or multiple daughters in the preceding panel w
> ave. The model controls for parents' mean age and sumkids (number of children
> ) also measured at the preceding panel waves. To include in the model all the
>  predictors assessed in the preceding panel wave, we transformed them before 
> running the model using the time series operator L1.
. foreach var in daughter_any mean_age sumkids {
  2.     gen `var'_L1 = L1.`var'
  3. }
(63,033 missing values generated)
(62,714 missing values generated)
(62,714 missing values generated)

.         
.         ** We estimate cluster-robust standard errors at the household level 
> (using the hid variable). 
.         
. reghdfe hour_gap daughter_any_L1 ///
>         mean_age_L1 sumkids_L1 /// 
>   , absorb(hid) /// fixed effects option at the household level
>   vce(cluster hid)
(dropped 331 singleton observations)
(MWFE estimator converged in 1 iterations)

HDFE Linear regression                            Number of obs   =     56,761
Absorbing 1 HDFE group                            F(   3,   6691) =       4.17
Statistics robust to heteroskedasticity           Prob > F        =     0.0059
                                                  R-squared       =     0.0019
                                                  Adj R-squared   =    -0.1316
                                                  Within R-sq.    =     0.0008
Number of clusters (hid)     =      6,692         Root MSE        =    16.9852

                                (Std. err. adjusted for 6,692 clusters in hid)
------------------------------------------------------------------------------
             |               Robust
    hour_gap | Coefficient  std. err.      t    P>|t|     [95% conf. interval]
-------------+----------------------------------------------------------------
daughter_a~1 |  -.4111665   .5588325    -0.74   0.462    -1.506656    .6843231
 mean_age_L1 |   .0165194   .0086058     1.92   0.055    -.0003507    .0333895
  sumkids_L1 |  -1.894851   .7815722    -2.42   0.015    -3.426982   -.3627208
       _cons |   2.313982   1.158576     2.00   0.046     .0428042    4.585159
------------------------------------------------------------------------------

Absorbed degrees of freedom:
-----------------------------------------------------+
 Absorbed FE | Categories  - Redundant  = Num. Coefs |
-------------+---------------------------------------|
         hid |      6692        6692           0    *|
-----------------------------------------------------+
* = FE nested within cluster; treated as redundant for DoF computation

.   
.  
. 
. * EXTRACT AND EXPORT RESULTS * 
. 
.         * Extract the required statistics
. 
.                 * (i) coefficient estimate
.                 local coefficient = _b[daughter_any_L1]

. 
.                 * (ii) standard error
.                 local se = _se[daughter_any_L1]

. 
.                 * (iii) family of the test statistic (e.g. z, t, F, Chi²)
.                 local test_stat_family = "t"

. 
.                 * (iv) residual and model degrees of freedom (DFs) if applica
> ble
.                 local df_residual = e(df_r)

.                 local df_model = e(df_m)

. 
.                 * (v) p-value
.                 local p_value = _b[daughter_any_L1] / _se[daughter_any_L1]

.                 local p_value = 2 * ttail(e(df_r), abs(`p_value'))

. 
.                 * (vi) number of observations
.                 local num_obs = e(N)

. 
.                 * (vii) number of participants
.                 quietly levelsof hid if e(sample), local(participants)

.                 local num_participants : word count `participants'

. 
.                 * (viii) interpretation of directionality
.                 scalar coef_daughter_any = _b[daughter_any_L1]

.                 local interpretation "positive coefficient is in line with hy
> pothesis"

. 
. 
. 
.         // Display the saved statistics
.         di "Coefficient: `coefficient'"
Coefficient: -.4111665210666715

.         di "Standard Error: `se'"
Standard Error: .5588324530688323

.         di "Test Statistic Family: `test_stat_family'"
Test Statistic Family: t

.         di "Residual Degrees of Freedom: `df_residual'"
Residual Degrees of Freedom: 6691

.         di "Model Degrees of Freedom: `df_model'"
Model Degrees of Freedom: 3

.         di "p-value: " `p_value'
p-value: .46190261

.         di "Number of observations: " `num_obs'
Number of observations: 56761

.         di      "Number of participants: " `num_participants'
Number of participants: 6692

.         di "Interpretation of directionality: " "`interpretation'"
Interpretation of directionality: positive coefficient is in line with hypothes
> is

. 
.         * Export results to csv 
.         file open myfile using "$OUT/h3_results.csv", write replace // Rename
> d to original naming convention by David Albrecht on 15.07.2025
(file C:\Users\dalbrecht\Research
    Projects\ManyDaughters\ManyDaughters_DataPreprocessing/data/derived/95_re
    > sults/h3_results.csv not found)

.         file write myfile "coefficient,se,family,residual_df,model_df,p_value
> ,num_obs,num_participants,interpretation" _n

.         file write myfile "`coefficient', `se', `test_stat_family', `df_resid
> ual', `df_model',`p_value',`num_obs',`num_participants',`interpretation'" _n

.         file close myfile

. 
. 
. *****************************************************************************
> ***
. 
. exit

end of do-file

. 
