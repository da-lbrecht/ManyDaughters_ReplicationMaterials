.         gen n_sons = 0

.         gen n_daughters = 0

. 
.         forvalues i = 1/19 {
  2.                 local varname = "kidsex" + string(`i', "%02.0f")
  3.                 replace `varname' = . if `varname' == -1
  4.                 quietly replace n_sons = n_sons + 1 if `varname' == 1
  5.                 quietly replace n_daughters = n_daughters + 1 if `varname'
>  == 2
  6.         }
