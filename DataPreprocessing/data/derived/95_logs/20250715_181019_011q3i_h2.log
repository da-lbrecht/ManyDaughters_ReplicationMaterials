.         * Loop through 8 child birthyear variables
.         forvalues i = 1/8 {
  2.                 * Get the correct variable name (e.g. lb0287_h, lb0290_h, 
> ...)
.                 local varnum = 287 + 3 * (`i' - 1)
  3.                 local byear = "lb0" + string(`varnum') + "_h"
  4. 
.                 * Generate age and category only if birth year is not missing
.                 gen age_child`i' = syear - `byear' if `byear' != .
  5. 
.                 gen childagegroup`i' = .
  6.                 replace childagegroup`i' = 0 if age_child`i' < 1 & age_chi
> ld`i'!=. // Infant
  7.                 replace childagegroup`i' = 1 if age_child`i' >= 1 & age_ch
> ild`i' < 4 // Toddler
  8.                 replace childagegroup`i' = 2 if age_child`i' >= 4 & age_ch
> ild`i' < 6 // Preschooler
  9.                 replace childagegroup`i' = 3 if age_child`i' >= 6 & age_ch
> ild`i' < 13 // School age
 10.                 replace childagegroup`i' = 4 if age_child`i' >= 13 & age_c
> hild`i' <= 17  // Teenager
 11.                 replace childagegroup`i' = 5 if age_child`i' >= 18 & age_c
> hild`i'!=. // Adult
 12.                 
.                 * Apply value label
.                 label values childagegroup`i' agegroup_lbl
 13.         }
