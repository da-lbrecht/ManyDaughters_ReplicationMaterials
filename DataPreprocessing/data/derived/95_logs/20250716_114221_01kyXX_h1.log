. 
. * Authors: Tina Wang, David Albrecht
. 
. * ============================
. * Setup * (Please adapt according to your needs)
. * ============================
. 
. *clear all
. version 17 // indicate the version of stata you are using here

. set maxvar 10000 // extend the maximum number of variables to 10,000


. 
. * INSTALL PACKAGES * (Please adapt according to your needs)
. * install all packages you need here, for example:
. *ssc install outreg2
. /*
> * CONFIGURE FILE PATHS * (Please do not change)
> * the following code automatically sets paths based on where you saved the di
> stributed file-package on your system *
> if strpos("`c(pwd)'", "code") {
>     global ROOT "`c(pwd)'/.."
> }
> else {
>     global ROOT "`c(pwd)'"
> }
> global IN "$ROOT/data/raw" // folder, in which the original datasets are stor
> ed
> global DATA "$ROOT/data/derived" // folder for datasets
> global OUT "$ROOT/out" // folder for output (results, tables)
> */
. 
. * ============================
. * Data Preparation * 
. * ============================
. 
. * LOAD AND MERGE DATA * (Please adapt according to your needs)
. 
.         use "$IN/ppathl.dta", clear // use ppathl as a starting dataset
(SOEP-Core, v37 (EU Edition), doi:10.5684/soep.core.v37eu)

. 
.         * Merge ppathl with all datasets, that you deem relevant for your ana
> lysis. (Tip: use keepusing() to specify which variables to keep from the usin
> g dataset; the default is all.)
. 
.         * biobirth contains information on fertility history
.         merge m:1 pid using "$IN/biobirth.dta", nogen keep(master matches)
(variable pid was long, now double to accommodate using data's values)
(variable cid was long, now double to accommodate using data's values)
(variable gebjahr was int, now double to accommodate using data's values)
(label sex already defined)
(label sex_EN already defined)

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                           663,123  
    -----------------------------------------

.         * pgen contains user-friendly data on the individual level that are c
> onsolidated from different sources
.         merge 1:1 pid syear using "$IN/pgen.dta", nogen keep(master matches)
(variable syear was long, now double to accommodate using data's values)

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                           663,123  
    -----------------------------------------

.         * pl contains all variables from the individual questionnaire
.         merge 1:1 pid syear using "$IN/pl.dta", nogen keep(master matches)
(variable inputdataset was str6, now str9 to accommodate using data's values)
(label cid_EN already defined)
(label pid_EN already defined)
(label cid already defined)

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                           663,123  
    -----------------------------------------

.         * hgen contains generated variables on household level from the house
> hold interview; use for household net income
.         merge m:1 hid syear using "$IN/hgen.dta", nogen keep(master matches) 
> keepusing(hid syear hghinc)
(label iyear already defined)
(label iyear_EN already defined)

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                           663,123  
    -----------------------------------------

. 
.         label language EN // change language of the labels to English

. 
.         *save "$DATA/h1_dataset.dta", replace // save merged dataset
. 
. 
. * ============================
. * Analysis
. * ============================
. 
. * FILTERS * (Please adapt according to your needs)
.  
.         * Example: only keep participants from private households
.         *keep if inlist(pop,1,2)
. 
. 
. * GENERATE VARIABLES * (Please adapt according to your needs)
. 
.         set seed 123

. 
.         * Indicator that respondent has only one biological child:
.         generate have_one_child = biokids==1

.         
.         * Indicator that first biological child is a daughter:
.         generate d_daughter = .
(663,123 missing values generated)

.         replace d_daughter = 1 if kidsex01==2   
(216,749 real changes made)

.         replace d_daughter = 0 if kidsex01==1
(229,481 real changes made)

.         
. 
. 
. * HYPOTHESIS TEST FOR H1 * (Please adapt according to your needs)
. 
.         * Test of H1: 
.         * If we assume that disagreeing with the statements:
.         * "For parents, vocational training or higher education for their son
> s should be more important than vocational training or higher education for t
> heir daughters" (plj0624)
.         * and
.         * "At home, the husband should have the final say" (plj0625) 
.         * is a good measure of support for gender equality,
.         * Then, accordingly, we run a linear OLS regression analysis with the
>  average response to plj0624* and plj0625* as the dependent variable and the 
> dummy variable d_daughter as independent variable
.         * where "*" indicates I will reverse-code the item so that ">0" avera
> ge is interpreted as in line with the hypothesis
.         * and where taking the average is valid since both items are on a sca
> le 1-7 
.         * We restrict the sample to individuals with valid answers to the var
> iables included in the regression
.         
.         * Generate average outcome
.         local i=1  // test number within hypothesis

.         local outcome`i' = "avg_6_7"

.         foreach v of varlist plj0624 plj0625 {
  2.                 generate `v'_reverse = 8-`v'
  3.                 
.         }
(148,633 missing values generated)
(148,633 missing values generated)

.         egen `outcome`i'' = rowmean(plj0624_reverse plj0625_reverse)
(148,633 missing values generated)

.         
.         * Regression
.         regress `outcome`i'' i.d_daughter i.sex c.bioage##c.bioage hghinc pgi
> sced97 i.syear if have_one_child==1 & (sex==1 | sex==2) & (plj0624>=1 & plj06
> 24<=7) & (plj0625>=1 & plj0625<=7) & (hghinc>0 & hghinc!=.) & (pgisced97>=0 &
>  pgisced97!=.), vce(robust)

Linear regression                               Number of obs     =        599
                                                F(8, 590)         =       4.10
                                                Prob > F          =     0.0001
                                                R-squared         =     0.0435
                                                Root MSE          =     1.7709

------------------------------------------------------------------------------
             |               Robust
     avg_6_7 | Coefficient  std. err.      t    P>|t|     [95% conf. interval]
-------------+----------------------------------------------------------------
1.d_daughter |   -.008891      .1467    -0.06   0.952    -.2970087    .2792267
             |
         sex |
 [2] Female  |   .4342132    .150152     2.89   0.004     .1393157    .7291106
      bioage |   .0573059   .0504289     1.14   0.256    -.0417361    .1563479
             |
    c.bioage#|
    c.bioage |  -.0007585   .0006497    -1.17   0.243    -.0020346    .0005175
             |
      hghinc |   .0001872   .0001265     1.48   0.139    -.0000613    .0004358
   pgisced97 |   .1298526   .0364258     3.56   0.000     .0583126    .2013927
             |
       syear |
       2017  |  -.0778193   .1556688    -0.50   0.617    -.3835517    .2279131
       2018  |   .4764298   .4142903     1.15   0.251    -.3372334    1.290093
             |
       _cons |   3.908799   .9342312     4.18   0.000     2.073976    5.743623
------------------------------------------------------------------------------

.         
. 
.         * EXTRACT AND EXPORT RESULTS * (Please check whether the suggested co
> de automatically picks up the correct statistics for your chosen regression a
> nalysis and adapt if needed)
. 
.         * Extract the required statistics
.         
.                 matrix a_`i' = r(table)

.                 
.                 * (i) coefficient estimate
.                 local coefficient_`i' = a_`i'[1,2]

.                 
.                 * (ii) standard error
.                 local se_`i' = a_`i'[2,2]

.                 
.                 * (iii) family of the test statistic (e.g. z, t, F, Chi²)
.                 local test_stat_family_`i' = "t"

.                 
.                 * (iv) residual and model degrees of freedom (DFs) if applica
> ble
.                 local df_residual_`i' = e(df_r)

.                 local df_model_`i' = e(df_m)

. 
.                 * (v) p-value
.                 local p_value_`i' = `coefficient_`i'' / `se_`i''

.                 local p_value_`i' = 2 * ttail(e(df_r), abs(`p_value_`i''))

.                 
.                 * (vi) number of observations
.                 local num_obs_`i' = e(N)

. 
.                 * (vii) number of participants
.                 quietly levelsof pid if e(sample), local(participants_`i')

.                 local num_participants_`i' : word count `participants_`i''

.                 
.                 * (viii) interpretation of directionality
.                 local interpretation_`i' "positive coefficient is in line wit
> h hypothesis"

.                 
.                 
.         // Display the saved statistics
.         forvalues i=1/1 {
  2.                 di "Coefficient: `coefficient_`i''"
  3.                 di "Standard Error: `se_`i''"
  4.                 di "Test Statistic Family: `test_stat_family_`i''"
  5.                 di "Residual Degrees of Freedom: `df_residual_`i''"
  6.                 di "Model Degrees of Freedom: `df_model_`i''"
  7.                 di "p-value: " `p_value_`i''
  8.                 di "Number of observations: " `num_obs_`i''
  9.                 di      "Number of participants: " `num_participants_`i''
 10.                 di "Interpretation of directionality: " "`interpretation_`
> i''"
 11.         }       
