. * Help-Variables *
. ******************
. 
. * Birthdate first child
. recode kidgeb01 (-100/-1=.)
(217,072 changes made to kidgeb01)

. recode kidmon01 (-100/-1=.)
(377,877 changes made to kidmon01)

. gen birthdate_1=mdy(kidmon01, 15, kidgeb01) //day not recorded, set to the 15
> th of the month
(377,877 missing values generated)

. lab var birthdate_1 "Birthdate of first child"

. 
. * Birthdate second child
. recode kidgeb02 (-100/-1=.)
(340,439 changes made to kidgeb02)

. recode kidmon02 (-100/-1=.)
(442,842 changes made to kidmon02)

. gen birthdate_2=mdy(kidmon02, 15, kidgeb02) //day not recorded, set to the 15
> th of the month
(442,842 missing values generated)

. lab var birthdate_2 "Birthdate of second child"

. 
. * Date of interview
. recode pgpiyear (-100/-1=.)
(381,576 changes made to pgpiyear)

. replace pgpiyear=syear if pgpiyear>=. /*not mentioned in PAP, we did not know
>  about the high number of missing*/
(524,886 real changes made)

. recode pgmonth (-100/-1=.)
(18 changes made to pgmonth)

. replace pgmonth=2 if pgmonth>=. /*not mentioned in PAP, we did not know about
>  the high number of missing, February=modus*/
(143,328 real changes made)

. 
. gen intdate =mdy(pgmonth, 15, pgpiyear)

. format intdate %td

. lab var intdate "Date of interview"

. 
. 
. **********************
. * Treatment-Variable *
. **********************
. 
. * Daughter-Variable, Hypotheses 1, 2, 3, 4
. gen daughters=1 if intdate-birthdate_1>0 & kidsex01==2 //respondent has a fem
> ale child
(456,128 missing values generated)

. replace daughters=0 if intdate-birthdate_1>0 & kidsex01==1 //respondent has a
>  male child
(219,189 real changes made)

. replace daughters=. if intdate-birthdate_1<=0 // respondent does not (yet) ha
> ve a child
(0 real changes made)

. replace daughters=. if intdate>=. // missing date of interview
(0 real changes made)

. replace daughters=. if birthdate_1>=. /*typo in pap: ">0." --> corrected to "
> >=." */
(161,113 real changes made, 161,113 to missing)

. lab var daughters "Daughter"

. lab define daughterslbl 1 "daughter" 0 "son"

. lab value daughters daughterslbl

. *tab daughters kidsex01, m
. 
. 
. /*
> *************
> * Moderator *
> *************
> 
> * Sex of respondent (female-dummy), Hypotheses 3, 4
> gen female=1 if sex==2
> replace female=0 if sex==1
> replace female=. if sex<=0
> tab female sex, m
> lab var female "female respondent"
> lab define femalelbl 1 "female" 0 "male"
> lab value female femalelbl
> tab female sex, m
> 
> ************
> * Controls *
> ************
> 
> * Year of birth, Hypotheses 3, 4
> recode gebjahr (-100/-1=.), gen(birthyear)
