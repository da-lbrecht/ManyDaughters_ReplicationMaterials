(377,877 missing values generated)

. lab var birthdate_1 "Birthdate of first child"

. 
. * Birthdate second child
. recode kidgeb02 (-100/-1=.)
(340,439 changes made to kidgeb02)

. recode kidmon02 (-100/-1=.)
(442,842 changes made to kidmon02)

. gen birthdate_2=mdy(kidmon02, 15, kidgeb02) //day not recorded, set to the 15
> th of the month
(442,842 missing values generated)

. lab var birthdate_2 "Birthdate of second child"

. 
. * Date of interview
. recode pgpiyear (-100/-1=.)
(381,576 changes made to pgpiyear)

. replace pgpiyear=syear if pgpiyear>=. /*not mentioned in PAP, we did not know
>  about the high number of missing*/
(524,886 real changes made)

. recode pgmonth (-100/-1=.)
(18 changes made to pgmonth)

. replace pgmonth=2 if pgmonth>=. /*not mentioned in PAP, we did not know about
>  the high number of missing, February=mode*/
(143,328 real changes made)

. 
. gen intdate =mdy(pgmonth, 15, pgpiyear)

. format intdate %td

. lab var intdate "Date of interview"

. 
. 
