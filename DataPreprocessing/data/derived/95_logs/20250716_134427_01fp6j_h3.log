. * Treatment-Variable *
. **********************
. 
. * Daughter-Variable, Hypotheses 1, 2, 3, 4
. gen daughters=1 if intdate-birthdate_1>0 & kidsex01==2 //respondent has a fem
> ale child
(456,128 missing values generated)

. replace daughters=0 if intdate-birthdate_1>0 & kidsex01==1 //respondent has a
>  male child
(219,189 real changes made)

. replace daughters=. if intdate-birthdate_1<=0 // respondent does not (yet) ha
> ve a child
(0 real changes made)

. replace daughters=. if intdate>=. // missing date of interview
(0 real changes made)

. replace daughters=. if birthdate_1>=. /*typo in PAP: ">0." --> corrected to "
> >=." */
(161,113 real changes made, 161,113 to missing)

. lab var daughters "Daughter"

. lab define daughterslbl 1 "daughter" 0 "son"

. lab value daughters daughterslbl

. *tab daughters kidsex01, m
. 
. 
. 
. *************
