. **# EXTRACT AND EXPORT RESULTS * 
. 
. * Extract the required statistics
. 
.         * (i) coefficient estimate
.         local coefficient = r(table)[1,1]

. 
.         * (ii) standard error
.         local se = r(table)[2,1]

. 
.         * (iii) family of the test statistic (e.g. z, t, F, Chi²)
.         local test_stat_family = "t"

. 
.         * (iv) residual and model degrees of freedom (DFs) if applicable
.         local df_residual = e(df_r)

.         local df_model = e(df_m)

. 
.         * (v) p-value
.         local p_value =  r(table)[4,1]

. 
.         * (vi) number of observations
.         local num_obs = e(N)

. 
.         * (vii) number of participants
.         quietly levelsof pid if e(sample), local(participants)

.         local num_participants : word count `participants'

. 
.         * (viii) interpretation of directionality
.         scalar coef_d_daughter = _b[daughter]

.                 local interpretation "positive coefficient is in line with hy
> pothesis"

. 
. // Display the saved statistics
.         di "Coefficient: `coefficient'"
Coefficient: -.0176091140595441

.         di "Standard Error: `se'"
Standard Error: .0552739936911327

.         di "Test Statistic Family: `test_stat_family'"
Test Statistic Family: t

.         di "Residual Degrees of Freedom: `df_residual'"
Residual Degrees of Freedom: 2221

.         di "Model Degrees of Freedom: `df_model'"
Model Degrees of Freedom: 93

.         di "p-value: " `p_value'
p-value: .750076

.         di "Number of observations: " `num_obs'
Number of observations: 4739

.         di      "Number of participants: " `num_participants'
Number of participants: 4084

.         di "Interpretation of directionality: " "`interpretation'"
Interpretation of directionality: positive coefficient is in line with hypothes
> is

. 
.         * Export results to csv 
.         file open myfile using "$OUT/h2_results.csv", write replace
(file C:\Users\dalbrecht\Research
    Projects\ManyDaughters\ManyDaughters_DataPreprocessing/data/derived/95_re
    > sults/h2_results.csv not found)

.         file write myfile "coefficient,se,family,residual_df,model_df,p_value
> ,num_obs,num_participants,interpretation" _n

.         file write myfile "`coefficient', `se', `test_stat_family', `df_resid
> ual', `df_model',`p_value',`num_obs',`num_participants',`interpretation'" _n

.         file close myfile

. 
. 
. *****************************************************************************
> ***
. 
. exit

end of do-file

