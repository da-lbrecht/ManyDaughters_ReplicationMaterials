. gen housework_mo=pli0043_h if inrange(pli0043_h,0,24) & sex==2
(29,261 missing values generated)

. gen housework_fa=pli0043_h if inrange(pli0043_h,0,24) & sex==1
(29,981 missing values generated)

. 
. gen childcare_mo=pli0044_h if inrange(pli0044_h,0,24) & sex==2
(29,948 missing values generated)

. gen childcare_fa=pli0044_h if inrange(pli0044_h,0,24) & sex==1
(30,076 missing values generated)

. 
. gen time_mo=housework_mo+childcare_mo
(30,140 missing values generated)

. gen time_fa=housework_fa+childcare_fa
(30,485 missing values generated)

. 
. bysort couple_id syear: egen time_mo_min=min(time_mo)
(3,034 missing values generated)

. bysort couple_id syear: egen time_fa_min=min(time_fa)
(3,716 missing values generated)

. 
. gen EI=1-abs(time_mo_min-time_fa_min)/(time_mo_min+time_fa_min) 
(4,778 missing values generated)

. drop time_mo_min time_fa_min 

. 
. /*
> Initially, we prepared several outcome variables based on three survey questi
> ons in the SOEP.
> However, we have ultimately decided to use only one of these variables to tes
> t the hypothesis.
> The variables not used in the final analysis have been commented out in the c
> ode.
> 
> xtile EID=EI, nq(4)
> recode EID (1 2 3 = 0) (4=1)
> */
. 
. 
. // Regression
. 
. global control age i.male i.migration educ i.working child_age i.syear /*i.st
> ate*/

. 
. reg EI i.d_daughter $control, cluster(hid)

