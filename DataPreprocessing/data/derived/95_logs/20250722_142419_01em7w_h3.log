(190 missing values generated)

. 
.     replace pli0044_h = . if pli0044_h < 0
(364 real changes made, 364 to missing)

.     gen childcare_workdays = pli0044_h * 5
(364 missing values generated)

. 
.     replace pli0046 = . if pli0046 < 0
(887 real changes made, 887 to missing)

.     gen care_workdays = pli0046 * 5
(887 missing values generated)

