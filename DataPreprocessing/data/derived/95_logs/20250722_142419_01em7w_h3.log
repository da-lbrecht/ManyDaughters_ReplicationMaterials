> pli0046 plc0011

. 
.     * Drop if no biological kids ever
.     drop if kidsex01 <= 0
(216,893 observations deleted)

. 
.     * Drop if no partner
.     drop if parid == -2
(91,399 observations deleted)

. 
.     * Drop if pid missing
.     drop if pid == .
(0 observations deleted)

. 
.     * Keep only if respondent lives with partner
.     keep if pld0133 == 1
(318,255 observations deleted)

. 
. 
. * GENERATE VARIABLES * (Please adapt according to your needs)
. 
.     * Gender
.     replace sex = 0 if sex == 1
(16,737 real changes made)

.     replace sex = 1 if sex == 2
(19,839 real changes made)

. 
.     * Relative year to first childbirth
.     gen rel_year = syear - kidgeb01 if !missing(syear, kidgeb01)

.     keep if rel_year >= -3 & rel_year <= 3
(27,529 observations deleted)

. 
.     * First child female dummy (treatment group)
.     gen first_child_female = .
(9,047 missing values generated)

.     replace first_child_female = 1 if kidsex01 == 2 & !missing(kidsex01)
(4,538 real changes made)

.     replace first_child_female = 0 if kidsex01 == 1 & !missing(kidsex01)
(4,509 real changes made)

. 
.     * Post indicator (treatment timing)
.     gen post = .
(9,047 missing values generated)

.     replace post = 1 if syear >= kidgeb01 & !missing(kidgeb01)
(6,408 real changes made)

.     replace post = 0 if syear < kidgeb01 & kidgeb01 > 1900 & !missing(kidgeb0
> 1)
(2,639 real changes made)

. 
.     * Generate household labor measures
.     replace pli0040 = . if pli0040 < 0
(196 real changes made, 196 to missing)

.     gen errands_workdays = pli0040 * 5
(196 missing values generated)

. 
.     replace pli0012_h = . if pli0012_h < 0
(5,417 real changes made, 5,417 to missing)

.     replace pli0016_h = . if pli0016_h < 0
(5,439 real changes made, 5,439 to missing)

