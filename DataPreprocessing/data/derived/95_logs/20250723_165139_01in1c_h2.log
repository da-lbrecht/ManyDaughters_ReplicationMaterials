.         keep if d_child==1
(216,191 observations deleted)

. 
. * GENERATE CONTROL VARIABLES * 
.         *Gender variables
.         gen father=0

.         replace father=1 if sex==1
(197,727 real changes made)

.         
.         *Age
.         gen age=syear-gebjahr

.         
.         *Migration background
.         gen direct_mig=0

.         replace direct_mig=1 if migback==2
(93,908 real changes made)

.         
.         gen indirect_mig=0

.         replace indirect_mig=1 if migback==3
(15,673 real changes made)

.         
.         *Region of birth
.         gen west_region=.
(446,932 missing values generated)

.         replace west_region=1 if sampreg==1
(345,940 real changes made)

.         replace west_region=0 if sampreg==2
(100,245 real changes made)

.         
.         *Education
.         gen education=.
(446,932 missing values generated)

.         replace education=pgbilzeit if pgbilzeit>=0
(373,280 real changes made)

.         
. * POLITICAL PREFERENCES *
. 
.         *Generate political_preferences variable (0 ext. left - 10 ext. right
> )
.         gen political_preferences = .
(446,932 missing values generated)

.         replace political_preferences = plh0004 if inlist(syear, 2005, 2009, 
> 2014, 2019) ///
>     & inrange(plh0004, 0, 10)
(63,093 real changes made)

.         
. * HYPOTHESIS TEST FOR H2 *
. 
.         *We will be tested using OLS regressions, with standard errors cluste
> red at the individual level. We will interpret a two-sided p-value <0.05 in t
> he significance test of the coefficient of interest as statistically signific
> ant evidence.
.         *If having daughters promotes more leftist political preferences, we 
> should observe that the d_daughter regressor is negative.
.         *We control for individual level variables.
.         *We control for survey wave fixed effects
.         
.         reg political_preferences d_daughter ///
>         child_2 child_3 child_4 child_5 child_6 child_7 child_8 child_9 child
> _10 ///
>     child_11 child_12 child_13 child_14 child_15 child_16 child_17 child_18 c
> hild_19 ///
>         father age direct_mig indirect_mig west_region education i.syear
