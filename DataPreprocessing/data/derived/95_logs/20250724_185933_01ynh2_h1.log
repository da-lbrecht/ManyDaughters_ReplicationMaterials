> global OUT "$ROOT/out" // folder for output (results, tables)
> */
. 
. * ============================
. * DATA PREPARATION * 
. * ============================
. 
. ***Which Variables do we need from which dataset:
. *pl: plj0621 plj0622 plj0623 plj0624 plj0625 plj0620 ple0010_h plj0010 pld013
> 3 plj0122_h plh0258_h
. *biol: lb0285 lb0380 lb0381
. *biobirth: kidpnr01-kidpnr19 kidsex01-kidsex19 sumkids 
. *ppathl: sex
. *pgen: pgpsbil pglabnet  
. *hl: hlc0005_h
. 
. 
. ***inclusion criteria:
. *only 2016
. *at least one child lb0285 > 0
. 
. 
. * LOAD AND MERGE DATA * 
. 
.         use "$IN/ppathl.dta", clear 
(SOEP-Core, v37 (EU Edition), doi:10.5684/soep.core.v37eu)

.         keep sex pid hid syear corigin

.         
.         * biobirth contains information on fertility history
.         merge m:1 pid using "$IN/biobirth.dta", nogen keep(master matches) ke
> epusing(pid kidsex01-kidsex19 sumkids )
(variable pid was long, now double to accommodate using data's values)
(label sex already defined)
(label sex_EN already defined)

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                           663,123  
    -----------------------------------------

.         * biol 
.         merge 1:1 pid syear using "$IN/biol.dta", nogen keep(master matches) 
> keepusing(pid hid lb0285)
(label cid_EN already defined)
(label pid_EN already defined)
(label cid already defined)

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                           663,123  
    -----------------------------------------

.         * pgen contains user-friendly data on the individual level that are c
> onsolidated from different sources
.         merge 1:1 pid syear using "$IN/pgen.dta", nogen keep(master matches) 
> keepusing(pid hid syear pgpsbil pglabnet pgbilzeit)
(variable syear was long, now double to accommodate using data's values)

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                           663,123  
    -----------------------------------------

.         * pl contains all variables from the individual questionnaire
.         merge 1:1 pid syear using "$IN/pl.dta", nogen keep(master matches) ke
> epusing(pid hid syear plj0621 plj0622 plj0623 ///
>                 plj0624 plj0625 plj0620 plj0010 pld0133 plj0122_h plh0258_h p
> ld0131_v1 pld0132_h ple0010_h)
