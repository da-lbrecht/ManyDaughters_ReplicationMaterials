. 
. * ================================
. * Extract interaction coefficient
. * ================================
. 
. * Extract statistics
. local coefficient = _b[1.ParentSex#c.HavingDaughter]

. local se = _se[1.ParentSex#c.HavingDaughter]

. local df_model        = e(df_m)

. local test_stat_family = "z"

. local test_statistic = `coefficient'/`se'

. local p_value = 2*normal(-abs(`test_statistic'))

. local num_obs = e(N)

. quietly levelsof pid if e(sample), local(participants)

. local num_participants : word count `participants'

. local df_residual = `num_obs' - `df_model' - 1

. 
. * If the interaction coefficient is negative, that means the daughter effect 
> is weaker for mothers than for fathers (in support of H4)
. 
. scalar coef_d = _b[HavingDaughter]

. local interpretation = "positive coefficient is in line with hypothesis"

. 
