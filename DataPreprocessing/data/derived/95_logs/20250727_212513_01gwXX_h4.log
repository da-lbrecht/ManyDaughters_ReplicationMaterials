.         * standardize the measures 
.                 foreach y of varlist plh0301 plj0625 {
  2.                         g `y'copy = `y' if `y' >= 0 
  3.                         egen `y'mean = mean(`y'copy), by(syear)
  4.                         egen `y'sd = sd(`y'copy), by(syear) 
  5.                         g `y'use = (`y'copy - `y'mean) / `y'sd 
  6.         }
