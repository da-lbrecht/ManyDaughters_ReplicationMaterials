. * EXTRACT AND EXPORT RESULTS * 
. 
.         * Extract the required statistics
. 
. foreach reg in reg1 /*reg2 reg3 reg4 reg5 reg6*/ {
  2.         
.         capture $`reg'
  3.         if _rc != 2000 & _rc != 2001 {
  4.         $`reg'
  5.                                 
.         * (i) coefficient estimate
.         local coefficient = _b[daughter]
  6. 
.         * (ii) standard error
.         local se = _se[daughter]
  7. 
.         * (iii) family of the test statistic (e.g. z, t, F, Chi²)
.         local test_stat_family = "t"
  8. 
.         * (iv) residual and model degrees of freedom (DFs) if applicable
.         local df_residual = e(df_r)
  9.         local df_model = e(df_m)
 10. 
.         * (v) p-value
.         local p_value = _b[daughter] / _se[daughter]
 11.         local p_value = 2 * ttail(e(df_r), abs(`p_value'))
 12. 
.         * (vi) number of observations
.         local num_obs = e(N)
 13. 
.         * (vii) number of participants
.         quietly levelsof pid if e(sample), local(participants)
 14.         local num_participants : word count `participants'
 15. 
.         * (viii) interpretation of directionality
.         scalar coef_daughter = _b[daughter]
 16.                 local interpretation "positive coefficient is in line with
>  hypothesis"
 17. 
.         // Display the saved statistics
.         di "Coefficient: `coefficient'"
 18.         di "Standard Error: `se'"
 19.         di "Test Statistic Family: `test_stat_family'"
 20.         di "Residual Degrees of Freedom: `df_residual'"
 21.         di "Model Degrees of Freedom: `df_model'"
 22.         di "p-value: " `p_value'
 23.         di "Number of observations: " `num_obs'
 24.         di      "Number of participants: " `num_participants'
 25.         di "Interpretation of directionality: " "`interpretation'"
 26.         }
 27.                 
.         * Export results to csv 
.         file open myfile using "$OUT/h3_results.csv", write replace
 28.         file write myfile "coefficient,se,family,residual_df,model_df,p_va
> lue,num_obs,num_participants,interpretation" _n
 29.         file write myfile "`coefficient', `se', `test_stat_family', `df_re
> sidual', `df_model',`p_value',`num_obs',`num_participants',`interpretation'" 
> _n
 30.         file close myfile
 31.         
.         local i=`i'+1
 32. }

