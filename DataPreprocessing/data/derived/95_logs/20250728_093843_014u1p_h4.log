. * HYPOTHESIS TEST FOR H4 * 
. 
. //having a daughter, the respondent is more likely to support gender equality
>  (having more progressive attitudes on working mothers and division of family
>  responsibility)
. //the effect is greater on fathers than on mothers
. //we analyze the change in attitude before and after having a child within th
> e period of 2012 and 2018
. //we generate a gender equality attitudes index from plh0308_v[1,2] plh0298_v
> [1,2] plh0302_v[1,2] and then standardize
. //we run a OLS regression analysis with gender equality attitude index 2018 a
> s dependent variable and interaction between dummy variables daughter and fat
> her as main independent variable as well as the dummy variable daughter, gend
> er equality attitude index 2012, and the dummy variable father (Model 1)
. //should Model 1 result in insufficient observations, we run Model 2 where we
>  analyze gender equality attitudes in the wave immidiatly followed by having 
> a child
. //the second and third regressions are robustness checks for Model 1
. 
. gl CONTROLS1 "edu1 edu2 edu3 edu4 edu5 child_age_t age_t year"

. gl CONTROLS2 "catholic protestant nonreligious migrant married hhincome_cap h
> gfhinc fulltime parttime workhours_cap workhours_miss disability"

. gl CONTROLS3 "birth_east siblings_female siblings_male"

. 
. gl reg1 "reg gender_equality_attitudes_tstd daughter##father gender_equality_
> attitudes_blstd $CONTROLS1 if exclusion==0 & syear==2012, robust"

. gl reg2 "reg gender_equality_attitudes_tstd daughter##father gender_equality_
> attitudes_blstd $CONTROLS1 $CONTROLS2 if exclusion==0 & syear==2012, robust"

. gl reg3 "reg gender_equality_attitudes_tstd daughter##father gender_equality_
> attitudes_blstd $CONTROLS1 $CONTROLS2 $CONTROLS3 if exclusion==0 & syear==201
> 2, robust"

. 
. //if e(sample)<400 
. gl CONTROLS1b "edu1 edu2 edu3 edu4 edu5 child_age age year"

. 
. gl reg1b "reg gender_equality_attitudes_std daughter##father $CONTROLS1b if e
> xclusion2==0, robust"

. gl reg2b "reg gender_equality_attitudes_std daughter##father $CONTROLS1b $CON
> TROLS2 if exclusion2==0, robust"

. gl reg3b "reg gender_equality_attitudes_std daughter##father $CONTROLS1b $CON
> TROLS2 $CONTROLS3 if exclusion2==0, robust"

. 
. sum gender_equality_attitudes_tstd gender_equality_attitudes_blstd $CONTROLS1
>  $CONTROLS2 $CONTROLS3 if exclusion==0 & syear==2012

