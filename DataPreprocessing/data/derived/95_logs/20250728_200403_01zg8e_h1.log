. 
. * First child was born one year before the survey
. gen sample_h1 = inlist(first_byear, 2011, 2017)

. 
. preserve

. keep if sample_h1 == 1
(438,532 observations deleted)

. 
. replace gender_attitudes = . if syear != first_byear + 1
(288 real changes made, 288 to missing)

. 
. save "$DATA/h1_dataset.dta", replace
file C:\Users\dalbrecht\Research
    Projects\ManyDaughters\ManyDaughters_DataPreprocessing/data/derived_confi
    > dential/95%-sample/h1_dataset.dta saved

. 
. restore

. 
. *****************************************************************************
> ***
.                 /*  H1: Having daughters leads to stronger support for 
>                                         gender equality (as measured by attit
> udes).  */
. *****************************************************************************
> ***
. 
. * Authors: [REDACTED], [REDACTED] (based on example code)
. 
. use "$DATA/h1_dataset.dta", clear

. 
. 
. * ============================
. * Analysis
. * ============================
. 
. 
. * HYPOTHESIS TEST FOR H1 * 
. 
.         /* We regress the gender attitude index (measured in the year after t
> he
>         first child was born) on the first child being a girl, age of the par
> ent
>         and survey year. We cluster the standard errors on the household leve
> l.
>         The value of the index is greater the more equal the attitudes are. *
> /
. 
.         reg gender_attitudes i.first_daughter age i.syear, cluster(hid)

Linear regression                               Number of obs     =        211
                                                F(3, 135)         =       2.25
                                                Prob > F          =     0.0852
                                                R-squared         =     0.0388
                                                Root MSE          =      1.237

                                  (Std. err. adjusted for 136 clusters in hid)
------------------------------------------------------------------------------
             |               Robust
gender_att~s | Coefficient  std. err.      t    P>|t|     [95% conf. interval]
-------------+----------------------------------------------------------------
1.first_da~r |  -.2915674    .197262    -1.48   0.142     -.681691    .0985561
         age |   -.027664   .0159483    -1.73   0.085    -.0592048    .0038769
             |
       syear |
       2018  |  -.5472182   .5472788    -1.00   0.319    -1.629567    .5351309
             |
       _cons |   1.148572   .6903473     1.66   0.098    -.2167221    2.513867
------------------------------------------------------------------------------

. 
. 
. * EXTRACT AND EXPORT RESULTS * 
. 
.         * Extract the required statistics
. 
.                 * (i) coefficient estimate
.                 local coefficient = _b[1.first_daughter]

. 
.                 * (ii) standard error
.                 local se = _se[1.first_daughter]

. 
.                 * (iii) family of the test statistic (e.g. z, t, F, Chi²)
.                 local test_stat_family = "t"

. 
.                 * (iv) residual and model degrees of freedom (DFs) if applica
> ble
.                 local df_residual = e(df_r)

.                 local df_model = e(df_m)

. 
.                 * (v) p-value
.                 local p_value = _b[1.first_daughter] / _se[1.first_daughter]

.                 local p_value = 2 * ttail(e(df_r), abs(`p_value'))

. 
.                 * (vi) number of observations
.                 local num_obs = e(N)

. 
.                 * (vii) number of participants
.                 quietly levelsof pid if e(sample), local(participants)

.                 local num_participants : word count `participants'

. 
.                 * (viii) interpretation of directionality
.                 scalar coef_first_daughter = _b[1.first_daughter]

.                 local interpretation "positive coefficient is in line with hy
> pothesis"

. 
.         // Display the saved statistics
.         di "Coefficient: `coefficient'"
Coefficient: -.2915674435282478

.         di "Standard Error: `se'"
Standard Error: .1972620223298207

.         di "Test Statistic Family: `test_stat_family'"
Test Statistic Family: t

.         di "Residual Degrees of Freedom: `df_residual'"
Residual Degrees of Freedom: 135

.         di "Model Degrees of Freedom: `df_model'"
Model Degrees of Freedom: 3

.         di "p-value: " `p_value'
p-value: .14171787

.         di "Number of observations: " `num_obs'
Number of observations: 211

.         di      "Number of participants: " `num_participants'
Number of participants: 211

.         di "Interpretation of directionality: " "`interpretation'"
Interpretation of directionality: positive coefficient is in line with hypothes
> is

. 
.         * Export results to csv 
.         file open myfile using "$OUT/h1_results.csv", write replace
(file C:\Users\dalbrecht\Research
    Projects\ManyDaughters\ManyDaughters_DataPreprocessing/data/derived/95_re
    > sults/h1_results.csv not found)

.         file write myfile "coefficient,se,family,residual_df,model_df,p_value
> ,num_obs,num_participants,interpretation" _n

.         file write myfile "`coefficient',`se',`test_stat_family',`df_residual
> ',`df_model',`p_value',`num_obs',`num_participants',`interpretation'" _n

.         file close myfile

. 
. 
. *****************************************************************************
> ***
. 
. exit

end of do-file

