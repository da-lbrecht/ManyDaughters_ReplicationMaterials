. *****************************************************************************
> ***
.                                 /* Create and recode variables for H1-H4  */
. *****************************************************************************
> ***
. 
. 
. * Generate age
. gen age = syear - gebjahr

. 
. ** First child is a girl
. 
. gen first_daughter = kidsex01 == 2 if inlist(kidsex01, 1, 2)

. rename kidgeb01 first_byear

.         
. 
. ********************************* Outcomes **********************************
> **
. 
. ** H3: gender equality in the household measured by behavior **
. 
. /* Weekly hours spent on non-paid work (childcare, housework, errands, repara
> tion,
>         caring for persons) -- inequality within household (Gini) */
.         
. foreach v in pli0010 pli0011 pli0012_h pli0016_h pli0019_h pli0022_h ///
>         pli0024_h pli0028_h pli0031_h pli0036 pli0038_h pli0040 pli0043_h ///
>         pli0044_h pli0046 pli0049_h pli0051 pli0055 pli0057 pli0162 pli0163 /
> //
>         pli0164 {
  2.         replace `v' = . if `v'<0
  3. }       
(207,420 real changes made, 207,420 to missing)
(212,521 real changes made, 212,521 to missing)
(206,830 real changes made, 206,830 to missing)
(208,093 real changes made, 208,093 to missing)
(211,064 real changes made, 211,064 to missing)
(211,176 real changes made, 211,176 to missing)
(212,663 real changes made, 212,663 to missing)
(212,759 real changes made, 212,759 to missing)
(208,397 real changes made, 208,397 to missing)
(207,355 real changes made, 207,355 to missing)
(16,037 real changes made, 16,037 to missing)
(18,170 real changes made, 18,170 to missing)
(14,241 real changes made, 14,241 to missing)
(17,971 real changes made, 17,971 to missing)
(37,374 real changes made, 37,374 to missing)
(14,024 real changes made, 14,024 to missing)
(10,133 real changes made, 10,133 to missing)
(212,725 real changes made, 212,725 to missing)
(212,787 real changes made, 212,787 to missing)
(219,722 real changes made, 219,722 to missing)
(307,073 real changes made, 307,073 to missing)
(307,135 real changes made, 307,135 to missing)

. 
. gen weekly_nonpaid = pli0011 + pli0012_h + pli0016_h + pli0019_h ///
>         + pli0022_h + pli0031_h + 5*pli0040 + 5*pli0043_h + 5*pli0044_h ///
>         + 5*pli0046 + 5*pli0049_h + pli0055 + pli0057
(283,130 missing values generated)

. 
. * Everyone only has 168 hours in a week
. replace weekly_nonpaid = 168 if weekly_nonpaid > 168 & weekly_nonpaid != .
(2,502 real changes made)

. 
. * Keep those with partners
. keep if parid > 0
(91,399 observations deleted)

. 
. * Gen inequality within household
. preserve

.         keep syear pid hid age sex weekly_nonpaid

.         rename pid parid

.         rename hid hid_partner

.         rename sex sex_partner

.         rename weekly_nonpaid weekly_nonpaid_partner

.         rename age age_partner

.         tempfile partnerhousework

.         save `partnerhousework'
