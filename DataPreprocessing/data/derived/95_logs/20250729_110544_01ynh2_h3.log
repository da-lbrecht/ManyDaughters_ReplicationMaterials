. *------------------------------------------------------
. * Define component list
. *------------------------------------------------------
.         local components pli0043_h pli0012_h pli0016_h pli0044_h pli0019_h pl
> i0022_h pli0054 pli0049_h

. 
. *------------------------------------------------------
. * unpaid_work by year
. *------------------------------------------------------
.         levelsof syear, local(years)
2001 2006 2011 2016

.         gen unpaid_work = .
(13,358 missing values generated)

. 
.         foreach y of local years {
  2.                 local varlist
  3.                 foreach v of local components {
  4.                         qui count if syear == `y' & !missing(`v')
  5.                         if r(N) > 0 {
  6.                                 local varlist `varlist' `v'
  7.                         }
  8.                 }
  9. 
.     egen unpaid_work_`y' = rowtotal(`varlist') if syear == `y'
 10.     replace unpaid_work = unpaid_work_`y' if syear == `y'
 11.     drop unpaid_work_`y'
 12. }
