. 
. ***recode missing values
.         replace plj0122_h = . if inlist(plj0122_h, -9, -8, -7, -6, -5, -3, -2
> , -1)
(472,249 real changes made, 472,249 to missing)

.         replace plj0123_h = . if inlist(plj0123_h, -9, -8, -7, -6, -5, -3, -2
> , -1)
(471,804 real changes made, 471,804 to missing)

. 
.         recode plj0122_h (0 = 1) (2/6 = 0), gen(d_daughter)
(39,735 differences between plj0122_h and d_daughter)

.         label define distance 0 "[0] not in household" 1 "[1] in household", 
> replace

.         label values d_daughter distance

. 
.         recode plj0123_h (0 = 1) (2/6 = 0), gen(d_son)
(39,956 differences between plj0123_h and d_son)

.         label define distances 0 "[0] not in household" 1 "[1] in household",
>  replace

.         label values d_son distances

. 
.         
. *------------------------------------------------------ 
. * SINGLEPARENT: Singleparent/ partner in household 
. *------------------------------------------------------
. 
. *INFO: pld0133 is conditional on having a "Lebensgemeinschaft". Married peopl
> e living with their partner (pld0131_v1 == 1) are also coded as 1 (partner li
> ves in household)
. 
.         gen with_partner = .
(663,123 missing values generated)

.         *married people living with their partner
.         replace with_partner = 1 if pld0131_v1 == 1 
(258,212 real changes made)

.         *partner lives in household
.         replace with_partner = 1 if pld0133 == 1
(52,558 real changes made)

.         *partner does not live in household
.         replace with_partner = 0 if pld0133 == 2
(41,423 real changes made)

.         *no "Lebensgemeinschaft" = no partner
.         replace with_partner = 0 if pld0132_h == 2
(107,310 real changes made)

. 
.         label define with_partner ///
>                 0       "[0] no(t with) partner " ///
>                 1       "[1] partner lives in household" ///
>                 , replace

.         label values with_partner with_partner

. 
.         
. **drop if partner does not live in the same household
.         drop if with_partner != 1 
(352,353 observations deleted)

. *drop if neither son nor daughter live in the same household
