. label variable num_daughters "Number of daughters"

. 
. gen d_daughter = (num_daughters > 0)

. label variable d_daughter "Has at least one daughter (1) or not (0)"

. 
. ** Generate age variable 
. 
. gen age = syear - gebjahr

. 
. ** Recode sex variable 
. 
. replace sex = 0 if sex == 2
(218,142 real changes made)

. 
. ** Generate east dummy 
. 
. generate east = . 
(390,607 missing values generated)

. replace east = 1 if sampreg == 2
(90,195 real changes made)

. replace east = 0 if sampreg == 1
(300,387 real changes made)

. 
. 
. *------------------------------
. ** Create marital status variable 
. ** bins: married [1, 7], single [3], been married [2, 4, 5, 6, 8]
. 
. gen marital_cat = .  // create the variable
(390,607 missing values generated)

. 
. // Married: [1] Married, [7] Registered Same-Sex Partnership, Living together
. replace marital_cat = 1 if inlist(pgfamstd, 1, 7)
(269,932 real changes made)

. 
. // Single: [3] Single
. replace marital_cat = 2 if pgfamstd == 3
(34,622 real changes made)

. 
. // Been Married: [2] Separated, [4] Divorced, [5] Widowed, [6] Partner abroad
> , [8] Registered same-sex partnership living apart
. replace marital_cat = 3 if inlist(pgfamstd, 2, 4, 5, 6, 8)
(69,268 real changes made)

. 
. // Optional: label the categories
. label define marital_lbl 1 "Married" 2 "Single" 3 "Been married"

. label values marital_cat marital_lbl

. 
. 
. *  ---------------------------------
. ** Create employment status variable 
. 
. gen emp_cat = .
(390,607 missing values generated)

. 
. * 1 = Full-time employment
. replace emp_cat = 1 if pgemplst == 1
(142,043 real changes made)

. 
. * 2 = Part-time (regular or marginal, vocational training and other small gro
> ups)
. replace emp_cat = 2 if inlist(pgemplst, 2, 3, 4, 6, 7)
(77,780 real changes made)

. 
. * 3 = Not employed
. replace emp_cat = 3 if pgemplst == 5
(155,610 real changes made)

. 
. * Label
. label define emp_cat_lbl ///
>     1 "Full-time" ///
>     2 "Part-time" ///
>     3 "Unemployed"

. 
. label values emp_cat emp_cat_lbl

. 
. 
. ** EXCLUDE VARIABLES WITH MISSINGS **
. 
. * Dependent variable
. 
. keep if plh0004 >= 0
(312,512 observations deleted)

. drop if plh0004 == .
(15,313 observations deleted)

. 
. * Reverse scale
. gen left = 10 - plh0004 if inrange(plh0004, 0, 10)

. label variable left "Political orientation (higher = more left-leaning)"

. 
. * Sex 
. 
. drop if sex != 1 & sex != 0
(2 observations deleted)

. 
. * Age 
. 
. drop if age < 18
(31 observations deleted)

. 
. * Region 
. 
. drop if east == . 
(22 observations deleted)

. 
. * Education
. 
. drop if pgbilzeit < 0 
(865 observations deleted)

. 
. * Household income 
. 
. drop if hghinc < 0
(2,838 observations deleted)

. 
. * Generate ln(hghinc)
. 
. gen ln_hghinc = ln(hghinc)
(2 missing values generated)

. 
. * Employment Status 
. drop if emp_cat == .
(0 observations deleted)

. 
. * Marital Status 
. drop if marital_cat == .
(176 observations deleted)

. 
.         
. * HYPOTHESIS TEST FOR H2 * 
. 
. * A linear OLS regression testing whether having daughters is associated with
>  more left-leaning political preferences, conditional on having at least one 
> child. The outcome variable is political orientation (plh0004), measured on a
>  scale from 0 (completely left) to 10 (completely right). To align with our h
> ypothesis that daughters are associated with more left-leaning attitudes, we 
> created a new variable "left" and reversed the scale: 0 = right, 10 = left 
. 
. * Outcome variable: left
. * Main explanatory variable: d_daughter (a dummy equal to 1 if the respondent
>  has at least one daughter (and 0 otherwise))
. 
. * We control for standard demographic covariates:
. * - sex (0 = female, 1 = male),
. * - age,
. * - years of education (pgbilzeit),
. * - log of household net income (ln_hghinc),
. * - number of children,
. * - region (east = 1 if living in East Germany),
. * and include fixed effects for survey year (syear).
. 
. * We also control for employment status and marital status to account for soc
> ioeconomic status and life-cycle differences.
. 
. * The model is estimated using heteroskedasticity-robust standard errors.
. 
. local controls sex age pgbilzeit ln_hghinc num_children east i.emp_cat i.mari
> tal_cat i.syear

. 
.         reg left d_daughter `controls', robust

