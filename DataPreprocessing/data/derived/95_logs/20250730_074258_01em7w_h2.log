. * GENERATE VARIABLES * (Please adapt according to your needs)
. 
.     * Left-Right political scale (DV)
.     gen lrscale = plh0004
(67,081 missing values generated)

.     replace lrscale = . if lrscale < 0
(316,135 real changes made, 316,135 to missing)

. 
.     * First child female dummy (treatment group)
.     gen first_child_female = .
(446,230 missing values generated)

.     replace first_child_female = 1 if kidsex01 == 2 & !missing(kidsex01)
(216,749 real changes made)

.     replace first_child_female = 0 if kidsex01 == 1 & !missing(kidsex01)
(229,481 real changes made)

. 
.     * Post indicator (treatment timing)
.     gen post = .
(446,230 missing values generated)

.     replace post = 1 if syear >= kidgeb01 & !missing(kidgeb01)
(428,884 real changes made)

.     replace post = 0 if syear < kidgeb01 & kidgeb01 > 1900 & !missing(kidgeb0
> 1)
(17,346 real changes made)

. 
.     * Control variables
.     replace sex = 0 if sex == 1
(197,446 real changes made)

.     replace sex = 1 if sex == 2
(248,780 real changes made)

. 
.     replace germborn = 0 if germborn == 1
(352,610 real changes made)

.     replace germborn = 1 if germborn == 2
(93,620 real changes made)

. 
.     rename sampreg westgerm

.     replace westgerm = . if westgerm <= 0
(744 real changes made, 744 to missing)

.     replace westgerm = 0 if westgerm == 2
(100,097 real changes made)

. 
.     replace partner = . if partner < 0 | partner == 5
(1,440 real changes made, 1,440 to missing)

.     replace partner = 1 if partner != 0
(38,794 real changes made)

. 
.     replace pgbilzeit = . if pgbilzeit < 0
(6,488 real changes made, 6,488 to missing)

. 
.     gen age = syear - gebjahr

.     gen age_sq = age^2

. 
.     gen ln_hghinc = log(hghinc)
(71,838 missing values generated)

.         
.         * Dummies for number of kids
.         forvalues k = 0/7 {
  2.                 gen kids_`k' = .
  3.                 replace kids_`k' = 1 if sumkids == `k'
