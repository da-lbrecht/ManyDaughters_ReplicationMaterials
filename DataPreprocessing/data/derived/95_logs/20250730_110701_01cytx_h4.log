. * ============================
. 
. * clear all
. version 17 // indicate the version of stata you are using here

. set maxvar 10000 // extend the maximum number of variables to 10,000


. 
. * INSTALL PACKAGES * (Please adapt according to your needs)
. * install all packages you need here, for example:
. * ssc install outreg2
. 
. * CONFIGURE FILE PATHS * (Please do not change)
. /*
> * the following code automatically sets paths based on where you saved the di
> stributed file-package on your system *
> if strpos("`c(pwd)'", "code") {
>     global ROOT "`c(pwd)'/.."
> }
> else {
>     global ROOT "`c(pwd)'"
> }
> global IN "$ROOT/data/raw" // folder, in which the original datasets are stor
> ed
> global DATA "$ROOT/data/derived" // folder for datasets
> global OUT "$ROOT/out" // folder for output (results, tables)
> 
> */
. 
. * ============================
. * Data Preparation * 
. * ============================
. 
. * LOAD AND MERGE DATA * (Please adapt according to your needs)
. 
.         use "$IN/ppathl.dta", clear // use ppathl as a starting dataset
(SOEP-Core, v37 (EU Edition), doi:10.5684/soep.core.v37eu)

. 
.         * Merge ppathl with all datasets, that you deem relevant for your ana
> lysis. (Tip: use keepusing() to specify which variables to keep from the usin
> g dataset; the default is all.)
. 
.         * biobirth contains information on fertility history
.         merge m:1 pid using "$IN/biobirth.dta", nogen keep(master matches)
(variable pid was long, now double to accommodate using data's values)
(variable cid was long, now double to accommodate using data's values)
(variable gebjahr was int, now double to accommodate using data's values)
(label sex already defined)
(label sex_EN already defined)

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                           663,123  
    -----------------------------------------

.         * pgen contains user-friendly data on the individual level that are c
> onsolidated from different sources
.         merge 1:1 pid syear using "$IN/pgen.dta", nogen keep(master matches)
(variable syear was long, now double to accommodate using data's values)

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                           663,123  
    -----------------------------------------

.         * pl contains all variables from the individual questionnaire
.         merge 1:1 pid syear using "$IN/pl.dta", nogen keep(master matches)
(variable inputdataset was str6, now str9 to accommodate using data's values)
(label cid_EN already defined)
(label pid_EN already defined)
(label cid already defined)

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                           663,123  
    -----------------------------------------

.         * hgen contains generated variables on household level from the house
> hold interview; use for household net income
.         merge m:1 hid syear using "$IN/hgen.dta", nogen keep(master matches) 
> keepusing(hid syear hghinc)
(label iyear already defined)
(label iyear_EN already defined)

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                           663,123  
    -----------------------------------------

. 
.         label language EN // change language of the labels to English

. 
.         save "$DATA/h4_dataset.dta", replace // save merged dataset
file C:\Users\dalbrecht\Research
    Projects\ManyDaughters\ManyDaughters_DataPreprocessing/data/derived_confi
    > dential/95%-sample/h4_dataset.dta saved

. 
. 
. * ============================
. * Analysis
. * ============================
. 
. ******************
. ***** H4
. ******************
. * Main dependent variable for H4: plh0308_v2 
. * "It's best if the man and the woman work the same amount so they can share 
> the responsibility for taking care of the family and household equally."
. * The latest available year is 2018.
. 
. ******************
. **** Filters
. ******************
. gen year=2018

. 
. *** 1) Keep the latest available year 
. keep if syear==year
(624,400 observations deleted)

. 
. *** 2) Keep individuals with 1 to 5 children
. gen number_kids=.
(38,723 missing values generated)

. replace number_kids= 1 if kidsex01==1 | kidsex01==2
(26,415 real changes made)

. replace number_kids= 2 if kidsex02==1 | kidsex02==2
(19,783 real changes made)

. replace number_kids= 3 if kidsex03==1 | kidsex03==2
(9,186 real changes made)

. replace number_kids= 4 if kidsex04==1 | kidsex04==2
(3,865 real changes made)

. replace number_kids= 5 if kidsex05==1 | kidsex05==2
(1,724 real changes made)

. replace number_kids= 6 if kidsex06==1 | kidsex06==2
(788 real changes made)

. keep if number_kids>=1 & number_kids <=5
(13,060 observations deleted)

. 
. *** 3) Exclude families with first-born twins
. *** Proxy for the first-born is the first and second child are born in the sa
> me year and in the sam months
. drop if (kidgeb01 == kidgeb02) & (kidmon01==kidmon02) & kidgeb01>0
(345 observations deleted)

. 
. *** 4) Exclude not heterosexual individuals 
. drop if sexor!=0
(1,287 observations deleted)

. 
. *** 5) Keep only individuals with an identity as a man or a woman
. keep if sex ==1 | sex==2 
(0 observations deleted)

. 
. *** 6) Keep only individuals who are not younger as 25 and not older than 60
. gen age = year-ple0010_h
(5,044 missing values generated)

. keep if age >=25 & age <=60
(10,747 observations deleted)

. 
. *** 7) Keep only individuals who were born in Germany
. keep if corigin==1
(4,583 observations deleted)

. 
. **** Private housholds only
. keep if inlist(pop,1,2)
(29 observations deleted)

. 
. ****************************************************************
. * GENERATE VARIABLES * (Please adapt according to your needs)
. ****************************************************************
. ** Dependent variable H4:
. replace plh0308_v2=. if plh0308_v2<0
(69 real changes made, 69 to missing)

. sum  plh0308_v2, d

     Best if man and woman work the same amount so they
                can share the responsibility 
-------------------------------------------------------------
      Percentiles      Smallest
 1%            1              1
 5%            2              1
10%            3              1       Obs               8,603
25%            4              1       Sum of wgt.       8,603

50%            6                      Mean           5.270603
                        Largest       Std. dev.      1.813305
75%            7              7
90%            7              7       Variance       3.288077
95%            7              7       Skewness      -.7456374
99%            7              7       Kurtosis        2.45078

. gen z_plh0308_v2 = (plh0308_v2-r(mean))/r(sd)
(69 missing values generated)

. 
. 
. ** Independent variable:
. ***** First born child is daughter
. gen d_daughter=1 if kidsex01==2 // 1 if the first-born child is female
(4,363 missing values generated)

. replace d_daughter=0 if kidsex01==1 // 0 if the first-born child is m
(4,362 real changes made)

. 
. ** Control variables: 
. *** male dummy
. gen male=1 if sex ==1
(5,019 missing values generated)

. replace male =0 if sex ==2
(5,019 real changes made)

. 
. ** Interaction of the gender and the first child is a daugher dummy:
. gen maleXd_daughter = male*d_daughter
(1 missing value generated)

. 
. 
. *** age --> see above
. 
. *** number of other daughters
. gen num_daughters_02_05=0

. replace num_daughters_02_05= num_daughters_02_05+1 if kidsex02==2
(3,037 real changes made)

. replace num_daughters_02_05= num_daughters_02_05+1 if kidsex03==2
(1,123 real changes made)

. replace num_daughters_02_05= num_daughters_02_05+1 if kidsex04==2
(287 real changes made)

. replace num_daughters_02_05= num_daughters_02_05+1 if kidsex05==2
(60 real changes made)

. 
. *** number of children --> see above 
. 
. *** race of the respondent (dummy equals one if White-Caucasian vs. zero if n
> ot)
. * not included in year 2018
. 
. *** age of the first-born child at the point of the survey
. gen age_kid_01= year - kidgeb01 if kidgeb01>0
(2 missing values generated)

. 
. *** highest educational level achieved by the respondent (linear value, 0 = w
> ithout school degree, 1 = school degree, 2 = professional degree (Ausbildung)
> , 3 = university degree)
. * not available. Instead number of years in education
. gen education_yrs= pgbilzeit if pgbilzeit>=0
(152 missing values generated)

. 
. *** marital status (dummy, equals one if married or living with a partner, ze
> ro otherwise)
. * we control only for married, as living in together (not-marries) is not ava
> ilable.
. gen married=1 if pgfamstd==1
(2,624 missing values generated)

. replace married =0 if pgfamstd!=1
(2,624 real changes made)

. 
. *** political party affiliation
. * will reduce the sample by half
. 
. *** religion
. * not included in year 2018
. 
. *** employment status (linear value, 0 not employed, 1 part-time, 2 full-time
> , 3 self-employed)
. gen employment = 0 if pgemplst ==5
(7,425 missing values generated)

. replace employment = 1 if pgemplst ==2 | pgemplst ==4
(2,808 real changes made)

. replace employment = 3 if pgemplst ==1
(4,582 real changes made)

. 
. *** income
. gen income = pglabgro if pglabgro>=0
(1,243 missing values generated)

. * The missing values are set to 0 for those respondents who chose "doesn't ap
> ply" and are not employed
. replace income =0 if pglabgro ==-2 & employment ==0
(1,243 real changes made)

. 
. *** east/west Germany (dummy)
. gen west=1 if sampreg  ==1
(2,252 missing values generated)

. replace west=0 if sampreg==2
(2,252 real changes made)

. 
. **************************************************************************
. ***** HYPOTHESIS TEST FOR H4 * (Please adapt according to your needs)
. **************************************************************************
. 
.         * Let's  assume that agreeing with the statement "It's best if the ma
> n and the woman work the same amount so they can share the responsibility for
>  taking care of the family and household equally." is a good measure of suppo
> rt for gender equality attitudes (hypothesis 1), 
.         * if the interaction variable of male and agreeing with the statement
>  is positive and sign., that indicates that having a daugher leads to a great
> er increase in support of gender equality among men than among women. 
.         * Accordingly, we run a linear OLS regression analysis with normalize
> d plh0308_v2 as the dependent variable and the dummy variable d_daughter (the
>  first child is a girl), male, and the interaction term of the two.
.         * We use control variables as specified in the PAP and defined above.
>  
. 
. reg z_plh0308_v2 d_daughter male maleXd_daughter age num_daughters_02_05 numb
> er_kids age_kid_01 education_yrs married income employment west, ro

Linear regression                               Number of obs     =      8,419
                                                F(12, 8406)       =      63.27
                                                Prob > F          =     0.0000
                                                R-squared         =     0.0726
                                                Root MSE          =     .96362

------------------------------------------------------------------------------
             |               Robust
z_plh0308_v2 | Coefficient  std. err.      t    P>|t|     [95% conf. interval]
-------------+----------------------------------------------------------------
  d_daughter |   .0271919   .0274084     0.99   0.321    -.0265353     .080919
        male |  -.0651739   .0330615    -1.97   0.049    -.1299826   -.0003652
maleXd_dau~r |  -.0284304   .0426749    -0.67   0.505    -.1120838    .0552229
         age |   .0027216   .0024753     1.10   0.272    -.0021306    .0075738
num_daugh~05 |   .0025919   .0203118     0.13   0.898    -.0372242    .0424081
 number_kids |   -.074344   .0156475    -4.75   0.000    -.1050169   -.0436712
  age_kid_01 |   .0105277   .0021967     4.79   0.000     .0062216    .0148339
education_~s |   .0147486    .004499     3.28   0.001     .0059295    .0235678
     married |  -.1631585   .0234761    -6.95   0.000    -.2091775   -.1171396
      income |   -.000017   6.11e-06    -2.78   0.006    -.0000289   -4.99e-06
  employment |   .0378811   .0119134     3.18   0.001     .0145279    .0612343
        west |  -.4234523   .0232835   -18.19   0.000    -.4690937   -.3778109
       _cons |   .0664174    .098109     0.68   0.498    -.1259005    .2587352
------------------------------------------------------------------------------

. 
. 
. * EXTRACT AND EXPORT RESULTS * (Please check whether the suggested code autom
> atically picks up the correct statistics for your chosen regression analysis 
> and adapt if needed)
. 
.         * Extract the required statistics
. 
.                 * (i) coefficient estimate
.                 local coefficient = _b[maleXd_daughter]

. 
.                 * (ii) standard error
.                 local se = _se[maleXd_daughter]

. 
.                 * (iii) family of the test statistic (e.g. z, t, F, Chi²)
.                 local test_stat_family = "t"

. 
.                 * (iv) residual and model degrees of freedom (DFs) if applica
> ble
.                 local df_residual = e(df_r)

.                 local df_model = e(df_m)

. 
.                 * (v) p-value
.                 local p_value = _b[maleXd_daughter] / _se[maleXd_daughter]

.                 local p_value = 2 * ttail(e(df_r), abs(`p_value'))

. 
.                 * (vi) number of observations
.                 local num_obs = e(N)

. 
.                 * (vii) number of participants
.                 quietly levelsof pid if e(sample), local(participants)

.                 local num_participants : word count `participants'

. 
.                 * (viii) interpretation of directionality
.                 scalar coef_maleXd_daughter = _b[maleXd_daughter]

.                 local interpretation "positive coefficient is in line with hy
> pothesis"

. 
.         // Display the saved statistics
.         di "Coefficient: `coefficient'"
Coefficient: -.0284304379978223

.         di "Standard Error: `se'"
Standard Error: .0426749228350523

.         di "Test Statistic Family: `test_stat_family'"
Test Statistic Family: t

.         di "Residual Degrees of Freedom: `df_residual'"
Residual Degrees of Freedom: 8406

.         di "Model Degrees of Freedom: `df_model'"
Model Degrees of Freedom: 12

.         di "p-value: " `p_value'
p-value: .5052955

.         di "Number of observations: " `num_obs'
Number of observations: 8419

.         di      "Number of participants: " `num_participants'
Number of participants: 8419

.         di "Interpretation of directionality: " "`interpretation'"
Interpretation of directionality: positive coefficient is in line with hypothes
> is

. 
.         * Export results to csv 
.         file open myfile using "$OUT/h4_results.csv", write replace
(file C:\Users\dalbrecht\Research
    Projects\ManyDaughters\ManyDaughters_DataPreprocessing/data/derived/95_re
    > sults/h4_results.csv not found)

.         file write myfile "coefficient,se,family,residual_df,model_df,p_value
> ,num_obs,num_participants,interpretation" _n

.         file write myfile "`coefficient', `se', `test_stat_family', `df_resid
> ual', `df_model',`p_value',`num_obs',`num_participants',`interpretation'" _n

.         file close myfile

. 
. 
. *****************************************************************************
> ***
. 
. exit

end of do-file

. 
