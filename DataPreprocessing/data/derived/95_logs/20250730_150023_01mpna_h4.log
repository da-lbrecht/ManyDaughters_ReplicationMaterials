. *** Generate variable for existing sibling relationships (There are different
>  variables available with sibling information. We use the earliest informatio
> n that is available) 
. 
. * First generate a variable sibling_v1 that is surveyed between 2014 and 2020
>  in a few subsamples
. global SIBLINGS "lb1092_v1, lb1092_v2, lb1093_v1, lb1093_v2, lb1094_v1, lb109
> 4_v2, lb1095_v1, lb1095_v2, lb1096_v1, lb1096_v2, lb1097_v1, lb1097_v2, lb109
> 8_v1, lb1098_v2, lb1099_v1, lb1099_v2, lb1100_v1, lb1100_v2, lb1101_v1"

. 
. gen has_sister=.
(663,123 missing values generated)

. replace has_sister=1 if inlist(2, $SIBLINGS) 
(10,313 real changes made)

. 
. gen has_brother=.
(663,123 missing values generated)

. replace has_brother=1 if inlist(1, $SIBLINGS)
(10,551 real changes made)

. 
. gen no_siblings=.
(663,123 missing values generated)

. replace no_siblings=1 if lb1092_v1==-2 | lb1092_v2 ==-2
(2,845 real changes made)

. 
. gen siblings_v1= .
(663,123 missing values generated)

. replace siblings_v1=1 if no_siblings==1
(2,845 real changes made)

. replace siblings_v1=2 if has_sister==1 & has_brother!=1
(4,291 real changes made)

. replace siblings_v1=3 if has_sister!=1 & has_brother==1
(4,529 real changes made)

. replace siblings_v1=4 if has_sister==1 & has_brother==1
(6,022 real changes made)

