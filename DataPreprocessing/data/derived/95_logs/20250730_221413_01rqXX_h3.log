. * HYPOTHESIS TEST FOR H3 * (Please adapt according to your needs)
. 
.         * Please add a verbal description of your model here
. 
.         * As an example, and for illustrative purposes we consider a: linear 
> OLS regression
. 
.         * For illustrative purposes, let's further assume that having a job t
> hat requires hard manual labor (plb0085) is a good measure of gender equality
>  in the household (hypothesis 3),
.         * if having a job with less manual labor, the respondent is more like
> ly to experience more gender equality in the household.
.         * Accordingly, we run a linear OLS regression analysis with plb0085 a
> s dependent variable and the dummy variable d_daughter as independent variabl
> e
. 
.         
. qui g equality_home=plh0308_v1

. qui replace equality_home=. if plh0308_v1<0

.         
.         
. qui g equality_home_d=1 if plh0308_v1==1 | plh0308_v1==2

. qui replace equality_home_d=0 if plh0308_v1==3 | plh0308_v1==4

.         
.         
.         
. .........................................

. //Gender: females
. //...........................................................................
> .....................................................
. qui g female=1 if sex==2

. qui replace female=0 if sex==1

. 
. 
. .........................................

. //Age: 
. //...........................................................................
> .....................................................
. qui g age=bioage 

. qui replace age=. if bioage<0

. 
. qui g age2=age*age

. 
. 
. 
. 
. 
. //Employment Status:
. //...........................................................................
> .....................................................
. qui g emp_stat= pgemplst

. qui replace emp_stat=. if pgemplst<0

. 
. 
. //Marital Status
. //...........................................................................
> .....................................................
. qui gen mar_stat=pgfamstd

. qui replace mar_stat=. if pgfamstd<0

. 
. 
. .........................................

. //Education using ISCED-2011-Classification
. //...........................................................................
> .....................................................
. 
.  qui g education= pgisced11 

.  qui replace education=. if pgisced11<0

.  
.  
. .........................................

. // Labour income net
. ......................................... 

. qui g wageinc= pglabnet

. qui replace wageinc=. if wageinc<0

. qui replace wageinc=1 if wageinc==0

. qui g lwage_i=log(wageinc)

. 
. 
. .........................................       

. 
.         
.         
.         
.         
.         /*
> xi: reg equality_home d_daughter female age age2 lwage_i i.mar_stat i.educati
> on i.emp_stat , r
> */
. 
. xi: probit equality_home_d d_daughter female age age2 lwage_i i.mar_stat i.ed
> ucation i.emp_stat , r
