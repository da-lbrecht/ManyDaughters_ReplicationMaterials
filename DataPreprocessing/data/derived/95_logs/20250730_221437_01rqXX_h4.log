> .....................................................
. qui g age=bioage 

. qui replace age=. if bioage<0

. 
. qui g age2=age*age

. 
. 
. 
. 
. //Employment Status:
. //...........................................................................
> .....................................................
. qui g emp_stat= pgemplst

. qui replace emp_stat=. if pgemplst<0

. 
. 
