. 
. * ============================
. * Data Preparation * 
. * ============================
. 
. * LOAD AND MERGE DATA * (Please adapt according to your needs)
. 
.         use "$IN/ppathl.dta", clear // use ppathl as a starting dataset
(SOEP-Core, v37 (EU Edition), doi:10.5684/soep.core.v37eu)

. 
.         * Merge ppathl with all datasets, that you deem relevant for your ana
> lysis. (Tip: use keepusing() to specify which variables to keep from the usin
> g dataset; the default is all.)
. 
.         * biobirth contains information on fertility history
.         merge m:1 pid using "$IN/biobirth.dta", nogen keep(master matches) ke
> epusing(gebjahr)
(variable pid was long, now double to accommodate using data's values)
(variable gebjahr was int, now double to accommodate using data's values)
(label sex already defined)
(label sex_EN already defined)

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                           663,123  
    -----------------------------------------

.         * pgen contains user-friendly data on the individual level that are c
> onsolidated from different sources
.         // merge 1:1 pid syear using "$IN/pgen.dta", nogen keep(master matche
> s)
.         * pl contains all variables from the individual questionnaire
.         merge 1:1 pid syear using "$IN/pl.dta", nogen keep(master matches) ke
> epusing(pld0026 plh0308_v2)
(label cid_EN already defined)
(label pid_EN already defined)
(label cid already defined)

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                           663,123  
    -----------------------------------------

.         * hgen contains generated variables on household level from the house
> hold interview; use for household net income
.         // merge m:1 hid syear using "$IN/hgen.dta", nogen keep(master matche
> s) keepusing(hid syear hghinc)
. 
.         label language EN // change language of the labels to English

. 
.         save "$DATA/h4_dataset.dta", replace // save merged dataset
file C:\Users\dalbrecht\Research
    Projects\ManyDaughters\ManyDaughters_DataPreprocessing/data/derived_confi
    > dential/95%-sample/h4_dataset.dta saved

. 
. 
. * ============================
. * Analysis
. * ============================
. 
. * FILTERS * (Please adapt according to your needs)
.  
.         * Only keep participants from private households
.         keep if inlist(pop,1,2)
(89,279 observations deleted)

.         
.         keep cid pid hid syear sex gebjahr pop pld0026 plh0308_v2

.         
.         * only keep people 18 and older
.         drop if syear - gebjahr < 18
(46,390 observations deleted)

.         
.         * get rid of everyone that never encountered the dep_var question
.         bysort pid: egen n_non8 = total(plh0308_v2 > 0)

.         drop if n_non8 == 0
(217,007 observations deleted)

.         drop n_non8

. 
. 
. * GENERATE VARIABLES * (Please adapt according to your needs)
. 
.         * create indicators for having daugthers
.         gen has_daughters = .
(310,447 missing values generated)

.         replace has_daughters = 0 if pld0026 == -2
(24,514 real changes made)

.         replace has_daughters = 1 if pld0026 > 0
(47,572 real changes made)

.         
.         * carry forward daugher indicator
.         sort pid syear

.         by pid: gen d_filled = has_daughters
(238,361 missing values generated)

.         by pid: replace d_filled = d_filled[_n-1] if missing(d_filled)
(186609 real changes made)

.         drop has_daughters

.         rename d_filled has_daughters

.         
.         * set missing values on dep var for -8
.         replace plh0308_v2 = . if plh0308_v2 < 0
(263,190 real changes made, 263,190 to missing)

.         
.         * only keep first row where both are non-missing
.         egen first_both_year = min(cond(!missing(plh0308_v2) & !missing(has_d
> aughters), syear, .)), by(pid)
(73,947 missing values generated)

.         keep if syear == first_both_year
(291,804 observations deleted)

.         drop first_both_year

.         
.         * gender recoding, sex 1 = male, 2 = female
.         gen male = 1 - (sex - 1)

.         
.         * dep var
.         gen h1_dep_var = plh0308_v2

. 
. 
. * HYPOTHESIS TEST FOR H1 * (Please adapt according to your needs)
. 
.         * Standard OLS regression with robust standard errors.
.         * We regress the dependent variable on an indicator for having at lea
> st one daughter, 
.         * an indicator for being male (rather than female), and their interac
> tion.
. 
.         reg h1_dep_var has_daughters##i.male, vce(robust)

Linear regression                               Number of obs     =     18,643
                                                F(3, 18639)       =      21.08
                                                Prob > F          =     0.0000
                                                R-squared         =     0.0035
                                                Root MSE          =     1.7265

------------------------------------------------------------------------------
             |               Robust
  h1_dep_var | Coefficient  std. err.      t    P>|t|     [95% conf. interval]
-------------+----------------------------------------------------------------
1.has_daug~s |  -.0438223   .0342873    -1.28   0.201    -.1110286     .023384
      1.male |  -.1485593   .0368251    -4.03   0.000    -.2207399   -.0763788
             |
has_daught~s#|
        male |
        1 1  |   -.073102   .0508612    -1.44   0.151    -.1727945    .0265906
             |
       _cons |   5.533883   .0255075   216.95   0.000     5.483886     5.58388
------------------------------------------------------------------------------

. 
. 
. * EXTRACT AND EXPORT RESULTS * (Please check whether the suggested code autom
> atically picks up the correct statistics for your chosen regression analysis 
> and adapt if needed)
. 
.         * Extract the required statistics
. 
.                 * (i) coefficient estimate
.                 local coefficient = _b[1.has_daughters#1.male]

. 
.                 * (ii) standard error
.                 local se = _se[1.has_daughters#1.male]

. 
.                 * (iii) family of the test statistic (e.g. z, t, F, Chi²)
.                 local test_stat_family = "t"

. 
.                 * (iv) residual and model degrees of freedom (DFs) if applica
> ble
.                 local df_residual = e(df_r)

.                 local df_model = e(df_m)

. 
.                 * (v) p-value
.                 local p_value = _b[1.has_daughters#1.male] / _se[1.has_daught
> ers#1.male]

.                 local p_value = 2 * ttail(e(df_r), abs(`p_value'))

. 
.                 * (vi) number of observations
.                 local num_obs = e(N)

. 
.                 * (vii) number of participants
.                 quietly levelsof pid if e(sample), local(participants)

.                 local num_participants : word count `participants'

. 
.                 * (viii) interpretation of directionality
.                 scalar coef_d_daughter = _b[1.has_daughters#1.male]

.                 local interpretation "positive coefficient is in line with hy
> pothesis"

. 
.         // Display the saved statistics
.         di "Coefficient: `coefficient'"
Coefficient: -.0731019503003871

.         di "Standard Error: `se'"
Standard Error: .0508611966939191

.         di "Test Statistic Family: `test_stat_family'"
Test Statistic Family: t

.         di "Residual Degrees of Freedom: `df_residual'"
Residual Degrees of Freedom: 18639

.         di "Model Degrees of Freedom: `df_model'"
Model Degrees of Freedom: 3

.         di "p-value: " `p_value'
p-value: .15065429

.         di "Number of observations: " `num_obs'
Number of observations: 18643

.         di      "Number of participants: " `num_participants'
Number of participants: 18643

.         di "Interpretation of directionality: " "`interpretation'"
Interpretation of directionality: positive coefficient is in line with hypothes
> is

. 
.         * Export results to csv 
.         file open myfile using "$OUT/h4_results.csv", write replace
(file C:\Users\dalbrecht\Research
    Projects\ManyDaughters\ManyDaughters_DataPreprocessing/data/derived/95_re
    > sults/h4_results.csv not found)

.         file write myfile "coefficient,se,family,residual_df,model_df,p_value
> ,num_obs,num_participants,interpretation" _n

.         file write myfile "`coefficient', `se', `test_stat_family', `df_resid
> ual', `df_model',`p_value',`num_obs',`num_participants',`interpretation'" _n

.         file close myfile

. 
