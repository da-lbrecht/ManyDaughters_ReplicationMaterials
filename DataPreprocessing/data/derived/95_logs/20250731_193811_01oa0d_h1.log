Endogenous: has_daughters
Exogenous:  num_biochildren male age education_totalyears logincome
            2.migback 3.migback 1.partner 2.partner 3.partner 4.partner
            years_since_firstkid firstkid_female

. 
. 
. * ============================
. * Collect parameters
. * ============================
. 
. * (i) Coefficient 
. local coefficient = _b[has_daughters]

. 
. * (ii) Standard error
. local se = _se[has_daughters]

. 
. * (iii) Test statistic family
. local test_stat_family = "z"  

. 
. * (iv) Degrees of freedom
. 
. * Residual d.f. = nclusters - 1
. local num_clusters = e(N_clust)

. local df_residual = `num_clusters' - 1

. 
. * Model d.f.
. local df_model = e(df_m)

. 
. `* (v) p-value '

. local col = colnumb(r(table), "has_daughters")

. matrix b = r(table)

. local p_value = b[4, `col']

. 
. * (vi) Number of observations 
. local num_obs = e(N)

. 
. * (vii) participants
. local num_participants = e(N)

. 
. 
. * (viii) interpretation of directionality
. scalar coef_has_daughters = _b[has_daughters]

.                 local interpretation "positive coefficient is in line with hy
> pothesis"

. 
. * ============================
. * Write to CSV
. * ============================
. 
. file open myfile using "$OUT/h1_results.csv", write replace
(file C:\Users\dalbrecht\Research
    Projects\ManyDaughters\ManyDaughters_DataPreprocessing/data/derived/95_re
    > sults/h1_results.csv not found)

. file write myfile "coefficient,se,family,residual_df,model_df,p_value,num_obs
> ,num_participants,interpretation" _n

. file write myfile ///
>     "`coefficient',`se',`test_stat_family',`df_residual',`df_model',`p_value'
> ,`num_obs',`num_participants',`interpretation'" _n

. file close myfile

. 
. exit

end of do-file

