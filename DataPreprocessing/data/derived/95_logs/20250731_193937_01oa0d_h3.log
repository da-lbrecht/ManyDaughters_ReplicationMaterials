> ed
> global DATA "$ROOT/data/derived" // folder for datasets
> global OUT "$ROOT/out" // folder for output (results, tables)
> 
> */
. 
. * ============================
. * Data Preparation
. * ============================
. 
. * hours_kids_weekdays
. use "$IN/pl.dta", clear
(SOEP-Core, v37 (EU Edition), doi:10.5684/soep.core.v37eu)

. keep if syear == 2019
(624,726 observations deleted)

. keep pid pli0044_v3

. rename pli0044_v3 hours_kids_weekdays

. replace hours_kids_weekdays = . if hours_kids_weekdays < 0
(588 real changes made, 588 to missing)

. save "$DATA/h3_hours_kid.dta", replace
