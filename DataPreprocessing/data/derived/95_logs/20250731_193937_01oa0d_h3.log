. merge 1:1 pid using "$DATA/h3_hours_kid.dta", nogen
(label pid_EN already defined)

    Result                      Number of obs
    -----------------------------------------
    Not matched                        29,563
        from master                    29,563  
        from using                          0  

    Matched                            38,397  
    -----------------------------------------

. keep if !missing(parid)
(43,253 observations deleted)

. merge 1:1 parid using "$DATA/h3_hours_kid_partner", nogen
(label pli0044_v3 already defined)
(label pid_EN already defined)
(label pli0044_v3_EN already defined)

    Result                      Number of obs
    -----------------------------------------
    Not matched                        19,708
        from master                     3,009  
        from using                     16,699  

    Matched                            21,698  
    -----------------------------------------

. keep if !missing(hours_kids_weekdays)
(22,675 observations deleted)

. keep if !missing(partner_hours_kids_weekdays)
(4,007 observations deleted)

. gen diff_kids_hours = abs(hours_kids_weekdays - partner_hours_kids_weekdays)

. 
. replace education_totalyears = . if education_totalyears < 0
(0 real changes made)

. 
. 
. keep if !missing(sex) & !missing(firstkid_birthyear) & !missing(firstkid_sex)
>  & !missing(hours_kids_weekdays) & !missing(gebjahr)
(2,031 observations deleted)

. keep if num_biochildren > 0
(28 observations deleted)

. 
. * ============================
. * Generate additional vars
. * ============================
. 
. gen male = sex == 1

. gen years_since_lastkid = 2019 - lastkid_birthyear

. gen years_since_firstkid = 2019 - firstkid_birthyear

. gen age = 2019 - gebjahr

. gen logincome = log(incomelabor_net)
(5,029 missing values generated)

. 
. 
. keep if partner == 1 | partner == 2
(11 observations deleted)

. keep if years_since_firstkid >=1
(138 observations deleted)

. keep if years_since_lastkid >=2
(992 observations deleted)

. 
. save "$DATA/h3_dataset.dta", replace
