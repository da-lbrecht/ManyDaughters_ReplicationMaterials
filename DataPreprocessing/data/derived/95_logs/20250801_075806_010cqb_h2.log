> global IN "$ROOT/data/raw" // folder, in which the original datasets are stor
> ed
> global DATA "$ROOT/data/derived" // folder for datasets
> global OUT "$ROOT/out" // folder for output (results, tables)
> 
> */
. 
. * ============================
. * Data Preparation * 
. * ============================
. 
. * LOAD AND MERGE DATA * 
. 
.         * use  pl dataset as starting point
.         use "$IN/pl.dta", clear // 
(SOEP-Core, v37 (EU Edition), doi:10.5684/soep.core.v37eu)

.         
.         * keep only those of the survey years 2005, 2009, 2014 and 2019 (i.e.
> , where dependent variable was elicited)
.         keep if syear == 2005 | syear == 2009 | syear == 2014 | syear == 2019
(539,615 observations deleted)

.         
.         * merge with biobirth
.         merge m:1 pid using "$IN/biobirth.dta", nogen keep(master matches)
(variable pid was long, now double to accommodate using data's values)
(variable cid was long, now double to accommodate using data's values)
(label pid_EN already defined)
(label cid_EN already defined)
(label cid already defined)

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                           123,508  
    -----------------------------------------

.         
.         * merge with pgen to obtain highest obtained level of education
.         merge m:1 pid syear using "$IN/pgen.dta", nogen keep(master matches)
(variable syear was long, now double to accommodate using data's values)

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                           123,508  
    -----------------------------------------

.         
.         * define the dependent variable; for H2 plh0004 (political preference
>  on a  0 [left] to 10 [right] scale)
.                 * drop if not elicited or not answered
.                 drop if plh0004 == -1 | plh0004 == -5
(7,869 observations deleted)

.                 
.                 * reverse scale it to make coefficients more intuitive; highe
> r values more left-leaning 
.                 gen plh0004_rev = 10 - plh0004
(29,230 missing values generated)

.         
.         
.         * Now we create covariates, if necessary 
.         
.                 * Number of daughters
.                 
.                         * Create new variables, number of daughter and childr
> en up until survey year
.                         gen num_daughters = 0

.                         gen num_children = 0

.                         
.                         * Loop over child slots 1 to 19
.                         forval i = 1/19 {
  2.                                 local sexvar = "kidsex" + string(`i', "%02
> .0f")
  3.                                 local yearvar = "kidgeb" + string(`i', "%0
> 2.0f")
  4.                         
.                                 * Check that both variables exist
.                                 capture confirm variable `sexvar'
  5.                                 if !_rc {
  6.                                         capture confirm variable `yearvar'
  7.                                         if !_rc {
  8.                                                 * Only include child if bi
> rth year ≤ ssyear
.                                                 replace num_children = num_ch
> ildren + ( `sexvar' > 0 & `yearvar' <= syear)
  9.                                                 replace num_daughters = nu
> m_daughters + (`sexvar' == 2 & `yearvar' <= syear)
 10.                                         }
 11.                                 }
 12.                         }
