. * ================================================================
. * Data Preparation for H1
. * ================================================================
. 
. * This script merges the necessary datasets to create the analysis file for H
> 1.
. * It starts with ppathl and merges biobirth for fertility history,
. * and pl and pgen for dependent and control variables.
. 
. * LOAD AND MERGE DATA *
. 
. clear

. use "$IN/ppathl.dta", clear // Use ppathl as the base file, which contains pe
> rson-level tracking info
(SOEP-Core, v37 (EU Edition), doi:10.5684/soep.core.v37eu)

. keep pid syear gebjahr sex sampreg corigin // Keep IDs and controls

. 
. * Merge with pl to get the dependent variables
. merge 1:1 pid syear using "$IN/pl.dta", nogen keep(master matches) ///
>     keepusing(plh0395i01-plh0395i06) // Keeping DVs for H1 

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                           663,123  
    -----------------------------------------

. 
. * Merge with pgen to get the education control variable
. merge 1:1 pid syear using "$IN/pgen.dta", nogen keep(master matches) ///
>     keepusing(pgbilzeit) // Keeping education variable 
(variable syear was long, now double to accommodate using data's values)

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                           663,123  
    -----------------------------------------

. 
. * Merge with biobirth for IV construction
. sort pid

. merge m:1 pid using "$IN/biobirth.dta", nogen keep(master matches) ///
>     keepusing(sumkids kidsex*) // Keeping total children and sex of each chil
> d 
(variable pid was long, now double to accommodate using data's values)
(label sex already defined)
(label sex_EN already defined)
(label pid_EN already defined)
(label cid_EN already defined)
(label cid already defined)

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                           663,123  
    -----------------------------------------

. 
. * Set label language to English for consistency
. label language EN

. 
. * Save the intermediate merged dataset
. save "$DATA/h1_new_merged.dta", replace
(file C:\Users\dalbrecht\Research
    Projects\ManyDaughters\ManyDaughters_DataPreprocessing/data/derived_confi
    > dential/95%-sample/h1_new_merged.dta not found)
file C:\Users\dalbrecht\Research
    Projects\ManyDaughters\ManyDaughters_DataPreprocessing/data/derived_confi
    > dential/95%-sample/h1_new_merged.dta saved

. di "Data preparation complete. Merged dataset saved as h1_new_merged.dta"
Data preparation complete. Merged dataset saved as h1_new_merged.dta

. 
. * ================================================================
. * Filtering and Variable Generation 
. * ================================================================
. 
. * This script takes the merged dataset and creates the final analysis-ready f
> ile.
. 
. * Start with the merged dataset
. use "$DATA/h1_new_merged.dta", clear

. 
. * --- Step 1: Filtering the sample ---
. keep if syear == 2019
(624,726 observations deleted)

. gen age = 2019 - gebjahr // Calculate age

. keep if age >= 18 & age < . // Keep adults 18+ 
(385 observations deleted)

. keep if sumkids >= 1 & sumkids < . // 
(11,579 observations deleted)

. 
. * --- Step 2: Cleaning all variables ---
. * Clean Dependent Variables
. foreach var of varlist plh* {
  2.     replace `var' = . if `var' < 1
  3. }
(3,559 real changes made, 3,559 to missing)
(3,405 real changes made, 3,405 to missing)
(3,704 real changes made, 3,704 to missing)
(3,716 real changes made, 3,716 to missing)
(3,357 real changes made, 3,357 to missing)
(3,211 real changes made, 3,211 to missing)

. * Clean Control Variables
. foreach var of varlist sex sampreg pgbilzeit {
  2.     replace `var' = . if `var' < 1
  3. }
(2 real changes made, 2 to missing)
(41 real changes made, 41 to missing)
(550 real changes made, 550 to missing)

. replace corigin = . if corigin < 1
(3 real changes made, 3 to missing)

. gen is_german = (corigin == 1)

. replace is_german = . if corigin == .
(3 real changes made, 3 to missing)

. 
. * --- Step 3: Generate analysis variables ---
. gen num_daughters = 0

. forval i = 1/19 {
  2.     local child_num : di %02.0f `i'   
  3.     replace num_daughters = num_daughters + 1 if kidsex`child_num' == 2
  4. }
(12,864 real changes made)
(9,698 real changes made)
(4,283 real changes made)
(1,804 real changes made)
(748 real changes made)
(346 real changes made)
(183 real changes made)
(79 real changes made)
(50 real changes made)
(24 real changes made)
(15 real changes made)
(8 real changes made)
(3 real changes made)
(1 real change made)
(1 real change made)
(0 real changes made)
(1 real change made)
(1 real change made)
(1 real change made)

. gen share_daughters = num_daughters / sumkids

. gen age_sq = age^2

. 
. * --- Step 4: Save the final dataset ---
. keep pid syear plh* share_daughters age age_sq sex sampreg is_german pgbilzei
> t

. save "$DATA/h1_new_final.dta", replace
