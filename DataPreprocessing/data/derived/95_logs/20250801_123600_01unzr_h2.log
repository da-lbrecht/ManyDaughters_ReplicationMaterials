. * ================================================================
. * Data Preparation for H2 (No Changes Needed)
. * ================================================================
. 
. * This script creates the pooled dataset for the H2 analysis,
. * including all required variables from 2005, 2009, 2014, and 2019.
. 
. * --- Step 1: Merge the raw data ---
. use "$IN/ppathl.dta", clear
(SOEP-Core, v37 (EU Edition), doi:10.5684/soep.core.v37eu)

. keep pid syear gebjahr sex sampreg corigin // Keep IDs and controls specified
>  in PAP

. 
. * Merge with pl to get the dependent variable for H2
. merge 1:1 pid syear using "$IN/pl.dta", nogen keep(master matches) ///
>     keepusing(plh0004)

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                           663,123  
    -----------------------------------------

. 
. * Merge with pgen to get the education control variable
. merge 1:1 pid syear using "$IN/pgen.dta", nogen keep(master matches) ///
>     keepusing(pgbilzeit)
(variable syear was long, now double to accommodate using data's values)

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                           663,123  
    -----------------------------------------

. 
. * Merge with biobirth for IV construction
. sort pid

. merge m:1 pid using "$IN/biobirth.dta", nogen keep(master matches) ///
>     keepusing(sumkids kidsex*)
(variable pid was long, now double to accommodate using data's values)
(label sex already defined)
(label sex_EN already defined)
(label pid_EN already defined)
(label cid_EN already defined)
(label cid already defined)

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                           663,123  
    -----------------------------------------

. 
. * --- Step 2: Clean and Filter the sample for H2 ---
. * Keep only the waves where the political preference question was asked
. keep if inlist(syear, 2005, 2009, 2014, 2019)
(539,615 observations deleted)

. 
. * Keep only valid responses for the DV (0-10) as per the PAP
. keep if plh0004 >= 0 & plh0004 <= 10
(37,099 observations deleted)

. 
. * Clean all control variables using our standard logic
. foreach var of varlist sex sampreg pgbilzeit {
  2.     replace `var' = . if `var' < 1
  3. }
(6 real changes made, 6 to missing)
(76 real changes made, 76 to missing)
(4,143 real changes made, 4,143 to missing)

. replace corigin = . if corigin < 1
(80 real changes made, 80 to missing)

. gen is_german = (corigin == 1)

. replace is_german = . if corigin == .
(80 real changes made, 80 to missing)

. 
. * Apply other standard filters
. gen age_h2 = syear - gebjahr

. keep if age_h2 >= 18 & age_h2 < .
(345 observations deleted)

. keep if sumkids >= 1 & sumkids < .
(23,003 observations deleted)

. 
. * --- Step 3: Generate analysis variables ---
. gen num_daughters = 0

. forval i = 1/19 {
  2.     local child_num : di %02.0f `i'
  3.     replace num_daughters = num_daughters + 1 if kidsex`child_num' == 2
  4. }
(30,595 real changes made)
(22,176 real changes made)
(7,802 real changes made)
