. * ================================================================
. * Data Preparation for H3 (Revised for Single DV)
. * ================================================================
. 
. * This script creates the dataset for the H3 analysis (time use).
. 
. * --- Step 1: Merge the raw data ---
. use "$IN/ppathl.dta", clear
(SOEP-Core, v37 (EU Edition), doi:10.5684/soep.core.v37eu)

. 
. keep pid syear gebjahr sex sampreg corigin

. 
. * Merge with pl to get the single DV for H3
. * NOTE: We now merge only the selected dependent variable, pli0044_h.
. * If pli0044_h is not the correct variable name, please adjust it here.
. merge 1:1 pid syear using "$IN/pl.dta", nogen keep(master matches) ///
>     keepusing(pli0044_h)

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                           663,123  
    -----------------------------------------

. 
. * Merge with pgen to get education and the CORRECT marital status variable
. merge 1:1 pid syear using "$IN/pgen.dta", nogen keep(master matches) ///
>     keepusing(pgbilzeit pgfamstd) 
(variable syear was long, now double to accommodate using data's values)

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                           663,123  
    -----------------------------------------

. 
. * Merge with biobirth for IV construction
. sort pid

. merge m:1 pid using "$IN/biobirth.dta", nogen keep(master matches) ///
>     keepusing(sumkids kidsex*)
(variable pid was long, now double to accommodate using data's values)
(label sex already defined)
(label sex_EN already defined)
(label pid_EN already defined)
(label cid_EN already defined)
(label cid already defined)

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                           663,123  
    -----------------------------------------

. 
. * --- Step 2: Clean and Filter the sample for H3 ---
. * Clean the DV for H3 - Negative values are invalid
. replace pli0044_h = . if pli0044_h < 0
(27,097 real changes made, 27,097 to missing)

. 
. * Clean Marital status variable (pgfamstd)
. replace pgfamstd = . if pgfamstd < 1
(2,315 real changes made, 2,315 to missing)

. 
. * Clean all control variables using our standard logic
. foreach var of varlist sex sampreg pgbilzeit {
  2.     replace `var' = . if `var' < 1
  3. }
(13 real changes made, 13 to missing)
(1,361 real changes made, 1,361 to missing)
(28,524 real changes made, 28,524 to missing)

. replace corigin = . if corigin < 1
(501 real changes made, 501 to missing)

. gen is_german = (corigin == 1)

. replace is_german = . if corigin == .
(501 real changes made, 501 to missing)

. 
. * Filter sample based on the CORRECT marital status variable
. keep if inlist(pgfamstd, 1, 7)
(358,807 observations deleted)

. 
. * Apply other standard filters
. gen age_h3 = syear - gebjahr

. keep if age_h3 >= 18 & age_h3 < .
(1 observation deleted)

. keep if sumkids >= 1 & sumkids < .
(32,112 observations deleted)

. 
. * --- Step 3: Generate analysis variables ---
. gen num_daughters = 0

. forval i = 1/19 {
  2.     local child_num : di %02.0f `i'
  3.     replace num_daughters = num_daughters + 1 if kidsex`child_num' == 2
  4. }
(132,272 real changes made)
(103,659 real changes made)
(39,375 real changes made)
(13,612 real changes made)
(4,646 real changes made)
(1,910 real changes made)
(906 real changes made)
(362 real changes made)
(218 real changes made)
(130 real changes made)
(95 real changes made)
(68 real changes made)
(10 real changes made)
(1 real change made)
(6 real changes made)
(0 real changes made)
(5 real changes made)
(5 real changes made)
(5 real changes made)

. gen share_daughters = num_daughters / sumkids

. gen age_sq_h3 = age_h3^2

. 
. * --- Step 4: Save the final dataset ---
. keep pid syear pli0044_h share_daughters age_h3 age_sq_h3 sex sampreg is_germ
> an pgbilzeit

. save "$DATA/h3_data_final.dta", replace
