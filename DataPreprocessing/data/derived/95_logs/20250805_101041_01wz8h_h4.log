 30.                 replace P1=P1_`var' if _n==`x'
 31.                 replace se1=se1_`var' if _n==`x'
 32.                 replace N1=N1_`var' if _n==`x'
 33.                 
.         
.                 replace INFO="${`var'}" if _n==`x'
 34.                 *replace INFO=substr(INFO,1,4)
.                 local x=`x'+1
 35.         
.         }
 36.         
.         keep if b1!=.
 37.         
.         
.         
.         
.         // Gen Stars
.         *********************************************************************
> ******* 
.         gen PV1=""
 38.         replace PV1="***"       if P1<=0.01     & P1>0
 39.         replace PV1="**"        if P1<=0.05 & P1>0.01
 40.         replace PV1="*"         if P1<=0.1      & P1>0.05
 41.         
.         
.         // Define Y-axis in Figures and assign Variable Name or Information
.         *********************************************************************
> ********
.         gen y = _n
 42. 
.         levelsof y, local(forlab)
 43. 
.         foreach xx of local forlab {
 44.                 levelsof INFO if y == `xx', c local(help)
 45.                 label define ylabel `xx' "`help'", modify
 46.         }
 47. 
.         label values y ylabel
 48. 
.         
.         tempfile asd_`f'
 49.         save `asd_`f'' , replace
 50. restore
 51. }
