. * ============================================
. * RESULTS EXTRACTION: MEASURE 1
. * ============================================
. 
. local coefficient_a       = _b[treatment]

. local se_a                = _se[treatment]

. local test_stat_family_a  = "t"

. local df_residual_a       = e(df_r)

