    > sults/h2_results.csv not found)

. *file write myfile "First output measure (h1_index)" _n
. *file write myfile "`interpretation2_a'" _n
. file write myfile "coefficient,se,family,residual_df,model_df,p_value,num_obs
> ,num_participants,interpretation" _n

. file write myfile "`coefficient', `se', `test_stat_family', `df_residual', `d
> f_model',`p_value',`num_obs',`num_participants',`interpretation1'" _n

. *file write myfile "Second output measure (gender_sharing_norm)" _n
. *file write myfile "`interpretation2_b'" _n
. *file write myfile "coefficient,se,family,residual_df,model_df,p_value,num_ob
> s,num_participants,interpretation" _n
. *file write myfile "`coefficient_b', `se_b', `test_stat_family_b', `df_residu
> al_b', `df_model_b',`p_value_b',`num_obs_b',`num_participants_b',`interpretat
> ion1_b'" _n
