. *****************************************************************************
> ***
. ****************** Do-File H2: Political Preferences ******************
. *****************************************************************************
> ***
. * Authors: [REDACTED], [REDACTED]
. 
. * ============================
. * Setup
. * ============================
. 
. *clear all
. version 15 // indicate the version of stata you are using here

. set maxvar 10000 // extend the maximum number of variables to 10,000


. 
. * INSTALL PACKAGES* 
. *ssc install outreg2
. /*
> * CONFIGURE FILE PATHS *
> * the following code automatically sets paths based on where you saved the di
> stributed file-package on your system *
> if strpos("`c(pwd)'", "code") {
>     global ROOT "`c(pwd)'/.."
> }
> else {
>     global ROOT "`c(pwd)'"
> }
> global IN "$ROOT/data/raw" // folder, in which the original datasets are stor
> ed
> global DATA "$ROOT/data/derived" // folder for datasets
> global OUT "$ROOT/out" // folder for output (results, tables)
> */
. * LOAD AND MERGE DATA *
. use "$IN/ppathl.dta", clear // use ppathl as a starting dataset
(SOEP-Core, v37 (EU Edition), doi:10.5684/soep.core.v37eu)

. 
. * Merge ppathl with all datasets, that you deem relevant for your analysis. (
> Tip: use keepusing() to specify which variables to keep from the using datase
> t; the default is all.)
. 
. * biobirth contains information on fertility history
. merge m:1 pid using "$IN/biobirth.dta", nogen keep(master matches)
(variable pid was long, now double to accommodate using data's values)
(variable cid was long, now double to accommodate using data's values)
(variable gebjahr was int, now double to accommodate using data's values)
(label sex already defined)
(label sex_EN already defined)

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                           663,123  
    -----------------------------------------

. * pgen contains user-friendly data on the individual level that are consolida
> ted from different sources
. merge 1:1 pid syear using "$IN/pgen.dta", nogen keep(master matches)
(variable syear was long, now double to accommodate using data's values)

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                           663,123  
    -----------------------------------------

. * pl contains all variables from the individual questionnaire
. merge 1:1 pid syear using "$IN/pl.dta", nogen keep(master matches)
(variable inputdataset was str6, now str9 to accommodate using data's values)
(label cid_EN already defined)
(label pid_EN already defined)
(label cid already defined)

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                           663,123  
    -----------------------------------------

. * hgen contains generated variables on household level from the household int
> erview; use for household net income
. merge m:1 hid syear using "$IN/hgen.dta", nogen keep(master matches) keepusin
> g(hid syear hghinc)
(label iyear already defined)
(label iyear_EN already defined)

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                           663,123  
    -----------------------------------------

. 
. label language EN // change language of the labels to English

. 
. save "$DATA/h2_dataset.dta", replace // save merged dataset
file C:\Users\dalbrecht\Research
    Projects\ManyDaughters\ManyDaughters_DataPreprocessing/data/derived_confi
    > dential/95%-sample/h2_dataset.dta saved

. 
. 
. use "$DATA/h2_dataset.dta", clear

. 
. * STEP 1: Restrict to individuals who have either male or female first born
. * kidgeb01 kidsex01 are already time invariant, hence we can drop missings
. * drop if first child gender is missing or invalid
. drop if missing(kidsex01) | !inlist(kidsex01, 1, 2)
(216,893 observations deleted)

. 
. * STEP 2: Assign treatment: ever had a daughter as first child
. gen first_child_female = (kidsex01 == 2)

. label var first_child_female "1 if first child is female"

. 
. * STEP 2: Define treatment year as first child's birth year
. drop if kidgeb01 < 0
(546 observations deleted)

. gen treat_year = kidgeb01

. gen in_sample_birth = inrange(treat_year, 2000, 2020)

. 
. * STEP 3: Define relative time & post-treatment indicator
. gen rel_year = syear - treat_year

. gen post = .01

. replace post = 0 if syear < treat_year & in_sample_birth == 1
(17,345 real changes made)

. replace post = 1 if syear >= treat_year & in_sample_birth == 1
(117,192 real changes made)

. 
. * STEP 4: Clean outcome (MEASURE 1: left-right political preference)
. replace plh0004 = . if plh0004 < 0
(315,775 real changes made, 315,775 to missing)

. gen political_pref = plh0004
(382,731 missing values generated)

. label var political_pref "Left-right self-placement (0=left, 10=right)"

. 
. * STEP 4: Construct party ideology score based on CHES mapping (MEASURE 2 var
> iable)
. * Clean plh0012_h (party ID variable): set negatives to missing
. 
. * Clean party ID variable
. replace plh0012_h = . if inlist(plh0012_h, -5, -4, -2, -1)
(225,791 real changes made, 225,791 to missing)

. 
. * Initialize 
. gen party_ideology = .
(445,684 missing values generated)

. 
. * Single parties based on CHES scores
. replace party_ideology = 3.6 if plh0012_h == 1   // SPD
(49,474 real changes made)

. replace party_ideology = 6.5 if inlist(plh0012_h, 2, 3)   // CDU or CSU
(61,723 real changes made)

. replace party_ideology = 6.4 if plh0012_h == 4   // FDP
(6,119 real changes made)

. replace party_ideology = 3.2 if plh0012_h == 5   // Grüne
(18,709 real changes made)

. replace party_ideology = 1.4 if plh0012_h == 6   // Die Linke
(9,615 real changes made)

. replace party_ideology = 9.2 if plh0012_h == 27  // AfD
(2,616 real changes made)

. 
. * Coalition responses (approximate average)
. replace party_ideology = (3.6 + 3.2)/2 if plh0012_h == 9    // SPD + Grüne
(662 real changes made)

. replace party_ideology = (3.6 + 6.5)/2 if plh0012_h == 10   // SPD + CDU
(52 real changes made)

. replace party_ideology = (3.6 + 6.4)/2 if plh0012_h == 11   // SPD + FDP
(25 real changes made)

. replace party_ideology = 6.5 if plh0012_h == 13             // CDU/CSU (same 
> score)
(426 real changes made)

. replace party_ideology = (6.5 + 6.4)/2 if plh0012_h == 14   // CDU + FDP
(211 real changes made)

. replace party_ideology = (6.5 + 3.2)/2 if plh0012_h == 15   // CDU + Grüne
(108 real changes made)

. replace party_ideology = (3.2 + 1.4)/2 if plh0012_h == 16   // Grüne + Die Li
> nke
(85 real changes made)

. replace party_ideology = (3.6 + 1.4)/2 if plh0012_h == 17   // SPD + Linke
(165 real changes made)

. replace party_ideology = (6.5 + 1.4)/2 if plh0012_h == 20   // CDU + Linke
(7 real changes made)

. replace party_ideology = (6.5 + 9.2)/2 if plh0012_h == 21   // CDU + DVU/NPD
(12 real changes made)

. replace party_ideology = (6.5 + 6.4)/2 if plh0012_h == 22   // CSU + FDP
(23 real changes made)

. replace party_ideology = 5.0 if plh0012_h == 26             // Piratenpartei 
> (approximate centrist)
(229 real changes made)

. replace party_ideology = (6.5 + 9.2)/2 if plh0012_h == 30   // CDU/CSU + AfD
(29 real changes made)

. 
. * Exclude other/ambiguous responses
. replace party_ideology = . if inlist(plh0012_h, 7, 8)
(0 real changes made)

. 
. label var party_ideology "CHES-based left-right scale of party ID (0=left, 10
> =right)"

. 
