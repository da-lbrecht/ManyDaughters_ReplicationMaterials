. *****************************************************************************
> ***
. *************** Do-File H4: Gender-Related Attitudes Male vs. Female ********
> ***
. *****************************************************************************
> ***
. * Authors: [REDACTED], [REDACTED]
. 
. * ============================================
. * STEP 1: Setup
. * ============================================
. 
. * clear all
. version 15 // indicate the version of stata you are using here

. set maxvar 10000 // extend the maximum number of variables to 10,000


. 
. * INSTALL PACKAGES* 
. *ssc install outreg2
. 
. * CONFIGURE FILE PATHS *
. * the following code automatically sets paths based on where you saved the di
> stributed file-package on your system *
. /*
> if strpos("`c(pwd)'", "code") {
>     global ROOT "`c(pwd)'/.."
> }
> else {
>     global ROOT "`c(pwd)'"
> }
> global IN "$ROOT/data/raw" // folder, in which the original datasets are stor
> ed
> global DATA "$ROOT/data/derived" // folder for datasets
> global OUT "$ROOT/out" // folder for output (results, tables)
> */
. * ============================================
. * STEP 2: Load and Merge Data
. * ============================================
. 
. use "$IN/ppathl.dta", clear // use ppathl as a starting dataset
(SOEP-Core, v37 (EU Edition), doi:10.5684/soep.core.v37eu)

. 
. merge m:1 pid using "$IN/biobirth.dta", nogen keep(master matches)
(variable pid was long, now double to accommodate using data's values)
(variable cid was long, now double to accommodate using data's values)
(variable gebjahr was int, now double to accommodate using data's values)
(label sex already defined)
(label sex_EN already defined)

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                           663,123  
    -----------------------------------------

. merge 1:1 pid syear using "$IN/pgen.dta", nogen keep(master matches)
(variable syear was long, now double to accommodate using data's values)

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                           663,123  
    -----------------------------------------

. merge 1:1 pid syear using "$IN/pl.dta", nogen keep(master matches)
(variable inputdataset was str6, now str9 to accommodate using data's values)
(label cid_EN already defined)
(label pid_EN already defined)
(label cid already defined)

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                           663,123  
    -----------------------------------------

. merge m:1 hid syear using "$IN/hgen.dta", nogen keep(master matches) keepusin
> g(hid syear hghinc)
(label iyear already defined)
(label iyear_EN already defined)

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                           663,123  
    -----------------------------------------

. 
. label language EN // change language of the labels to English

. 
. save "$DATA/h4_dataset.dta", replace // save merged dataset
file C:\Users\dalbrecht\Research
    Projects\ManyDaughters\ManyDaughters_DataPreprocessing/data/derived_confi
    > dential/95%-sample/h4_dataset.dta saved

. 
. 
. use "$DATA/h4_dataset.dta", clear

. 
. * ============================================
. * STEP 3: Sample Restrictions and Treatment Definition
. * ============================================
. 
. drop if missing(kidsex01) | !inlist(kidsex01, 1, 2)
(216,893 observations deleted)

. 
. * Treatment indicator
. gen first_child_female = (kidsex01 == 2)

. label var first_child_female "1 if first child is female"

. 
. * Treatment timing
. drop if kidgeb01 < 0
(546 observations deleted)

. gen treat_year = kidgeb01

. gen in_sample_birth = inrange(treat_year, 2000, 2020)

. 
. gen rel_year = syear - treat_year

. gen post = .01

. replace post = 0 if syear < treat_year & in_sample_birth == 1
(17,345 real changes made)

. replace post = 1 if syear >= treat_year & in_sample_birth == 1
(117,192 real changes made)

. 
. * ============================================
. * STEP 4: Construct Dependent Variables
. * ============================================
. 
. foreach var in plj0620 plj0621 plj0622 plj0623 plj0625 {
  2.     replace `var' = . if `var' < 0
  3. }
(374,163 real changes made, 374,163 to missing)
(374,062 real changes made, 374,062 to missing)
(374,048 real changes made, 374,048 to missing)
(374,147 real changes made, 374,147 to missing)
(373,982 real changes made, 373,982 to missing)

. 
. egen h1_valid_items = rownonmiss(plj0620 plj0621 plj0622 plj0623 plj0625)

. egen h1_index = rowmean(plj0620 plj0621 plj0622 plj0623 plj0625)
(440,856 missing values generated)

. replace h1_index = . if h1_valid_items < 3
(112 real changes made, 112 to missing)

. label var h1_index "Gender attitudes index (0-4)"

. 
. replace plh0308_v1 = . if plh0308_v1 < 0
(372,560 real changes made, 372,560 to missing)

. replace plh0308_v2 = . if plh0308_v2 < 0
(361,259 real changes made, 361,259 to missing)

. replace plh0308_v1 = 5 - plh0308_v1
(6,168 real changes made)

. 
. gen gender_sharing_norm = (plh0308_v1 - 1)/3 if syear == 2012
(439,516 missing values generated)

. replace gender_sharing_norm = (plh0308_v2 - 1)/6 if syear == 2018
(17,469 real changes made)

. label var gender_sharing_norm "Egalitarian norm on income sharing (0-1)"

. 
. 
. * ============================================
. * STEP 5: Control Variables
. * ============================================
. 
. * Birthregion
. gen birthregion_clean = birthregion

. * Assign "Outside of Germany" = 17 to -1 (No answer) and -2 (Does not apply)
. replace birthregion_clean = 17 if inlist(birthregion, -1, -2)
(240,167 real changes made)

. * Treat -5 as missing
. replace birthregion_clean = . if birthregion == -5
(20,236 real changes made, 20,236 to missing)

. replace birthregion_cl = 0 if birthregion_clean ==.
(20,236 real changes made)

. 
. * Label the new version
. label define birthregion_lbl ///
>     0  "Missing" ///
>     1  "Schleswig-Holstein" ///
>     2  "Hamburg" ///
>     3  "Lower Saxony" ///
>     4  "Bremen" ///
>     5  "North Rhine-Westphalia" ///
>     6  "Hesse" ///
>     7  "Rhineland-Palatinate" ///
>     8  "Baden-Wuerttemberg" ///
>     9  "Bavaria" ///
>     10 "Saarland" ///
>     11 "Berlin" ///
>     12 "Brandenburg" ///
>     13 "Mecklenburg-West Pomerania" ///
>     14 "Saxony" ///
>     15 "Saxony-Anhalt" ///
>     16 "Thuringia" ///
>     17 "Outside of Germany"

. label values birthregion_clean birthregion_lbl

. 
. * Income
. gen log_income = log(plc0014_h) if plc0014_h > 0
(241,537 missing values generated)

. gen log_income_hid = log(hghinc) if hghinc > 0
(71,680 missing values generated)

. replace log_income_hid  = log_income if log_income_hid ==.
(4,424 real changes made)

. 
. * Age
. gen age = syear - gebjahr

. 
. * Gender: 0 is male, 1 is female
. gen gender = 0 if pla0009_v2 ==1
(295,410 missing values generated)

. replace gender = 1 if pla0009_v2 ==2
(191,296 real changes made)

. replace gender = 0 if pla0009_v3 ==1
(9,091 real changes made)

. replace gender = 1 if pla0009_v3 ==2
(10,562 real changes made)

. 
. egen tag = tag(pid gender)

. bysort pid (gender): gen n_unique_status = .
(445,684 missing values generated)

. bysort pid (gender): replace n_unique_status = sum(tag)
(445684 real changes made)

. bysort pid (gender): replace n_unique_status = n_unique_status[_N]
(154272 real changes made)

