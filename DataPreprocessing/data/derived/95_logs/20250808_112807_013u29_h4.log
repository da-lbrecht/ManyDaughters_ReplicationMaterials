. * ============================================
. * STEP 6: Prepare for Cross-Section
. * ============================================
. 
. gen pre = (rel_year < 0)

. gen post1 = (rel_year > 0)

. egen ever_pre = max(pre), by(pid)

. egen ever_post = max(post1), by(pid)

. gen include_in_did = (ever_pre == 1 & ever_post == 1)

. 
. * For h1_index
. gen relevant_post_h1 = rel_year if rel_year > 0 & !missing(h1_index)
(441,172 missing values generated)

. egen latest_post_h1 = max(relevant_post_h1), by(pid)
(427,634 missing values generated)

. gen relevant_for_cs_h1 = (latest_post_h1 == rel_year)

. 
. * For gender_sharing_norm
. gen relevant_post_norm = rel_year if rel_year > 0 & !missing(gender_sharing_n
> orm)
(422,335 missing values generated)

. egen latest_post_norm = max(relevant_post_norm), by(pid)
(220,838 missing values generated)

. gen relevant_for_cs_norm = (latest_post_norm == rel_year)

. 
. * ============================================
. * STEP 7: Prepare for Difference-in-Differences Estimation
. * ============================================
. * A) DiD flags for h1_index
. 
. gen rel_pre_h1 = rel_year if rel_year < 0 & include_in_did == 1 & !missing(h1
> _index)
(445,431 missing values generated)

. gen rel_post_h1 = rel_year if rel_year > 0 & include_in_did == 1 & !missing(h
> 1_index)
(445,560 missing values generated)

. egen closest_pre_h1 = max(rel_pre_h1), by(pid)
(444,974 missing values generated)

. 
. gen keep_pre_h1 = (rel_year == closest_pre_h1 & rel_year < 0 & include_in_did
>  == 1)

. gen keep_post_h1 = (rel_year == latest_post_h1 & rel_year > 0 & include_in_di
> d == 1)

. gen observations_for_dif_h1 = inlist(1, keep_pre_h1, keep_post_h1)

. sum observations_for_dif_h1 if observations_for_dif_h1 == 1

    Variable |        Obs        Mean    Std. dev.       Min        Max
-------------+---------------------------------------------------------
observatio~1 |        133           1           0          1          1

. scalar num_two_obs_A = r(N)

. display "num_two_obs_A = " num_two_obs_A
num_two_obs_A = 133

. 
. 
. * B) DiD flags for gender_sharing_norm
. 
. gen rel_pre_norm = rel_year if rel_year < 0 & include_in_did == 1 & !missing(
> gender_sharing_norm)
(445,395 missing values generated)

. gen rel_post_norm = rel_year if rel_year > 0 & include_in_did == 1 & !missing
> (gender_sharing_norm)
(444,184 missing values generated)

. egen closest_pre_norm = max(rel_pre_norm), by(pid)
(444,064 missing values generated)

. 
. gen keep_pre_norm = (rel_year == closest_pre_norm & rel_year < 0 & include_in
> _did == 1)

. gen keep_post_norm = (rel_year == latest_post_norm & rel_year > 0 & include_i
> n_did == 1)

. gen observations_for_dif_norm = inlist(1, keep_pre_norm, keep_post_norm)

. sum observations_for_dif_norm if observations_for_dif_norm == 1

    Variable |        Obs        Mean    Std. dev.       Min        Max
-------------+---------------------------------------------------------
observatio~m |      1,542           1           0          1          1

. scalar num_two_obs_B = r(N)

. display "num_two_obs_B = " num_two_obs_B
num_two_obs_B = 1542

. 
. * ============================================
. * STEP 8: Interaction terms (hardcoded)
. * ============================================
. 
. * Main interaction term
. gen post_female_treat = post * first_child_female * gender
(2,984 missing values generated)

. 
. * Heterogeneity interaction: Treatment × Female
. * (Female = 1 if mother, 0 if father)
. gen female_treat = first_child_female * gender
(2,984 missing values generated)

. label var female_treat "First child female × Female respondent"

. 
. gen post_gender = post * gender
(2,984 missing values generated)

. label var post_gender "Post × Female respondent"

. 
