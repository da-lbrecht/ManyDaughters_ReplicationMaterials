. * EXTRACT AND EXPORT RESULTS * 
. 
.         * Extract the required statistics
. 
.                 * (i) coefficient estimate (we focus on the interaction term 
> β3)
.                 local coefficient = _b[d_daughter_x_female]

. 
.                 * (ii) standard error
.                 local se = _se[d_daughter_x_female]

. 
.                 * (iii) family of the test statistic (e.g. z, t, F, Chi²)
.                 local test_stat_family = "t"

. 
.                 * (iv) residual and model degrees of freedom (DFs) if applica
> ble
.                 local df_residual = e(df_r)

.                 local df_model = e(df_m)

. 
.                 * (v) p-value (one-tailed test as specified in PAP)
.                 * We test H0: β3 ≥ 0 vs H1: β3 < 0 (one-tailed test)
.                 local t_stat = _b[d_daughter_x_female] / _se[d_daughter_x_fem
> ale]

.                 local p_value = normal(`t_stat')  // one-tailed p-value for n
> egative effect

. 
.                 * (vi) number of observations
.                 local num_obs = e(N)

. 
.                 * (vii) number of participants
