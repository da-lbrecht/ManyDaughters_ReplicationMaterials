. *** #ManyDaughters Project: Data Preprocessing - 04_collect_RT_results_95.do ***
. ********************************************************************************
. 
. * Authors: David Albrecht
. 
. * =========================================
. * GATHER RT ANALYSIS RESULTS FROM 95% DATA
. * =========================================
. 
. * Create empty variables for each hypothesis and result type
. foreach h in RT_h1_ RT_h2_ RT_h3_ RT_h4_ {
  2.     gen double `h'coefficient_95 = .
  3.     gen double `h'se_95 = .
  4.     gen str20 `h'family_95 = ""
  5.     gen double `h'residual_df_95 = .
  6.     gen double `h'model_df_95 = .
  7.     gen double `h'p_value_95 = .
  8.     gen double `h'p_value_95_manual = .
  9.     gen double `h'num_obs_95 = .
 10.     gen double `h'num_participants_95 = .
 11.     gen str100 `h'interpretation_95 = ""
 12. }
