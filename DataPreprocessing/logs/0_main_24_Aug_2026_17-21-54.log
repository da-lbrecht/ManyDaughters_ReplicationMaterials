. do "$CODE/07_collect_RT_results_05.do"

. ********************************************************************************
. *** #ManyDaughters Project: Data Preprocessing - 05_collect_RT_results_5.do ***
. ********************************************************************************
. 
. * Authors: David Albrecht
. 
. * =========================================
. * GATHER RT ANALYSIS RESULTS FROM 5% DATA
. * =========================================
. 
. * Create empty variables for each hypothesis and result type
. foreach h in RT_h1_ RT_h2_ RT_h3_ RT_h4_ {
  2.     // gen double `h'coefficient_5 = .
.     // gen double `h'se_5 = .
.     // gen str20 `h'family_5 = ""
.     // gen double `h'residual_df_5 = .
.     // gen double `h'model_df_5 = .
.     gen double `h'p_value_5 = .
  3.     // gen double `h'num_obs_5 = .
.     // gen double `h'num_participants_5 = .
.     // gen str100 `h'interpretation_5 = ""
. }
(160 missing values generated)
(160 missing values generated)
(160 missing values generated)
(160 missing values generated)

. 
. 
. * Loop through all result files and update variables accordingly
. local results_dir "data/derived/5_results"

. local endings h1_results h2_results h3_results h4_results

. 
. * Get list of all relevant result files
. local flist : dir "`results_dir'" files "*.csv"

. 
. foreach f of local flist {
  2.     preserve
  3. 
.     * Extract rt_id and hypothesis ending from filename
.     local fname = "`f'"
  4.     * Parse filename: repro_YYYYMMDD_HHMMSS_XXXXXX_hX_results.csv
.     * Find the rt_id (6 characters before _hX_results.csv)
.     * Strategy: find position of _h1_, _h2_, _h3_, or _h4_ and extract 6 chars before it
.     local rt_id = ""
  5.     local hyp = ""
  6.     
.     foreach ending of local endings {
  7.         if strpos("`fname'", "_`ending'.csv") {
  8.             local hyp = substr("`ending'", 1, 3) // e.g. h1_, h2_, h3_, h4_
  9.             local pos = strpos("`fname'", "_`ending'.csv")
 10.             * Extract 6 characters before the _hX_results.csv part
.             local rt_id = substr("`fname'", `pos' - 6, 6)
 11.             continue, break
 12.         }
 13.     }
 14. 
.     * Display all locals for debugging
.     di "DEBUG: Processing file `fname', extracted rt_id=`rt_id', hyp=`hyp'"
 15. 
.     * Try to import the result file and catch errors
.     capture noisily import delimited using "`results_dir'/`f'", clear stringcols(1)
 16.     local import_rc = _rc
 17. 
.     // If import succeeded, display the actual rt_id value from the CSV for debugging
.     if `import_rc' == 0 {
 18.         capture {
 19.             if _N > 0 {
 20.                 local csv_rt_id = rt_id[1]
 21.                 di "  CSV rt_id value: `csv_rt_id' (type: " + cond(missing(real("`csv_rt_id'")), "string", "co
> uld be numeric") + ")"
 22.             }
 23.         }
 24.     }
 25. 
.     // If import failed, set manual entry flag and skip to next file
.     if `import_rc' != 0 {
 26.         restore
 27.         * Use case-insensitive comparison for rt_id match
.         qui count if upper(trim(rt_id)) == upper(trim("`rt_id'"))
 28.         di "Import failed. Attempted to flag `r(N)' observation(s) with rt_id matching `rt_id'"
 29.         continue
 30.     }
 31. 
.     // Check for missing expected columns after successful import
.     local missingcol 0
 32.     foreach var in p_value /*coefficient  se family residual_df model_df num_obs num_participants interpretati
> on*/ {
 33.         capture confirm variable `var'
 34.         if _rc != 0 local missingcol 1
 35.     }
 36. 
.     if `missingcol' {
 37.         restore
 38.         qui count if upper(trim(rt_id)) == upper(trim("`rt_id'"))
 39.         di "Missing columns. Attempted to flag `r(N)' observation(s) with rt_id matching `rt_id'"
 40.         continue
 41.     }
 42. 
.     * Store values from the result file
.     foreach var in p_value /*coefficient  se family residual_df model_df num_obs num_participants interpretation*
> / {
 43.         capture {
 44.             * Check if it's a string variable first
.             capture confirm string variable `var'
 45.             if _rc == 0 {
 46.                 * It's a string variable - use directly
.                 local `var'_val = trim(`var'[1])
 47.             }
 48.             else {
 49.                 * It's numeric - convert to string with high precision
.                 if "`var'" == "p_value" | "`var'" == "coefficient" | "`var'" == "se" {
 50.                     local `var'_val = string(`var'[1], "%24.16e")
 51.                 }
 52.                 else {
 53.                     local `var'_val = trim(string(`var'[1]))
 54.                 }
 55.             }
 56.         }
 57.     }
 58.     restore
 59.     
.     * Check how many observations match before updating
.     qui count if upper(trim(rt_id)) == upper(trim("`rt_id'"))
 60.     local match_count = r(N)
 61.     di "Found `match_count' observation(s) matching rt_id=`rt_id' (case-insensitive)"
 62.     
.     foreach var in p_value /*coefficient  se family residual_df model_df num_obs num_participants interpretation*
> / {
 63.         local mvar = "RT_`hyp'`var'_5"
 64.         local val = trim("``var'_val'")
 65.         di "Updating `mvar' for rt_id=`rt_id' with value=`val'"
 66.         capture confirm string variable `mvar'
 67.         if _rc == 0 {
 68.             * Target is string variable
.             qui replace `mvar' = "`val'" if upper(trim(rt_id)) == upper(trim("`rt_id'"))
 69.             di "  -> `r(N)' row(s) updated"
 70.         }
 71.         else {
 72.             * Target is numeric variable - try to convert
.             capture {
 73.                 local num_val = real("`val'")
 74.                 if missing(`num_val') {
 75.                     * Value is not numeric, set to missing
.                     qui replace `mvar' = . if upper(trim(rt_id)) == upper(trim("`rt_id'"))
 76.                     di "  -> Set to missing (non-numeric value: `val')"
 77.                 }
 78.                 else {
 79.                     qui replace `mvar' = `num_val' if upper(trim(rt_id)) == upper(trim("`rt_id'"))
 80.                     di "  -> `r(N)' row(s) updated"
 81.                 }
 82.             }
 83.         }
 84.     }
 85. }
